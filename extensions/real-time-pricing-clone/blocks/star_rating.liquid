{% if customer %}
  <script>
    (async function () {
      try {
        console.log('=== Customer Login API Trigger ===');
        console.log('Customer detected, preparing API call...');
        console.log('Customer ID:', '{{ customer.id }}');
        console.log('Customer Email:', '{{ customer.email }}');
        console.log('Shop Domain:', '{{ shop.permanent_domain }}');

        const requestBody = {
          customerId: '{{ customer.id }}',
          email: '{{ customer.email }}',
          shop: '{{ shop.permanent_domain }}',
        };

        console.log('Request payload:', requestBody);
        console.log('Calling API endpoint: /apps/sap-price-test/api-trigger');

        const response = await fetch('https://sap-app-testing-new-wo9j.onrender.com/apps/sap-price-test/api-trigger', {
          method: 'POST',
          headers: {
            'Content-Type': 'application/json',
          },
          body: JSON.stringify(requestBody),
        });

        console.log('API Response Status:', response.status, response.statusText);

        if (!response.ok) {
          const errorText = await response.text();
          console.error('API call failed with status:', response.status);
          console.error('Error response:', errorText);
          throw new Error(`API call failed: ${response.status} ${response.statusText}`);
        }

        const result = await response.json();
        console.log('API call successful!');
        console.log('Response data:', result);
        console.log('=== API Call Complete ===');
      } catch (err) {
        console.error('=== API Call Error ===');
        console.error('Error type:', err.name);
        console.error('Error message:', err.message);
        console.error('Full error:', err);
        console.error('=== End Error ===');
      }
    })();
  </script>
{% endif %}

