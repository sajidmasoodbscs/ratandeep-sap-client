{% if customer and template.name == 'cart' %}
  <script>
      (function() {
        console.log("[SAP/Redis] Cart page script started");

        let cartSyncPromise = null;
        let sapCartReloadTimer = null;
        const SAP_CART_RELOAD_DELAY_MS = 800;

        function showCartLoader() {
          document.body.classList.add("RunningLoader");
          const loader = document.querySelector(".loaderBars");
          if (loader) loader.style.display = "block";
        }

        function hideCartLoader() {
          document.body.classList.remove("RunningLoader");
          const loader = document.querySelector(".loaderBars");
          if (loader) loader.style.display = "none";
        }

        function scheduleCartReloadAfterChange() {
          if (window.__sapCartInternalUpdate) return;
          clearTimeout(sapCartReloadTimer);
          sapCartReloadTimer = setTimeout(function() {
            console.log("[SAP/Redis] Cart changed — reloading for updated SAP prices");
            window.location.reload();
          }, SAP_CART_RELOAD_DELAY_MS);
        }

        function setupCartChangeReload() {
          if (window.__sapCartChangeReloadSetup) return;
          window.__sapCartChangeReloadSetup = true;
          const originalFetch = window.fetch.bind(window);
          window.fetch = async function(input, init) {
            const url = typeof input === "string" ? input : (input && input.url) || "";
            const isCartMutation = /\/cart\/(change|update|add|clear)(\.js)?/i.test(url);
            const response = await originalFetch(input, init);
            if (isCartMutation && response.ok && !window.__sapCartInternalUpdate) {
              scheduleCartReloadAfterChange();
            }
            return response;
          };
        }

        async function syncCartPrices() {
          if (cartSyncPromise) return cartSyncPromise;

          cartSyncPromise = (async function() {
          let willReload = false;
          try {
            showCartLoader();
            console.log("[SAP/Redis] Starting cart price sync...");
            const cartResponse = await fetch(window.Shopify.routes.root + 'cart.js');
            const cart = await cartResponse.json();

            if (!cart.items || cart.items.length === 0) {
              console.log("[SAP/Redis] Cart is empty");
              return;
            }

            console.log("[SAP/Redis] Syncing prices for", cart.items.length, "items");
            console.log("cart =>", cart);
            console.log("customer id =>", {{ customer.id | json }});
            console.log("customer addresses =>", {{ customer.addresses | json }});
            console.log("shop =>", {{ shop.permanent_domain | json }});
            const syncUrl = "/apps/sap-price-test/cart-price-sync";
            console.log("[SAP/Redis] Calling sync endpoint:", syncUrl);

            // 1. Call our orchestrator endpoint
            const syncResponse = await fetch(syncUrl, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                cart: cart,
                customer: {
                    id: {{ customer.id | json }},
                    addresses: {{ customer.addresses | json }},
                    shop: {{ shop.permanent_domain | json }}
                }
              })
            });

            const syncData = await syncResponse.json();
            console.log("[SAP/Redis] Sync response data:", syncData);

            if (!syncData.prices || Object.keys(syncData.prices).length === 0) {
              console.log("[SAP/Redis] No price updates found in Redis for these SKUs");
              return;
            }

            // 2. Update the DOM directly first for immediate feedback
            cart.items.forEach((item, index) => {
              const sku = item.sku || item.variant_sku;
              const newPrice = syncData.prices[sku];
              if (newPrice != null) {
                const priceInCents = Math.round(newPrice * 100);
                const formattedPrice = (typeof Shopify !== 'undefined' && Shopify.formatMoney) 
                  ? Shopify.formatMoney(priceInCents) 
                  : "$" + newPrice.toFixed(2);
                
                const lineTotalCents = priceInCents * item.quantity;
                const formattedLineTotal = (typeof Shopify !== 'undefined' && Shopify.formatMoney) 
                  ? Shopify.formatMoney(lineTotalCents) 
                  : "$" + (lineTotalCents / 100).toFixed(2);

                console.log(`[SAP/Redis] Updating DOM for SKU: ${sku}`);
                
                // Row identification
                const itemKey = item.key;
                const itemId = item.id;
                const variantId = item.variant_id;
                
                const rowSelectors = [
                  `.cart-item[data-key="${itemKey}"]`,
                  `[data-cart-item-key="${itemKey}"]`,
                  `[data-cart-item-id="${itemId}"]`,
                  `[data-variant-id="${variantId}"]`,
                  `#CartItem-${index + 1}`
                ];
                
                let rows = [];
                rowSelectors.forEach(sel => {
                  document.querySelectorAll(sel).forEach(r => {
                    if (!rows.includes(r)) rows.push(r);
                  });
                });

                if (rows.length > 0) {
                  rows.forEach(row => {
                    // Update Unit Prices (standard price nodes only)
                    row.querySelectorAll('.cart-item__price, .price-item--regular, .price:not(.price--end):not(.price--last)').forEach(el => {
                      if (!el.closest('.cart-item__totals')) {
                        el.textContent = formattedPrice;
                      }
                    });
                    // One unit-price slot in details — not variant options inside <dl>
                    const details = row.querySelector('.cart-item__details');
                    if (details) {
                      const options = details.querySelectorAll('.product-option');
                      for (const priceEl of options) {
                        if (!priceEl.closest('dl')) {
                          priceEl.textContent = formattedPrice;
                          break;
                        }
                      }
                    }
                    // Update Line Totals
                    row.querySelectorAll('.cart-item__total, .cart-item__totals .price, .price--end, .cart-item__totals .price-item--regular').forEach(el => {
                      el.textContent = formattedLineTotal;
                    });
                  });
                } else {
                  // Global fallback if no rows found
                  document.querySelectorAll(`[data-cart-item-key="${itemKey}"] .price`).forEach(el => {
                    el.textContent = formattedPrice;
                  });
                }
              }
            });

            // 3. Update subtotals
            updateCartTotals(syncData.prices, cart);

            // 4. Use Shopify AJAX API to persist line item properties (attributes)
            // This is required for the Cart Transformer to see the custom price
            const updates = {};
            let needsUpdate = false;

            cart.items.forEach((item) => {
              const sku = item.sku || item.variant_sku;
              const newPrice = syncData.prices[sku];
              
              if (newPrice != null && item.properties?.sap_price != String(newPrice)) {
                updates[item.key] = {
                  quantity: item.quantity,
                  properties: {
                    ...(item.properties || {}),
                  }
                };
                needsUpdate = true;
              }
            });

            if (!needsUpdate) {
              console.log("[SAP/Redis] All items already have correct persistent attributes");
              return;
            }

            // Loop protection: Check if we have recently reloaded
            const lastReload = sessionStorage.getItem('sap_sync_reload');
            const now = Date.now();
            if (lastReload && (now - parseInt(lastReload)) < 10000) {
              console.log("[SAP/Redis] Loop detected or sync already performed recently. Skipping persistence to prevent infinite reload.");
              return;
            }

            console.log("[SAP/Redis] Updating cart line attributes via AJAX API...");
            
            // Mark that we are about to reload to prevent loop
            sessionStorage.setItem('sap_sync_reload', now.toString());

            // We must use /cart/change.js for each item to properly update properties
            window.__sapCartInternalUpdate = true;
            try {
              for (const key in updates) {
                console.log(`[SAP/Redis] Persisting price for item key: ${key}`);
                try {
                  await fetch(window.Shopify.routes.root + 'cart/change.js', {
                    method: "POST",
                    headers: { "Content-Type": "application/json" },
                    body: JSON.stringify({
                      id: key,
                      quantity: updates[key].quantity,
                      properties: updates[key].properties
                    })
                  });
                } catch (err) {
                  console.error(`[SAP/Redis] Failed to update item ${key}:`, err);
                }
              }
            } finally {
              window.__sapCartInternalUpdate = false;
            }

            console.log("[SAP/Redis] State persisted, reloading page to apply Cart Transformer logic");
            willReload = true;
            window.location.reload();
          } catch (err) {
            console.error("[SAP/Redis] Error in sync process:", err);
          } finally {
            if (!willReload) hideCartLoader();
            cartSyncPromise = null;
          }
          })();

          return cartSyncPromise;
        }

        function updateCartTotals(priceMap, cartData) {
          let newSubtotal = 0;
          cartData.items.forEach((cartItem) => {
            const sku = cartItem.sku || cartItem.variant_sku || (cartItem.variant && cartItem.variant.sku);
            const quantity = cartItem.quantity || 1;
            if (sku && priceMap[sku] != null) {
              const newPrice = Number(priceMap[sku]);
              if (Number.isFinite(newPrice)) {
                newSubtotal += newPrice * quantity;
                return;
              }
            }
            newSubtotal += (cartItem.price / 100) * quantity;
          });

          const subtotalInCents = Math.round(newSubtotal * 100);
          const formattedTotal = (typeof Shopify !== 'undefined' && Shopify.formatMoney) 
            ? Shopify.formatMoney(subtotalInCents) 
            : "$" + newSubtotal.toFixed(2);
          
          console.log(`[SAP/Redis] New subtotal: ${formattedTotal}`);

          const selectors = [
            '.cart__subtotal', 
            '.cart-subtotal', 
            '[data-cart-subtotal]', 
            '.cart-total', 
            '.cart__total', 
            '.totals-subtotal-value',
            '.totals__subtotal-value',
            '.totals__total-value', // Dawn theme subtotal
            '.totals__total-value--final', // Dawn theme total
            '.cart__subtotal-value',
            '.cart-subtotal__price',
            '.js-cart-subtotal',
            '#cart-subtotal'
          ];

          let updated = false;
          selectors.forEach(sel => {
            document.querySelectorAll(sel).forEach(el => {
              el.textContent = formattedTotal;
              updated = true;
            });
          });

          if (!updated) {
            console.log('[SAP/Redis] Subtotal not found by exact selectors, trying fuzzy match...');
            document.querySelectorAll('[class*="total"], [class*="subtotal"]').forEach(el => {
              if (updated) return;
              const text = el.textContent.trim();
              if (el.children.length === 0 && text.match(/^[\$\£\€\¥\d]/) && text.length < 20) {
                el.textContent = formattedTotal;
                updated = true;
                console.log(`[SAP/Redis] Updated subtotal via fuzzy class match: ${el.className}`);
              }
            });
          }

          if (!updated) {
            console.log('[SAP/Redis] Subtotal element matching common selectors not found.');
          }
        }

        setupCartChangeReload();

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", syncCartPrices);
        } else {
          syncCartPrices();
        }
      })();
  </script>
{% endif %}

{% if template.name == 'product' and product %}
  <script>
    (function() {
      console.log("[Redis pricing] Product page script started");
      var redisCustomerId = {{ customer.id | json }};
      var variants = {{ product.variants | json }};
      var skus = variants.filter(function(v) { return v.sku && v.sku.trim(); }).map(function(v) { return v.sku.trim(); });
      console.log("[Redis pricing] Variants:", variants.length, "SKUs:", skus);
      if (skus.length === 0) {
        console.log("[Redis pricing] No SKUs, exiting");
        return;
      }

      var priceMap = {};
      var redisUrl = "/apps/sap-price-test/redis-prices?customerId=" + encodeURIComponent(redisCustomerId) + "&skus=" + skus.map(encodeURIComponent).join(",") + "&shop=" + encodeURIComponent({{ shop.permanent_domain | json }});
      console.log("[Redis pricing] Fetching Redis prices, customerId:", redisCustomerId, "url:", redisUrl);

      fetch(redisUrl)
        .then(function(r) {
          console.log("[Redis pricing] Response status:", r.status);
          return r.json();
        })
        .then(function(data) {
          console.log("[Redis pricing] Redis response:", data);
          if (data.prices) priceMap = data.prices;
          console.log("[Redis pricing] Price map:", priceMap);
          applyRedisPrice();
        })
        .catch(function(err) {
          console.error("[Redis pricing] Fetch error:", err);
        });

      function formatMoney(cents) {
        if (typeof cents !== "number") cents = parseFloat(cents) || 0;
        if (window.Shopify && window.Shopify.formatMoney) return window.Shopify.formatMoney(Math.round(cents * 100));
        return "$" + (cents).toFixed(2);
      }

      function getSelectedSku() {
        var idInput = document.querySelector('input[name="id"], select[name="id"]');
        if (!idInput) {
          var fallback = (variants[0] && variants[0].sku) ? variants[0].sku.trim() : null;
          console.log("[Redis pricing] No variant input found, using first variant SKU:", fallback);
          return fallback;
        }
        var id = (idInput.tagName === "SELECT") ? idInput.value : idInput.value;
        var v = variants.find(function(v) { return String(v.id) === String(id); });
        var sku = (v && v.sku) ? v.sku.trim() : null;
        console.log("[Redis pricing] Selected variant id:", id, "SKU:", sku);
        return sku;
      }

      function applyRedisPrice() {
        var sku = getSelectedSku();
        console.log("[Redis pricing] applyRedisPrice, selected SKU:", sku, "priceMap[sku]:", sku ? priceMap[sku] : "N/A");
        if (!sku || priceMap[sku] == null || priceMap[sku] === undefined) {
          console.log("[Redis pricing] No Redis price for this SKU, skipping update");
          return;
        }
        var redisPrice = parseFloat(priceMap[sku]);
        if (isNaN(redisPrice)) {
          console.log("[Redis pricing] Invalid price, skipping");
          return;
        }
        var sel = ".price-item--regular, [data-product-price], .product__price .price, .product-price, #product-price, .product-single__price, .price";
        var els = document.querySelectorAll(sel);
        console.log("[Redis pricing] Updating price to", redisPrice, "formatted:", formatMoney(redisPrice), "elements found:", els.length);
        els.forEach(function(el) {
          el.textContent = formatMoney(redisPrice);
        });
      }

      function onVariantChange() {
        console.log("[Redis pricing] Variant change detected");
        applyRedisPrice();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", function() {
          console.log("[Redis pricing] DOMContentLoaded");
          var idInput = document.querySelector('input[name="id"], select[name="id"]');
          if (idInput) {
            idInput.addEventListener("change", onVariantChange);
            idInput.addEventListener("input", onVariantChange);
            console.log("[Redis pricing] Variant input listeners attached");
          }
          setTimeout(applyRedisPrice, 400);
        });
      } else {
        console.log("[Redis pricing] DOM already ready");
        var idInput = document.querySelector('input[name="id"], select[name="id"]');
        if (idInput) {
          idInput.addEventListener("change", onVariantChange);
          idInput.addEventListener("input", onVariantChange);
          console.log("[Redis pricing] Variant input listeners attached");
        }
        setTimeout(applyRedisPrice, 400);
      }
    })();
  </script>
{% endif %}

