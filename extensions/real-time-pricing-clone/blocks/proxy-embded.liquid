<div class="loaderBars">
  <div class="jumpy-bars">
    <div class="bar" id="bar1"></div>
    <div class="bar" id="bar2"></div>
    <div class="bar" id="bar3"></div>
    <div class="bar" id="bar4"></div>
    <div class="bar" id="bar5"></div>
    <div class="bar" id="bar6"></div>
    <div class="bar" id="bar7"></div>
  </div>
  <div class="sap-text">
    <h5>Please wait while we fetch the latest prices for you. Thank you for your patience!</h5>
  </div>
</div>
<style>
  body.RunningLoader {
    position: relative;
    overflow: hidden;
  }
  .RunningLoader:after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    right: 0;
    margin: 0 auto;
    background: #000000c4;
    z-index: 9;
    overflow: hidden;
    bottom: 0;
  }
  .loaderBars {
    width: 100%;
    display: none;
    height: 100%;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    margin: 0 auto;
    z-index: 999;
  }
  .overlay {
    display: block !important;
    background: #0000002b;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
  }
  .jumpy-bars {
    display: flex !important;
    justify-content: space-evenly;
    width: 4.5em;
    height: 3.5em;
    gap: 0.3em;
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    margin: 0 auto;
    z-index: 99;
  }

  #bar1 {
    animation-delay: 0.2s;
  }
  #bar2 {
    animation-delay: 0.4s;
  }
  #bar3 {
    animation-delay: 0.6s;
  }
  #bar4 {
    animation-delay: 0.8s;
  }
  #bar5 {
    animation-delay: 1s;
  }
  #bar6 {
    animation-delay: 1.2s;
  }
  #bar7 {
    animation-delay: 1.5s;
  }
  .bar {
    width: 1em;
    height: auto;
    opacity: 0;
    background-color: black;
    border-radius: 100%;
    animation: jumping-bars 1s linear infinite alternate-reverse;
    display: block !important;
  }
  .sap-text {
    position: absolute;
    top: 60%;
    left: 0;
    right: 0;
    margin: 0 auto;
    max-width: 280px;
    text-align: center;
  }
  .sap-text h5 {
    color: white;
    font-size: 18px;
    margin-top: 40px;
  }

  @keyframes jumping-bars {
    0% {
      opacity: 1;
      transform: scaleY(0);
    }
    50% {
      opacity: 1;
      transform: scaleY(0.5);
    }
    100% {
      opacity: 1;
      transform: scaleY(1.8);
    }
  }
  .adressError p {
    color: red;
    margin-bottom: 30px;
    margin-top: 0;
  }
</style>
{% if customer %}
  <script>

    function isValidDefaultAddress(addresses) {
      console.log("[SAP Checkout] isValidDefaultAddress called with addresses:", addresses);
      const defaultAddress = addresses.find(address => address.default);
      if (! defaultAddress) {
        console.warn("[SAP Checkout] No default address found");
        return false;
      }
      const requiredFields = [
        "address1",
        "city",
        "province_code",
        "country_code",
        "zip"
      ];
      for (const field of requiredFields) {
        if (! defaultAddress[field]) {
          console.warn("[SAP Checkout] Default address missing field:", field, "address:", defaultAddress);
          return false;
        }
      }
      console.log("[SAP Checkout] Default address is valid");
      return true;
    }

    const SAP_APP_PROXY = "/apps/sap-price-test";
    const SHOP_DOMAIN = {{ shop.permanent_domain | json }};
    const CUSTOMER_ID = {{ customer.id | json }};
    const CUSTOMER_ADDRESSES = {{ customer.addresses | json }};

    function showCheckoutLoader() {
      document.body.classList.add("RunningLoader");
      const loader = document.querySelector(".loaderBars");
      if (loader) loader.style.display = "block";
    }

    function hideCheckoutLoader() {
      document.body.classList.remove("RunningLoader");
      const loader = document.querySelector(".loaderBars");
      if (loader) loader.style.display = "none";
    }

    let checkoutNavigated = false;
    let checkoutFallbackTimer = null;
    const CHECKOUT_MAX_WAIT_MS = 30000;

    function getStandardCheckoutUrl() {
      const root = window.Shopify && window.Shopify.routes && window.Shopify.routes.root;
      return root ? root + "checkout" : "/checkout";
    }

    function goToCheckoutNow(redirectUrl) {
      if (checkoutNavigated) return;
      checkoutNavigated = true;
      window.__sapCheckoutInProgress = true;
      if (checkoutFallbackTimer) {
        clearTimeout(checkoutFallbackTimer);
        checkoutFallbackTimer = null;
      }
      hideCheckoutLoader();
      const target = redirectUrl || getStandardCheckoutUrl();
      console.log("[SAP Checkout] Navigating to checkout:", target);
      window.location.href = target;
    }

    function armCheckoutFallbackTimer() {
      if (checkoutFallbackTimer) clearTimeout(checkoutFallbackTimer);
      checkoutFallbackTimer = setTimeout(function() {
        console.warn("[SAP Checkout] Discount job timeout — opening checkout (discount may not apply)");
        goToCheckoutNow();
      }, CHECKOUT_MAX_WAIT_MS);
    }

    function isCartPage() {
      const path = window.location.pathname;
      return path === "/cart" || path.endsWith("/cart");
    }

    function isProductPage() {
      return /\/products\/[^/]+/.test(window.location.pathname);
    }

    function getCheckoutFallbackUrl() {
      if (isProductPage()) {
        return window.location.pathname + window.location.search;
      }
      return "/cart";
    }

    function isCheckoutElement(el) {
      if (!el || !el.closest) return false;
      const node = el.closest('button, a, input[type="submit"]');
      if (!node) return false;
      if (node.getAttribute("name") === "checkout") return true;
      if (node.id === "checkout" || node.id === "CartDrawer-Checkout") return true;
      if (node.classList && node.classList.contains("cart__checkout-button")) return true;
      const href = node.getAttribute("href") || "";
      if (href === "/checkout" || href.endsWith("/checkout")) return true;
      return false;
    }

    function nodeIsBuyNowButton(node) {
      if (!node || !node.classList) return false;
      if (node.classList.contains("bss-b2b-btn-buyitnow")) return true;
      if (
        node.classList.contains("shopify-payment-button__button") &&
        node.classList.contains("bss-b2b-cp-dynamic")
      ) {
        return true;
      }
      return false;
    }

    function isBuyNowElement(el) {
      if (!el) return false;

      const composedPath = typeof el.composedPath === "function" ? el.composedPath() : null;
      if (composedPath) {
        for (let i = 0; i < composedPath.length; i++) {
          if (nodeIsBuyNowButton(composedPath[i])) return true;
        }
      }

      if (!el.closest) return false;
      const node = el.closest(
        "button, a, input[type='submit'], .shopify-payment-button__button, [role='button']"
      );
      if (!node) return false;
      if (nodeIsBuyNowButton(node)) return true;
      if (node.closest(".bss-b2b-btn-buyitnow")) return true;
      return false;
    }

    function getProductLineForBuyNow() {
      const form = document.querySelector(
        'form[action*="/cart/add"], product-form form, .product-form form, form.product-form'
      );
      let variantId = null;
      let quantity = 1;

      if (form) {
        const idField = form.querySelector('[name="id"]');
        if (idField) {
          variantId = idField.value;
        }
        const qtyField = form.querySelector('[name="quantity"]');
        if (qtyField && qtyField.value) {
          const parsed = parseInt(qtyField.value, 10);
          if (parsed > 0) quantity = parsed;
        }
      }

      if (!variantId) {
        const selected = document.querySelector('input[name="id"]:checked, select[name="id"]');
        if (selected) variantId = selected.value;
      }

      if (!variantId) {
        const variantParam = new URLSearchParams(window.location.search).get("variant");
        if (variantParam) variantId = variantParam;
      }

      if (!variantId && window.ShopifyAnalytics?.meta?.selectedVariantId) {
        variantId = String(window.ShopifyAnalytics.meta.selectedVariantId);
      }

      return {
        variantId: variantId ? Number(variantId) : null,
        quantity: quantity,
      };
    }

    async function applyCheckoutLineProperties(linePropertyUpdates) {
      if (!linePropertyUpdates || !linePropertyUpdates.length) {
        console.warn("[SAP Checkout] No linePropertyUpdates to apply");
        return { applied: 0, failed: 0 };
      }
      let applied = 0;
      let failed = 0;
      for (const line of linePropertyUpdates) {
        try {
          const res = await fetch(window.Shopify.routes.root + "cart/change.js", {
            method: "POST",
            headers: { "Content-Type": "application/json" },
            body: JSON.stringify({ id: line.lineKey, properties: line.properties }),
          });
          const body = await res.json();
          console.log("[SAP Checkout] cart/change.js", line.sku, res.status, body);
          if (res.ok) applied++;
          else failed++;
        } catch (err) {
          console.error("[SAP Checkout] cart/change.js error", line.sku, err);
          failed++;
        }
      }
      return { applied, failed };
    }

    function pollJobStatus(jobId) {
      const url = SAP_APP_PROXY + "/check-checkout-url";
      console.log("[SAP Checkout] Polling", url, "jobId:", jobId);
      armCheckoutFallbackTimer();

      const interval = setInterval(() => {
        fetch(url, {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({ jobId, shop: SHOP_DOMAIN }),
        })
          .then((r) => {
            console.log("[SAP Checkout] poll status:", r.status);
            if (!r.ok) throw new Error("poll HTTP " + r.status);
            return r.json();
          })
          .then(async (data) => {
            console.log("[SAP Checkout] poll payload:", data);
            if (data.status === "completed" && data.redirectUrl) {
              clearInterval(interval);
              if (data.discountCode) {
                console.log(
                  "[SAP Checkout] Redirect with discount code:",
                  data.discountCode,
                  "amount:",
                  data.discountValue
                );
              } else {
                console.log("[SAP Checkout] Redirect without discount (cart matches Redis or no savings)");
              }
              goToCheckoutNow(data.redirectUrl);
            } else if (data.status === "failed") {
              clearInterval(interval);
              console.error("[SAP Checkout] Job failed — still opening checkout:", data.reason || data.error);
              goToCheckoutNow();
            }
          })
          .catch((err) => {
            console.error("[SAP Checkout] Poll error — still opening checkout:", err);
            clearInterval(interval);
            goToCheckoutNow();
          });
      }, 1000);

      setTimeout(() => {
        clearInterval(interval);
        console.warn("[SAP Checkout] Poll window ended — opening checkout");
        goToCheckoutNow();
      }, CHECKOUT_MAX_WAIT_MS);
    }

    function startCheckoutJob(cartData) {
      checkoutNavigated = false;

      const url = SAP_APP_PROXY + "/createDraftOrder";
      console.log("[SAP Checkout] POST", url);

      fetch(url, {
        method: "POST",
        headers: { "Content-Type": "application/json" },
        body: JSON.stringify({ data: cartData, shop: SHOP_DOMAIN }),
      })
        .then((r) => {
          console.log("[SAP Checkout] createDraftOrder status:", r.status);
          if (!r.ok) throw new Error("createDraftOrder HTTP " + r.status);
          return r.json();
        })
        .then((data) => {
          console.log("[SAP Checkout] createDraftOrder body:", data);
          if (!data.jobId) throw new Error("No jobId in response");
          pollJobStatus(data.jobId);
        })
        .catch((err) => {
          console.error("[SAP Checkout] createDraftOrder failed — still opening checkout:", err);
          goToCheckoutNow();
        });
    }

    function enrichCartData(cartData) {
      cartData.customer_id = CUSTOMER_ID;
      cartData.customer_adresses = CUSTOMER_ADDRESSES;
      cartData.shop = SHOP_DOMAIN;
      return cartData;
    }

    async function startCheckoutFromCart() {
      const cartRes = await fetch(window.Shopify.routes.root + "cart.js");
      console.log("[SAP Checkout] cart.js status:", cartRes.status);
      const cartData = enrichCartData(await cartRes.json());
      console.log("[SAP Checkout] cart items:", cartData.items?.length, "token:", cartData.token);
      startCheckoutJob(cartData);
    }

    async function handleCheckoutClick(event) {
      event.preventDefault();
      event.stopPropagation();
      window.__sapCheckoutInProgress = true;
      console.log("[SAP Checkout] Intercepted checkout click:", event.target);

      showCheckoutLoader();

      try {
        await startCheckoutFromCart();
      } catch (err) {
        console.error("[SAP Checkout] cart.js failed — still opening checkout:", err);
        goToCheckoutNow();
      }
    }

    async function handleBuyNowClick(event) {
      event.preventDefault();
      event.stopPropagation();
      console.log("[SAP Checkout] Intercepted Buy Now click:", event.target);

      showCheckoutLoader();

      try {
        const line = getProductLineForBuyNow();
        if (!line.variantId) {
          throw new Error("Could not resolve variant for Buy Now");
        }

        console.log("[SAP Checkout] Buy Now variant:", line.variantId, "qty:", line.quantity);

        await fetch(window.Shopify.routes.root + "cart/clear.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
        });

        const addRes = await fetch(window.Shopify.routes.root + "cart/add.js", {
          method: "POST",
          headers: { "Content-Type": "application/json" },
          body: JSON.stringify({
            items: [{ id: line.variantId, quantity: line.quantity }],
          }),
        });

        if (!addRes.ok) {
          const addErr = await addRes.json().catch(function () {
            return {};
          });
          throw new Error(addErr.description || addErr.message || "cart/add.js failed");
        }

        await startCheckoutFromCart();
      } catch (err) {
        console.error("[SAP Checkout] Buy Now flow failed — opening checkout if possible:", err);
        goToCheckoutNow();
      }
    }

    document.addEventListener("DOMContentLoaded", function() {
      console.log("[SAP Checkout] v2 — shop:", SHOP_DOMAIN, "customer:", CUSTOMER_ID);

      const selectorList = [
        'button[name="checkout"]',
        'input[name="checkout"]',
        "#checkout",
        "#CartDrawer-Checkout",
        ".cart__checkout-button",
        'a[href="/checkout"]',
        ".bss-b2b-btn-buyitnow",
        ".shopify-payment-button__button.bss-b2b-btn-buyitnow",
      ];
      selectorList.forEach((sel) => {
        const found = document.querySelectorAll(sel);
        console.log("[SAP Checkout] Selector", sel, "→", found.length, found);
      });

      document.addEventListener(
        "click",
        function (event) {
          if (isCartPage() && isCheckoutElement(event.target)) {
            handleCheckoutClick(event);
            return;
          }
          if (isProductPage() && isBuyNowElement(event.target)) {
            handleBuyNowClick(event);
          }
        },
        true
      );

      console.log("[SAP Checkout] Delegated click listener active (cart checkout + product Buy Now)");
      console.log("[SAP Checkout] Customer addresses:", CUSTOMER_ADDRESSES);

      // Call SAP webhook with all SKUs when customer logs in
      (async function() {
        try {
          const customerId = {{ customer.id | json }};
          const customerAddresses = {{ customer.addresses | json }};
          
          // Check if we've already called this endpoint for this customer in this session
          const storageKey = `sap_all_skus_called_${customerId}`;
          const alreadyCalled = sessionStorage.getItem(storageKey);
          
          if (alreadyCalled) {
            console.log("SAP webhook with all SKUs already called for this customer session");
            return;
          }

          console.log("Calling SAP webhook with all SKUs for logged-in customer...");
          
          const url = 'https://ratandeep-sap-client.onrender.com/apps/sap-price-test/sapcall-all-skus';
          
          var shopDomain = {{ shop.permanent_domain | json }};
          if (!shopDomain && typeof window.Shopify !== 'undefined' && window.Shopify.shop) {
            shopDomain = window.Shopify.shop;
          }
          console.log("shopDomain =>", shopDomain);
          console.log("customerId =>", customerId);
          console.log("customerAddresses =>", customerAddresses);
          console.log("url =>", url);
          const response = await fetch(url, {
            method: 'POST',
            headers: {
              'Content-Type': 'application/json'
            },
            body: JSON.stringify({ 
              data: {
                customer_id: customerId,
                customer_addresses: customerAddresses,
                shop: shopDomain
              }
            })
          });

          if (!response.ok) {
            throw new Error('Webhook call failed with status: ' + response.status);
          }

          const result = await response.json();
          console.log('SAP webhook call with all SKUs response:', result);
          
          // Mark as called for this session
          sessionStorage.setItem(storageKey, 'true');
        } catch (error) {
          console.error('Error calling SAP webhook with all SKUs:', error);
          // Don't block the page if this fails
        }
      })();
    });
  </script>

