{% if customer and template.name == 'cart' %}
  <script>
      (function() {
        console.log("[SAP/Redis] Cart page script started");

        let cartSyncPromise = null;
        let sapCartReloadTimer = null;
        const SAP_CART_RELOAD_DELAY_MS = 800;
        window.__sapCheckoutInProgress = window.__sapCheckoutInProgress || false;

        function showCartLoader() {
          document.body.classList.add("RunningLoader");
          const loader = document.querySelector(".loaderBars");
          if (loader) loader.style.display = "block";
        }

        function hideCartLoader() {
          document.body.classList.remove("RunningLoader");
          const loader = document.querySelector(".loaderBars");
          if (loader) loader.style.display = "none";
        }

        const SAP_CART_NOTE_STORAGE_KEY = "sap_cart_note_draft";

        function isCartNoteElement(el) {
          if (!el) return false;
          const name = (el.getAttribute && el.getAttribute("name")) || el.name || "";
          if (String(name).toLowerCase() === "note") return true;
          const id = el.id || "";
          if (/cart[-_]?note/i.test(id)) return true;
          return !!(el.closest && el.closest('[name="note"], #Cart-note, #CartNote, [data-cart-note], .cart__note, cart-note'));
        }

        function getCartNoteField() {
          return document.querySelector(
            'textarea[name="note"], input[name="note"], #Cart-note, #CartNote, [data-cart-note] textarea, .cart__note textarea'
          );
        }

        function persistCartNoteDraft() {
          const field = isCartNoteElement(document.activeElement) ? document.activeElement : getCartNoteField();
          if (field && typeof field.value === "string") {
            try {
              sessionStorage.setItem(SAP_CART_NOTE_STORAGE_KEY, field.value);
            } catch (e) {}
          }
        }

        function restoreCartNoteDraft() {
          let draft = null;
          try {
            draft = sessionStorage.getItem(SAP_CART_NOTE_STORAGE_KEY);
            sessionStorage.removeItem(SAP_CART_NOTE_STORAGE_KEY);
          } catch (e) {
            draft = null;
          }
          if (draft == null) return;
          const field = getCartNoteField();
          if (field) field.value = draft;
        }

        function isNoteOnlyCartMutation(url, init, input) {
          if (!/\/cart\/update(\.js)?(\?|$)/i.test(url)) return false;
          let body = (init && init.body) || (typeof input !== "string" && input && input.body) || "";
          if (!body) return false;
          if (typeof body !== "string") {
            try {
              body = typeof body === "object" && typeof body.text === "function" ? null : String(body);
            } catch (e) {
              return false;
            }
          }
          if (!body) return false;
          try {
            const data = JSON.parse(body);
            const keys = Object.keys(data || {});
            if (!keys.length) return false;
            return keys.every(function(key) {
              return key === "note" || key === "attributes";
            });
          } catch (e) {
            return /(?:^|&)note=/.test(body) && !/(?:^|&)(updates|id|quantity|line|items)=/.test(body);
          }
        }

        function scheduleCartReloadAfterChange() {
          if (window.__sapCartInternalUpdate || window.__sapCheckoutInProgress) return;
          if (isCartNoteElement(document.activeElement)) {
            persistCartNoteDraft();
            const field = document.activeElement;
            if (!field.__sapReloadOnBlur) {
              field.__sapReloadOnBlur = true;
              field.addEventListener("blur", function onNoteBlur() {
                field.__sapReloadOnBlur = false;
                field.removeEventListener("blur", onNoteBlur);
                if (window.__sapPendingReloadAfterNote) {
                  window.__sapPendingReloadAfterNote = false;
                  scheduleCartReloadAfterChange();
                }
              });
            }
            window.__sapPendingReloadAfterNote = true;
            return;
          }
          clearTimeout(sapCartReloadTimer);
          sapCartReloadTimer = setTimeout(function() {
            if (window.__sapCheckoutInProgress) return;
            if (isCartNoteElement(document.activeElement)) {
              window.__sapPendingReloadAfterNote = true;
              return;
            }
            persistCartNoteDraft();
            console.log("[SAP/Redis] Cart changed — reloading for updated SAP prices");
            window.location.reload();
          }, SAP_CART_RELOAD_DELAY_MS);
        }

        function isSapLinePropertyKey(key) {
          const k = String(key || "").toLowerCase();
          return k === "sap_price" || k.indexOf("sap_") === 0 || k.indexOf("sap-") === 0;
        }

        function propertiesWithoutSap(props) {
          const src = props || {};
          const out = {};
          let removed = false;
          Object.keys(src).forEach(function(key) {
            if (isSapLinePropertyKey(key)) {
              removed = true;
              return;
            }
            out[key] = src[key];
          });
          return { properties: out, removed: removed };
        }

        async function clearCartDiscounts() {
          window.__sapCartInternalUpdate = true;
          try {
            const res = await fetch(window.Shopify.routes.root + "cart/update.js", {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({ discount: "" }),
            });
            const data = await res.json();
            if (data.discount_codes && data.discount_codes.length) {
              console.log("[SAP/Redis] Removed cart discount codes:", data.discount_codes);
            } else {
              console.log("[SAP/Redis] No cart discount codes on cart");
            }
            hideCartLevelDiscountUi();
            return data;
          } catch (err) {
            console.warn("[SAP/Redis] Could not clear cart discount codes:", err);
            return null;
          } finally {
            window.__sapCartInternalUpdate = false;
          }
        }

        function hideCartLevelDiscountUi() {
          const roots = document.querySelectorAll(
            ".totals, .cart__footer, #main-cart-footer, .cart__blocks, cart-drawer .drawer__footer"
          );
          roots.forEach(function(root) {
            root.querySelectorAll(
              ".discounts, .cart-discount, .totals__discount, .totals__discounts, .cart__discount, [data-discounts]"
            ).forEach(function(el) {
              el.style.display = "none";
            });
            root.querySelectorAll(".totals__row, .cart__row, li").forEach(function(row) {
              const label = row.querySelector("h2, h3, span, dt, .totals__label");
              const text = label ? label.textContent.trim().toLowerCase() : "";
              if (text.indexOf("discount") !== -1 || text.indexOf("savings") !== -1) {
                row.style.display = "none";
              }
            });
          });
        }

        function computeMerchandiseTotalCents(priceMap, cartData) {
          let subtotalDollars = 0;
          (cartData.items || []).forEach(function(cartItem) {
            const sku =
              cartItem.sku ||
              cartItem.variant_sku ||
              (cartItem.variant && cartItem.variant.sku);
            const quantity = cartItem.quantity || 1;
            if (sku && priceMap[sku] != null) {
              const unit = Number(priceMap[sku]);
              const shopifyDollars = Number(cartItem.price) / 100;
              if (Number.isFinite(unit) && unit > 0 && (!Number.isFinite(shopifyDollars) || unit < shopifyDollars)) {
                subtotalDollars += unit * quantity;
                return;
              }
            }
            subtotalDollars += (cartItem.price / 100) * quantity;
          });
          return Math.round(subtotalDollars * 100);
        }

        function formatMoneyFromCents(cents) {
          if (typeof Shopify !== "undefined" && Shopify.formatMoney) {
            return Shopify.formatMoney(cents);
          }
          return "$" + (cents / 100).toFixed(2);
        }

        function setPriceText(el, formatted) {
          if (!el) return;
          el.textContent = formatted;
          el.setAttribute("data-sap-cart-total", formatted);
        }

        async function removeSapPropertiesFromCart(cart) {
          const updates = {};
          (cart.items || []).forEach(function(item) {
            const cleaned = propertiesWithoutSap(item.properties);
            if (cleaned.removed) {
              updates[item.key] = {
                quantity: item.quantity,
                properties: cleaned.properties,
              };
            }
          });

          const keys = Object.keys(updates);
          if (!keys.length) return;

          console.log("[SAP/Redis] Removing SAP line properties from", keys.length, "item(s)");
          window.__sapCartInternalUpdate = true;
          try {
            for (const key of keys) {
              if (window.__sapCheckoutInProgress) break;
              await fetch(window.Shopify.routes.root + "cart/change.js", {
                method: "POST",
                headers: { "Content-Type": "application/json" },
                body: JSON.stringify({
                  id: key,
                  quantity: updates[key].quantity,
                  properties: updates[key].properties,
                }),
              });
            }
          } finally {
            window.__sapCartInternalUpdate = false;
          }
        }

        function setupCartChangeReload() {
          if (window.__sapCartChangeReloadSetup) return;
          window.__sapCartChangeReloadSetup = true;
          const originalFetch = window.fetch.bind(window);
          window.fetch = async function(input, init) {
            const url = typeof input === "string" ? input : (input && input.url) || "";
            const isCartMutation = /\/cart\/(change|update|add|clear)(\.js)?/i.test(url);
            const noteOnly = isNoteOnlyCartMutation(url, init, input);
            const response = await originalFetch(input, init);
            if (
              isCartMutation &&
              !noteOnly &&
              response.ok &&
              !window.__sapCartInternalUpdate &&
              !window.__sapCheckoutInProgress
            ) {
              scheduleCartReloadAfterChange();
            }
            return response;
          };
        }

        async function syncCartPrices() {
          if (window.__sapCheckoutInProgress) {
            console.log("[SAP/Redis] Checkout in progress — skipping cart sync");
            return;
          }
          if (cartSyncPromise) return cartSyncPromise;

          cartSyncPromise = (async function() {
          try {
            if (window.__sapCheckoutInProgress) return;
            showCartLoader();
            console.log("[SAP/Redis] Starting cart price sync...");
            const cartResponse = await fetch(window.Shopify.routes.root + 'cart.js');
            let cart = await cartResponse.json();

            if (!cart.items || cart.items.length === 0) {
              console.log("[SAP/Redis] Cart is empty");
              return;
            }

            const cartAfterDiscountClear = await clearCartDiscounts();
            if (cartAfterDiscountClear && cartAfterDiscountClear.items) {
              cart = cartAfterDiscountClear;
            }
            await removeSapPropertiesFromCart(cart);

            console.log("[SAP/Redis] Syncing prices for", cart.items.length, "items");
            console.log("cart =>", cart);
            console.log("customer id =>", {{ customer.id | json }});
            console.log("customer addresses =>", {{ customer.addresses | json }});
            console.log("shop =>", {{ shop.permanent_domain | json }});
            const syncUrl = "/apps/sap-price-test/cart-price-sync";
            console.log("[SAP/Redis] Calling sync endpoint:", syncUrl);

            // 1. Call our orchestrator endpoint
            const syncResponse = await fetch(syncUrl, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                cart: cart,
                customer: {
                    id: {{ customer.id | json }},
                    addresses: {{ customer.addresses | json }},
                    shop: {{ shop.permanent_domain | json }}
                }
              })
            });

            const syncData = await syncResponse.json();
            console.log("[SAP/Redis] Sync response data:", syncData);

            if (!syncData.prices || Object.keys(syncData.prices).length === 0) {
              console.log("[SAP/Redis] No price updates found in Redis for these SKUs");
              return;
            }

            // 2. Update displayed line prices (DOM only — no sap_price line properties on /cart)
            cart.items.forEach((item, index) => {
              const sku = item.sku || item.variant_sku;
              const effectivePrice = syncData.prices[sku];
              if (effectivePrice == null || Number(effectivePrice) <= 0) return;

              const newPrice = Number(effectivePrice);
              const shopifyDollars = Number(item.price) / 100;
              if (!Number.isFinite(newPrice) || newPrice <= 0) return;
              if (Number.isFinite(shopifyDollars) && newPrice >= shopifyDollars) {
                console.log("[SAP/Redis] Redis price higher than Shopify sales price for SKU", sku, "— keeping Shopify cart price");
                return;
              }
              if (Number.isFinite(newPrice) && newPrice > 0) {
                const priceInCents = Math.round(newPrice * 100);
                const formattedPrice = (typeof Shopify !== 'undefined' && Shopify.formatMoney) 
                  ? Shopify.formatMoney(priceInCents) 
                  : "$" + newPrice.toFixed(2);
                
                const lineTotalCents = priceInCents * item.quantity;
                const formattedLineTotal = (typeof Shopify !== 'undefined' && Shopify.formatMoney) 
                  ? Shopify.formatMoney(lineTotalCents) 
                  : "$" + (lineTotalCents / 100).toFixed(2);

                console.log(`[SAP/Redis] Updating DOM for SKU: ${sku}`);
                
                // Row identification
                const itemKey = item.key;
                const itemId = item.id;
                const variantId = item.variant_id;
                
                const rowSelectors = [
                  `.cart-item[data-key="${itemKey}"]`,
                  `[data-cart-item-key="${itemKey}"]`,
                  `[data-cart-item-id="${itemId}"]`,
                  `[data-variant-id="${variantId}"]`,
                  `#CartItem-${index + 1}`
                ];
                
                let rows = [];
                rowSelectors.forEach(sel => {
                  document.querySelectorAll(sel).forEach(r => {
                    if (!rows.includes(r)) rows.push(r);
                  });
                });

                if (rows.length > 0) {
                  rows.forEach(row => {
                    // Update Unit Prices (standard price nodes only)
                    row.querySelectorAll('.cart-item__price, .price-item--regular, .price:not(.price--end):not(.price--last)').forEach(el => {
                      if (!el.closest('.cart-item__totals')) {
                        el.textContent = formattedPrice;
                      }
                    });
                    // One unit-price slot in details — not variant options inside <dl>
                    const details = row.querySelector('.cart-item__details');
                    if (details) {
                      const options = details.querySelectorAll('.product-option');
                      for (const priceEl of options) {
                        if (!priceEl.closest('dl')) {
                          priceEl.textContent = formattedPrice;
                          break;
                        }
                      }
                    }
                    // Update Line Totals
                    row.querySelectorAll('.cart-item__total, .cart-item__totals .price, .price--end, .cart-item__totals .price-item--regular').forEach(el => {
                      el.textContent = formattedLineTotal;
                    });
                  });
                } else {
                  // Global fallback if no rows found
                  document.querySelectorAll(`[data-cart-item-key="${itemKey}"] .price`).forEach(el => {
                    el.textContent = formattedPrice;
                  });
                }
              }
            });

            const cartRefresh = await fetch(window.Shopify.routes.root + "cart.js");
            const cartAfter = await cartRefresh.json();
            await removeSapPropertiesFromCart(cartAfter);

            scheduleCartTotalsRefresh(syncData.prices, cartAfter);

            console.log("[SAP/Redis] Cart display updated — no sap_price properties on cart lines");
          } catch (err) {
            console.error("[SAP/Redis] Error in sync process:", err);
          } finally {
            hideCartLoader();
            cartSyncPromise = null;
          }
          })();

          return cartSyncPromise;
        }

        function scheduleCartTotalsRefresh(priceMap, cartData) {
          const run = function() {
            updateCartTotals(priceMap, cartData);
          };
          run();
          setTimeout(run, 400);
          setTimeout(run, 1200);
          setTimeout(run, 2500);

          const footer =
            document.querySelector("#main-cart-footer, .cart__footer, .totals, cart-items") ||
            document.body;
          if (window.__sapTotalsObserver) {
            window.__sapTotalsObserver.disconnect();
          }
          window.__sapTotalsObserver = new MutationObserver(function() {
            run();
          });
          window.__sapTotalsObserver.observe(footer, {
            childList: true,
            subtree: true,
            characterData: true,
          });
          setTimeout(function() {
            if (window.__sapTotalsObserver) {
              window.__sapTotalsObserver.disconnect();
              window.__sapTotalsObserver = null;
            }
          }, 12000);
        }

        function updateCartTotals(priceMap, cartData) {
          hideCartLevelDiscountUi();

          const merchandiseCents = computeMerchandiseTotalCents(priceMap, cartData);
          const formattedMerchandise = formatMoneyFromCents(merchandiseCents);
          console.log("[SAP/Redis] Cart estimated total (no cart discount):", formattedMerchandise);

          const subtotalSelectors = [
            ".totals__subtotal-value",
            ".cart__subtotal-value",
            ".cart-subtotal__price",
            ".js-cart-subtotal",
            "#cart-subtotal",
            "[data-cart-subtotal]",
          ];

          subtotalSelectors.forEach(function(sel) {
            document.querySelectorAll(sel).forEach(function(el) {
              setPriceText(el, formattedMerchandise);
            });
          });

          const estimatedSelectors = [
            ".totals__total-value",
            ".totals__total-value--final",
            ".cart__total-value",
            ".cart-total",
            ".cart__total",
            "#cart-total-price",
            "[data-cart-total]",
            ".bss-b2b-cart-total",
            ".order-total__price",
            ".cart-summary__total",
            "main-cart-footer .price--end",
          ];

          let estimatedUpdated = false;
          estimatedSelectors.forEach(function(sel) {
            document.querySelectorAll(sel).forEach(function(el) {
              if (el.closest(".cart-item, .cart-item__totals, line-item, .cart-item__price")) return;
              setPriceText(el, formattedMerchandise);
              estimatedUpdated = true;
            });
          });

          document.querySelectorAll("main-cart-footer .totals, .cart__footer .totals").forEach(function(totals) {
            totals.querySelectorAll(".totals__total-value, .totals__total-value--final").forEach(function(el) {
              setPriceText(el, formattedMerchandise);
              estimatedUpdated = true;
            });
          });

          document.querySelectorAll(".totals__total, .cart__estimated-total").forEach(function(block) {
            const label = block.querySelector("h2, h3, .totals__label, legend");
            const labelText = label ? label.textContent.trim().toLowerCase() : "";
            if (labelText.indexOf("estimated") !== -1 || labelText.indexOf("total") !== -1) {
              const valueEl = block.querySelector(
                ".totals__total-value, .totals__total-value--final, .price-item--regular, .price"
              );
              if (valueEl) {
                setPriceText(valueEl, formattedMerchandise);
                estimatedUpdated = true;
              }
            }
          });

          if (!estimatedUpdated) {
            console.log("[SAP/Redis] Estimated total — trying label sibling match");
            document.querySelectorAll("h2, h3, dt, .totals__label, span").forEach(function(label) {
              if (!/estimated\s+total/i.test(label.textContent)) return;
              const row = label.closest(".totals__total, .totals__row, li, div");
              if (!row) return;
              const valueEl = row.querySelector(
                ".totals__total-value, .price-item--regular, .price, p, span.money"
              );
              if (valueEl && valueEl !== label) {
                setPriceText(valueEl, formattedMerchandise);
                estimatedUpdated = true;
              }
            });
          }

          if (!estimatedUpdated) {
            console.log("[SAP/Redis] Estimated total — fuzzy price match in footer");
            document.querySelectorAll(".totals, .cart__footer, #main-cart-footer, .cart__blocks").forEach(function(footer) {
              footer.querySelectorAll(".price, [class*='total-value'], .money").forEach(function(el) {
                if (el.closest(".cart-item, line-item")) return;
                const text = (el.textContent || "").trim();
                if (text.match(/^[\$\£\€\¥]/) && text.length < 24) {
                  setPriceText(el, formattedMerchandise);
                  estimatedUpdated = true;
                }
              });
            });
          }

          const estimatedLabelNodes = document.querySelectorAll(
            "h2, h3, dt, .totals__label, .totals__total-label, legend, span, p"
          );
          estimatedLabelNodes.forEach(function(label) {
            if (!/estimated\s+total/i.test(label.textContent || "")) return;
            let valueEl = label.nextElementSibling;
            if (!valueEl || !valueEl.textContent.match(/^[\$\£\€\¥]/)) {
              valueEl = label.parentElement && label.parentElement.querySelector(
                ".totals__total-value, .price-item--regular, .price, .money"
              );
            }
            if (valueEl) {
              setPriceText(valueEl, formattedMerchandise);
              estimatedUpdated = true;
            }
          });

          hideCartLevelDiscountUi();
        }

        setupCartChangeReload();
        restoreCartNoteDraft();

        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", function() {
            restoreCartNoteDraft();
            syncCartPrices();
          });
        } else {
          syncCartPrices();
        }
      })();
  </script>
{% endif %}

{% if template.name == 'product' and product %}
  <script>
    (function() {
      console.log("[Redis pricing] Product page script started");
      var redisCustomerId = {{ customer.id | json }};
      var variants = {{ product.variants | json }};
      var skus = variants.filter(function(v) { return v.sku && v.sku.trim(); }).map(function(v) { return v.sku.trim(); });
      console.log("[Redis pricing] Variants:", variants.length, "SKUs:", skus);
      if (skus.length === 0) {
        console.log("[Redis pricing] No SKUs, exiting");
        return;
      }

      var priceMap = {};
      var redisUrl = "/apps/sap-price-test/redis-prices?customerId=" + encodeURIComponent(redisCustomerId) + "&skus=" + skus.map(encodeURIComponent).join(",") + "&shop=" + encodeURIComponent({{ shop.permanent_domain | json }});
      console.log("[Redis pricing] Fetching Redis prices, customerId:", redisCustomerId, "url:", redisUrl);

      fetch(redisUrl)
        .then(function(r) {
          console.log("[Redis pricing] Response status:", r.status);
          return r.json();
        })
        .then(function(data) {
          console.log("[Redis pricing] Redis response:", data);
          if (data.prices) priceMap = data.prices;
          console.log("[Redis pricing] Price map:", priceMap);
          applyRedisPrice();
        })
        .catch(function(err) {
          console.error("[Redis pricing] Fetch error:", err);
        });

      function formatMoney(cents) {
        if (typeof cents !== "number") cents = parseFloat(cents) || 0;
        if (window.Shopify && window.Shopify.formatMoney) return window.Shopify.formatMoney(Math.round(cents * 100));
        return "$" + (cents).toFixed(2);
      }

      function getSelectedSku() {
        var idInput = document.querySelector('input[name="id"], select[name="id"]');
        if (!idInput) {
          var fallback = (variants[0] && variants[0].sku) ? variants[0].sku.trim() : null;
          console.log("[Redis pricing] No variant input found, using first variant SKU:", fallback);
          return fallback;
        }
        var id = (idInput.tagName === "SELECT") ? idInput.value : idInput.value;
        var v = variants.find(function(v) { return String(v.id) === String(id); });
        var sku = (v && v.sku) ? v.sku.trim() : null;
        console.log("[Redis pricing] Selected variant id:", id, "SKU:", sku);
        return sku;
      }

      function applyRedisPrice() {
        var sku = getSelectedSku();
        console.log("[Redis pricing] applyRedisPrice, selected SKU:", sku, "priceMap[sku]:", sku ? priceMap[sku] : "N/A");
        if (!sku || priceMap[sku] == null || priceMap[sku] === undefined) {
          console.log("[Redis pricing] No Redis price for this SKU, skipping update");
          return;
        }
        var redisPrice = parseFloat(priceMap[sku]);
        if (isNaN(redisPrice) || redisPrice <= 0) {
          console.log("[Redis pricing] SAP price zero/missing — keeping Shopify price");
          return;
        }
        var selected = variants.find(function(v) { return v.sku && String(v.sku).trim() === String(sku); });
        var shopifyCents = selected && selected.price != null ? Number(selected.price) : NaN;
        var shopifyDollars = Number.isFinite(shopifyCents) ? shopifyCents / 100 : NaN;
        if (Number.isFinite(shopifyDollars) && redisPrice >= shopifyDollars) {
          console.log("[Redis pricing] Redis price higher than Shopify sales price — keeping Shopify price");
          return;
        }
        var sel = ".price-item--regular, [data-product-price], .product__price .price, .product-price, #product-price, .product-single__price, .price";
        var els = document.querySelectorAll(sel);
        console.log("[Redis pricing] Updating price to", redisPrice, "formatted:", formatMoney(redisPrice), "elements found:", els.length);
        els.forEach(function(el) {
          el.textContent = formatMoney(redisPrice);
        });
      }

      function onVariantChange() {
        console.log("[Redis pricing] Variant change detected");
        applyRedisPrice();
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", function() {
          console.log("[Redis pricing] DOMContentLoaded");
          var idInput = document.querySelector('input[name="id"], select[name="id"]');
          if (idInput) {
            idInput.addEventListener("change", onVariantChange);
            idInput.addEventListener("input", onVariantChange);
            console.log("[Redis pricing] Variant input listeners attached");
          }
          setTimeout(applyRedisPrice, 400);
        });
      } else {
        console.log("[Redis pricing] DOM already ready");
        var idInput = document.querySelector('input[name="id"], select[name="id"]');
        if (idInput) {
          idInput.addEventListener("change", onVariantChange);
          idInput.addEventListener("input", onVariantChange);
          console.log("[Redis pricing] Variant input listeners attached");
        }
        setTimeout(applyRedisPrice, 400);
      }
    })();
  </script>
{% endif %}

