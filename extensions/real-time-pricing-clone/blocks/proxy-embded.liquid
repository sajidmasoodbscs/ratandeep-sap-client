  <script>
      (function() {
        console.log("[SAP/Redis] Cart page script started");

        async function syncCartPrices() {
          try {
            console.log("[SAP/Redis] Starting cart price sync...");
            const cartResponse = await fetch(window.Shopify.routes.root + 'cart.js');
            const cart = await cartResponse.json();

            if (!cart.items || cart.items.length === 0) {
              console.log("[SAP/Redis] Cart is empty");
              return;
            }

            console.log("[SAP/Redis] Syncing prices for", cart.items.length, "items");
            console.log("cart =>", cart);
            console.log("customer id =>", {{ customer.id | json }});
            console.log("customer addresses =>", {{ customer.addresses | json }});
            console.log("shop =>", {{ shop.permanent_domain | json }});
            const syncUrl = "https://ratandeep-sap-client.onrender.com/apps/sap-price-test/cart-price-sync";
            console.log("[SAP/Redis] Calling sync endpoint:", syncUrl);

            // 1. Call our orchestrator endpoint
            const syncResponse = await fetch(syncUrl, {
              method: "POST",
              headers: { "Content-Type": "application/json" },
              body: JSON.stringify({
                cart: cart,
                customer: {
                    id: {{ customer.id | json }},
                    addresses: {{ customer.addresses | json }},
                    shop: {{ shop.permanent_domain | json }}
                }
              })
            });

            const syncData = await syncResponse.json();
            console.log("[SAP/Redis] Sync response data:", syncData);

            if (!syncData.prices || Object.keys(syncData.prices).length === 0) {
              console.log("[SAP/Redis] No price updates found in Redis for these SKUs");
              return;
            }

            // 2. Update the DOM directly first for immediate feedback
            cart.items.forEach((item, index) => {
              const sku = item.sku || item.variant_sku;
              const newPrice = syncData.prices[sku];
              if (newPrice != null) {
                const priceInCents = Math.round(newPrice * 100);
                const formattedPrice = (typeof Shopify !== 'undefined' && Shopify.formatMoney) 
                  ? Shopify.formatMoney(priceInCents) 
                  : "$" + newPrice.toFixed(2);
                
                const lineTotalCents = priceInCents * item.quantity;
                const formattedLineTotal = (typeof Shopify !== 'undefined' && Shopify.formatMoney) 
                  ? Shopify.formatMoney(lineTotalCents) 
                  : "$" + (lineTotalCents / 100).toFixed(2);

                console.log(`[SAP/Redis] Updating DOM for SKU: ${sku}`);
                
                // Row identification
                const itemKey = item.key;
                const itemId = item.id;
                const variantId = item.variant_id;
                
                const rowSelectors = [
                  `.cart-item[data-key="${itemKey}"]`,
                  `[data-cart-item-key="${itemKey}"]`,
                  `[data-cart-item-id="${itemId}"]`,
                  `[data-variant-id="${variantId}"]`,
                  `#CartItem-${index + 1}`
                ];
                
                let rows = [];
                rowSelectors.forEach(sel => {
                  document.querySelectorAll(sel).forEach(r => {
                    if (!rows.includes(r)) rows.push(r);
                  });
                });

                if (rows.length > 0) {
                  rows.forEach(row => {
                    // Update Unit Prices
                    row.querySelectorAll('.cart-item__price, .price-item--regular, .price:not(.price--end):not(.price--last), .product-option').forEach(el => {
                      if (!el.closest('.cart-item__totals')) {
                        el.textContent = formattedPrice;
                      }
                    });
                    // Update Line Totals
                    row.querySelectorAll('.cart-item__total, .cart-item__totals .price, .price--end, .cart-item__totals .price-item--regular').forEach(el => {
                      el.textContent = formattedLineTotal;
                    });
                  });
                } else {
                  // Global fallback if no rows found
                  document.querySelectorAll(`[data-cart-item-key="${itemKey}"] .price`).forEach(el => {
                    el.textContent = formattedPrice;
                  });
                }
              }
            });

            // 3. Update subtotals
            updateCartTotals(syncData.prices, cart);

            // 4. Use Shopify AJAX API to persist line item properties (attributes)
            // This is required for the Cart Transformer to see the custom price
            const updates = {};
            let needsUpdate = false;

            cart.items.forEach((item) => {
              const sku = item.sku || item.variant_sku;
              const newPrice = syncData.prices[sku];
              
              if (newPrice != null && item.properties?.sap_price != String(newPrice)) {
                updates[item.key] = {
                  properties: {
                    ...(item.properties || {}),
                  }
                };
                needsUpdate = true;
              }
            });

            if (!needsUpdate) {
              console.log("[SAP/Redis] All items already have correct persistent attributes");
              return;
            }

            // Loop protection: Check if we have recently reloaded
            const lastReload = sessionStorage.getItem('sap_sync_reload');
            const now = Date.now();
            if (lastReload && (now - parseInt(lastReload)) < 10000) {
              console.log("[SAP/Redis] Loop detected or sync already performed recently. Skipping persistence to prevent infinite reload.");
              return;
            }

            console.log("[SAP/Redis] Updating cart line attributes via AJAX API...");
            
            // Mark that we are about to reload to prevent loop
            sessionStorage.setItem('sap_sync_reload', now.toString());

            // We must use /cart/change.js for each item to properly update properties
            for (const key in updates) {
               console.log(`[SAP/Redis] Persisting price for item key: ${key}`);
               try {
                 await fetch(window.Shopify.routes.root + 'cart/change.js', {
                   method: "POST",
                   headers: { "Content-Type": "application/json" },
                   body: JSON.stringify({
                     id: key,
                     properties: updates[key].properties
                   })
                 });
               } catch (err) {
                 console.error(`[SAP/Redis] Failed to update item ${key}:`, err);
               }
            }

            console.log("[SAP/Redis] State persisted, reloading page to apply Cart Transformer logic");
            window.location.reload();
          } catch (err) {
            console.error("[SAP/Redis] Error in sync process:", err);
          }
        }

        function updateCartTotals(priceMap, cartData) {
          let newSubtotal = 0;
          cartData.items.forEach((cartItem) => {
            const sku = cartItem.sku || cartItem.variant_sku || (cartItem.variant && cartItem.variant.sku);
            const quantity = cartItem.quantity || 1;
            if (sku && priceMap[sku] != null) {
              const newPrice = Number(priceMap[sku]);
              if (Number.isFinite(newPrice)) {
                newSubtotal += newPrice * quantity;
                return;
              }
            }
            newSubtotal += (cartItem.price / 100) * quantity;
          });

          const subtotalInCents = Math.round(newSubtotal * 100);
          const formattedTotal = (typeof Shopify !== 'undefined' && Shopify.formatMoney) 
            ? Shopify.formatMoney(subtotalInCents) 
            : "$" + newSubtotal.toFixed(2);
          
          console.log(`[SAP/Redis] New subtotal: ${formattedTotal}`);

          const selectors = [
            '.cart__subtotal', 
            '.cart-subtotal', 
            '[data-cart-subtotal]', 
            '.cart-total', 
            '.cart__total', 
            '.totals-subtotal-value',
            '.totals__subtotal-value',
            '.totals__total-value', // Dawn theme subtotal
            '.totals__total-value--final', // Dawn theme total
            '.cart__subtotal-value',
            '.cart-subtotal__price',
            '.js-cart-subtotal',
            '#cart-subtotal'
          ];

          let updated = false;
          selectors.forEach(sel => {
            document.querySelectorAll(sel).forEach(el => {
              el.textContent = formattedTotal;
              updated = true;
            });
          });

          if (!updated) {
            console.log('[SAP/Redis] Subtotal not found by exact selectors, trying fuzzy match...');
            document.querySelectorAll('[class*="total"], [class*="subtotal"]').forEach(el => {
              if (updated) return;
              const text = el.textContent.trim();
              if (el.children.length === 0 && text.match(/^[\$\£\€\¥\d]/) && text.length < 20) {
                el.textContent = formattedTotal;
                updated = true;
                console.log(`[SAP/Redis] Updated subtotal via fuzzy class match: ${el.className}`);
              }
            });
          }

          if (!updated) {
            console.log('[SAP/Redis] Subtotal element matching common selectors not found.');
          }
        }

        // Run on load
        if (document.readyState === "loading") {
          document.addEventListener("DOMContentLoaded", syncCartPrices);
        } else {
          syncCartPrices();
        }
      })();
  </script>
{% endif %}

