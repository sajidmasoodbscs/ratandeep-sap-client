<div class="loaderBars">
  <div class="jumpy-bars">
    <div class="bar" id="bar1"></div>
    <div class="bar" id="bar2"></div>
    <div class="bar" id="bar3"></div>
    <div class="bar" id="bar4"></div>
    <div class="bar" id="bar5"></div>
    <div class="bar" id="bar6"></div>
    <div class="bar" id="bar7"></div>
  </div>
  <div class="sap-text">
    <h5>Please wait while we fetch the latest prices for you. Thank you for your patience!</h5>
  </div>
</div>
<style>
  body.RunningLoader {
    position: relative;
    overflow: hidden;
  }
  .RunningLoader:after {
    content: '';
    position: absolute;
    width: 100%;
    height: 100%;
    top: 0;
    left: 0;
    right: 0;
    margin: 0 auto;
    background: #000000c4;
    z-index: 9;
    overflow: hidden;
    bottom: 0;
  }
  .loaderBars {
    width: 100%;
    display: none;
    height: 100%;
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    margin: 0 auto;
    z-index: 999;
  }
  .overlay {
    display: block !important;
    background: #0000002b;
    width: 100%;
    height: 100%;
    position: absolute;
    top: 0;
    bottom: 0;
    left: 0;
    right: 0;
    z-index: 999;
  }
  .jumpy-bars {
    display: flex !important;
    justify-content: space-evenly;
    width: 4.5em;
    height: 3.5em;
    gap: 0.3em;
    position: absolute;
    top: 50%;
    left: 0;
    right: 0;
    margin: 0 auto;
    z-index: 99;
  }

  #bar1 {
    animation-delay: 0.2s;
  }
  #bar2 {
    animation-delay: 0.4s;
  }
  #bar3 {
    animation-delay: 0.6s;
  }
  #bar4 {
    animation-delay: 0.8s;
  }
  #bar5 {
    animation-delay: 1s;
  }
  #bar6 {
    animation-delay: 1.2s;
  }
  #bar7 {
    animation-delay: 1.5s;
  }
  .bar {
    width: 1em;
    height: auto;
    opacity: 0;
    background-color: black;
    border-radius: 100%;
    animation: jumping-bars 1s linear infinite alternate-reverse;
    display: block !important;
  }
  .sap-text {
    position: absolute;
    top: 60%;
    left: 0;
    right: 0;
    margin: 0 auto;
    max-width: 280px;
    text-align: center;
  }
  .sap-text h5 {
    color: white;
    font-size: 18px;
    margin-top: 40px;
  }

  @keyframes jumping-bars {
    0% {
      opacity: 1;
      transform: scaleY(0);
    }
    50% {
      opacity: 1;
      transform: scaleY(0.5);
    }
    100% {
      opacity: 1;
      transform: scaleY(1.8);
    }
  }
  .adressError p {
    color: red;
    margin-bottom: 30px;
    margin-top: 0;
  }
</style>
