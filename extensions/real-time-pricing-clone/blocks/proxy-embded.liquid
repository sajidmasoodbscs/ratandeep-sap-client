        return response.json();
      })
      .then(data => {
        console.log("[SAP Checkout] createDraftOrder JSON response:", data);
        const jobId = data.jobId;
        if (!jobId) {
          console.error("[SAP Checkout] No jobId returned from createDraftOrder, redirecting to cart");
          document.querySelector(".loaderBars").style.display = "none";
          document.body.classList.remove("RunningLoader");
          window.location.href = "/cart";
          return;
        }
        console.log('[SAP Checkout] Job started with ID:', jobId);

        // Start polling for job status
        pollJobStatus(jobId);
      })
      .catch(error => {
        console.error('[SAP Checkout] Error starting process (createDraftOrder):', error);
        document.querySelector(".loaderBars").style.display = "none";
        document.body.classList.remove("RunningLoader");
        window.location.href = "/cart";
      });
  }

  function pollJobStatus(jobId) {
    console.log(`[SAP Checkout] pollJobStatus called for Job ID: ${jobId}`);
    const url = "https://ratandeep-sap-client.onrender.com/apps/sap-price-test/check-checkout-url";

    function hideLoader() {
      document.querySelector(".loaderBars").style.display = "none";
      document.body.classList.remove("RunningLoader");
    }

    const interval = setInterval(() => {
      console.log("[SAP Checkout] Polling checkout status...");
      fetch(url, {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
        },
        body: JSON.stringify({ jobId, shop: {{ shop.permanent_domain | json }} }),
      })
        .then(response => {
          console.log("[SAP Checkout] check-checkout-url raw response:", response);
          if (!response.ok) {
            throw new Error(`HTTP error! Status: ${response.status}`);
          }
          return response.json();
        })
        .then(data => {
          console.log("[SAP Checkout] Job status payload:", data);

          if (data.status === "completed" && data.redirectUrl) {
            clearInterval(interval);
            hideLoader();
            console.log("[SAP Checkout] Job completed, redirecting to checkout URL:", data.redirectUrl);
            window.location.href = data.redirectUrl;
          } else if (data.status === "failed") {
            clearInterval(interval);
            hideLoader();
            console.error("[SAP Checkout] Checkout job failed:", data.error);
            window.location.href = "/cart";
          } else {
            console.log("[SAP Checkout] Job still in progress or unknown status:", data.status);
          }
        })
        .catch(error => {
          console.error("[SAP Checkout] Error checking status (pollJobStatus):", error);
          clearInterval(interval);
          hideLoader();
          window.location.href = "/cart";
        });
    }, 1000);

    // Safety timeout: stop polling after 2 minutes and send back to cart
    setTimeout(() => {
      if (interval) {
        clearInterval(interval);
        hideLoader();
        console.warn("[SAP Checkout] Checkout polling timed out. Redirecting to cart.");
        window.location.href = "/cart";
      }
    }, 120000);
  }


