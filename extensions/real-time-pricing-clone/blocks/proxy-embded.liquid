    if (currentURL.searchParams.get("incomplete") === "true") { // Create a new div
      const cust_addr = {{ customer.addresses | json }}
      console.log("Customer addresses are: ", cust_addr);
      const isValid = isValidDefaultAddress(cust_addr);
      if (isValid) {
        document.querySelectorAll(".adressError").forEach(el => el.style.display = "none");
