{%- style -%}
  :root {
    --pfx-bg-color: {{ section.settings.bg_color }};
    --pfx-text-color: {{ section.settings.text_color }};
    --pfx-sticky-bg: {{ section.settings.sticky_bg_color }};
    --pfx-sticky-text: {{ section.settings.sticky_text_color }};
    --pfx-radius: {{ section.settings.border_radius }}px;
    --pfx-font-size: {{ section.settings.font_size }}px;
    --pfx-icon-size: {{ section.settings.icon_size }}px;
    --pfx-height: {{ section.settings.header_height }}px;
  }

  /* Base Structural Layout */
  .pfx-header-wrapper {
    width: 100%;
    position: relative;
    z-index: 100;
    font-family: 'Inter', sans-serif;
    background-color: var(--pfx-bg-color);
    transition: all 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  {% if section.settings.enable_transparent and template.name == 'index' %}
    .pfx-header-wrapper.pfx-transparent {
      position: absolute;
      top: 35px;
      left: 0;
      background-color: transparent;
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
      --pfx-text-color: #ffffff;
    }
  {% endif %}

  {% if section.settings.enable_sticky %}
    .pfx-header-wrapper.pfx-sticky-active {
      position: fixed;
      top: 0;
      left: 0;
      background-color: var(--pfx-sticky-bg) !important;
      --pfx-text-color: var(--pfx-sticky-text) !important;
      box-shadow: 0 4px 30px rgba(0, 0, 0, 0.03);
      backdrop-filter: blur(10px);
      animation: pfx-slide-down 0.35s ease;
    }
  {% endif %}

  @keyframes pfx-slide-down {
    from { transform: translateY(-100%); }
    to { transform: translateY(0); }
  }

  .pfx-container {
    max-width: 85%;
    margin: 0 auto;
    padding: {{ section.settings.padding_vertical }}px {{ section.settings.padding_horizontal }}px 5px;
  }

  /* Row 1 Grid Layout */
  .pfx-top-row {
    display: grid;
    grid-template-columns: 220px 1fr 260px;
    align-items: center;
    gap: 30px;
    height: calc(var(--pfx-height) * 0.6);
  }

  .pfx-logo-link {
    display: inline-flex;
    align-items: center;
    text-decoration: none;
    color: var(--pfx-text-color);
    font-weight: 700;
    font-size: 22px;
    letter-spacing: -0.5px;
  }

  .pfx-logo-img {
    max-width: {{ section.settings.logo_width }}px;
    height: auto;
    object-fit: contain;
    border-radius: 0px;
  }

  /* Desktop Premium Search Container */
  .pfx-search-container {
    position: relative;
    width: 100%;
    max-width: 100%;
    margin: 0 auto;
    background: rgba(0, 0, 0, 0.03);
    border-radius: 50px;
  }

  .pfx-search-form {
    display: flex;
    align-items: center;
    background: rgba(0, 0, 0, 0.03);
    /* border: 1px solid rgba(0, 0, 0, 0.08); */
    border-radius: var(--pfx-radius);
    padding: 0 16px;
    height: 44px;
    transition: all 0.3s ease;
  }

  .pfx-transparent .pfx-search-form {
    background: rgb(255 255 255 / 62%);
    /* border: 1px solid rgba(255, 255, 255, 0.2); */
  }

  .pfx-search-form:focus-within {
    background: #ffffff;
    /* border-color: var(--pfx-text-color); */
    box-shadow: 0 0 0 3px rgba(0,0,0,0.03);
  }
.pfx-search-input:focus {
  outline: none !important;
  box-shadow: none !important;
  border: none !important;
}
  .pfx-search-input {
    width: 100%;
    border: none;
    background: transparent;
    padding: 10px 0;
    font-size: 14px;
    color: rgb(119, 119, 119);
    outline: none;
  
  }

  .pfx-search-submit {
    background: none;
    border: none;
    cursor: pointer;
    padding: 0;
    display: flex;
    align-items: center;
    color: #00404c;
  }

  .pfx-search-submit svg {
    width: 18px;
    height: 18px;
  }

  /* Predictive Search Dropdown Panel */
  .pfx-predictive-results {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #ffffff;
    border-radius: 8px;
    box-shadow: 0 10px 40px rgba(0,0,0,0.1);
    margin-top: 8px;
    max-height: 400px;
    overflow-y: auto;
    display: none;
    z-index: 110;
    border: 1px solid rgba(0,0,0,0.05);
  }

  /* Action Icons Group */
  .pfx-actions {
    display: flex;
    align-items: center;
    justify-content: flex-end;
    gap: 5px;
  }

  .pfx-icon-btn {
    background: none;
    border: none;
    color: #00404C;
    cursor: pointer;
    position: relative;
    display: flex;
    align-items: center;
    text-decoration: none;
    padding: 6px;
    transition: opacity 0.2s ease;
  }

  .pfx-icon-btn:hover {
    opacity: 0.7;
  }

  .pfx-icon-btn svg {
    width: var(--pfx-icon-size);
    height: var(--pfx-icon-size);
  }

  .pfx-badge {
    position: absolute;
    top: -2px;
    right: -2px;
    background: #000000;
    color: #ffffff;
    font-size: 8px;
    font-weight: 600;
    width: 16px;
    height: 16px;
    border-radius: 50%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .pfx-transparent .pfx-badge {
    background: #ffffff;
    color: #000000;
  }

  /* Localization Form Styling */
  .pfx-localization-dropdown {
    position: relative;
  }
  .pfx-localization-select {
    background: transparent;
    border: none;
    color: var(--pfx-text-color);
    font-size: 13px;
    font-weight: 500;
    cursor: pointer;
    padding-right: 15px;
    outline: none;
  }

  /* Row 2 Navigation Layout */
  .pfx-bottom-row {
    display: flex;
    justify-content: center;
    margin-top: 15px;

  }

  .pfx-nav {
    display: flex;
    align-items: center;
    gap: 32px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .pfx-nav-item {
    position: relative;
  }

  .pfx-nav-link {
    text-decoration: none;
    color: #00404c;
    font-size: var(--pfx-font-size);
    font-weight: 600;
    padding: 10px 0;
    display: flex;
    align-items: center;
    gap: 4px;
    transition: color 0.25s ease;
  }

  /* Standard Dropdown Architecture */
  .pfx-dropdown {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%) translateY(10px);
    background: #ffffff;
    min-width: 220px;
    border-radius: 8px;
    box-shadow: 0 10px 30px rgba(0,0,0,0.06);
    padding: 12px 0;
    list-style: none;
    opacity: 0;
    visibility: hidden;
    transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 105;
  }

  .pfx-nav-item:hover .pfx-dropdown {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .pfx-dropdown-link {
    display: block;
    padding: 8px 24px;
    color: #121212;
    text-decoration: none;
    font-size: 14px;
    transition: background 0.2s ease;
  }

  .pfx-dropdown-link:hover {
    background: rgba(0, 0, 0, 0.03);
  }

  /* Premium Mega Menu Layout */
  .pfx-has-megamenu {
    position: static !important;
  }

  .pfx-megamenu {
    position: absolute;
    top: 100%;
    left: 0;
    width: 100%;
    background: #ffffff;
    box-shadow: 0 15px 35px rgba(0,0,0,0.05);
    border-top: 1px solid rgba(0,0,0,0.05);
    padding: 40px 0;
    opacity: 0;
    visibility: hidden;
    transform: translateY(10px);
    transition: all 0.3s cubic-bezier(0.16, 1, 0.3, 1);
    z-index: 104;
  }

  .pfx-nav-item:hover .pfx-megamenu {
    opacity: 1;
    visibility: visible;
    transform: translateY(0);
  }

  .pfx-megamenu-grid {
    max-width: 1440px;
    margin: 0 auto;
    padding: 0 40px;
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 30px;
  }

  .pfx-megamenu-title {
    font-size: 14px;
    font-weight: 600;
    color: #121212;
    margin-bottom: 16px;
    text-transform: uppercase;
    letter-spacing: 0.5px;
  }

  .pfx-megamenu-list {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pfx-megamenu-link {
    display: block;
    color: #666666;
    text-decoration: none;
    font-size: 14px;
    padding: 6px 0;
    transition: color 0.2s ease;
  }

  .pfx-megamenu-link:hover {
    color: #000000;
  }

  /* Responsive Display Swapping */
  .pfx-mobile-trigger-bar {
    display: none;
    align-items: center;
    justify-content: space-between;
    height: var(--pfx-height);
  }

  /* Mobile Slide Drawer Interface */
  .pfx-mobile-drawer {
    position: fixed;
    top: 0;
    left: -100%;
    width: 100%;
    max-width: 400px;
    height: 100%;
    background: #ffffff;
    z-index: 999;
    box-shadow: 20px 0 40px rgba(0,0,0,0.05);
    transition: left 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .pfx-mobile-drawer.pfx-drawer-open {
    left: 0;
  }

  .pfx-drawer-header {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 20px;
    border-bottom: 1px solid rgba(0,0,0,0.05);
  }

  .pfx-drawer-close {
    background: none;
    border: none;
    cursor: pointer;
    color: #121212;
  }

  .pfx-drawer-close svg {
    width: 24px;
    height: 24px;
  }

  .pfx-drawer-body {
    flex: 1;
    overflow-y: auto;
    padding: 20px;
  }

  /* Mobile Accordion Navigation */
  .pfx-mobile-nav {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .pfx-mobile-nav-item {
    border-bottom: 1px solid rgba(0,0,0,0.03);
  }

  .pfx-mobile-nav-link {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding: 16px 0;
    color: #121212;
    text-decoration: none;
    font-size: 16px;
    font-weight: 500;
    width: 100%;
    background: none;
    border: none;
    text-align: left;
  }

  .pfx-mobile-child-menu {
    list-style: none;
    padding-left: 15px;
    margin: 0;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s cubic-bezier(0.16, 1, 0.3, 1);
  }

  .pfx-mobile-child-menu.pfx-open {
    max-height: 1000px;
  }

  .pfx-mobile-child-link {
    display: block;
    padding: 10px 0;
    color: #666666;
    text-decoration: none;
    font-size: 15px;
  }

  .pfx-drawer-footer {
    padding: 20px;
    border-top: 1px solid rgba(0,0,0,0.05);
    background: #f9f9f9;
  }

  .pfx-drawer-footer-links {
    display: flex;
    flex-direction: column;
    gap: 12px;
    margin-bottom: 20px;
  }

  .pfx-drawer-footer-link {
    color: #121212;
    text-decoration: none;
    font-size: 14px;
    display: flex;
    align-items: center;
    gap: 10px;
  }

  /* Premium Mobile Fullscreen Search Overlay */
  .pfx-search-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: #ffffff;
    z-index: 1000;
    padding: 20px;
    transform: translateY(-100%);
    transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
    display: flex;
    flex-direction: column;
  }

  .pfx-search-overlay.pfx-overlay-open {
    transform: translateY(0);
  }

  .pfx-overlay-top {
    display: flex;
    align-items: center;
    gap: 15px;
  }

  .pfx-mobile-search-form {
    flex: 1;
    display: flex;
    align-items: center;
    background: #f5f5f7;
    border-radius: 20px;
    padding: 0 15px;
    height: 44px;
  }

  .pfx-mobile-search-input {
    width: 100%;
    border: none;
    background: transparent;
    outline: none;
    font-size: 15px;
  }

  .pfx-overlay-close-btn {
    background: none;
    border: none;
    font-size: 14px;
    font-weight: 500;
    color: #666666;
    cursor: pointer;
  }

  .pfx-drawer-overlay {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background: rgba(0, 0, 0, 0.4);
    z-index: 998;
    opacity: 0;
    visibility: hidden;
    transition: all 0.3s ease;
  }

  .pfx-drawer-overlay.pfx-overlay-active {
    opacity: 1;
    visibility: visible;
  }

  /* Responsive Breakpoints & Device Management */
  @media (max-width: 1199px) {
    .pfx-top-row {
      grid-template-columns: 180px 1fr 220px;
      gap: 15px;
    }
    .pfx-nav { gap: 20px; }

  }

  @media (max-width: 991px) {
    .pfx-desktop-nav-row { display: none !important; }
    .pfx-top-row { display: none !important; }
    .pfx-mobile-trigger-bar { display: flex !important; }
    .pfx-header-wrapper { height: auto !important; }
    .pfx-logo-img { max-width: {{ section.settings.mobile_logo_width }}px; }
    .pfx-container {
    max-width: 100%;
   
}
    
  }
  
