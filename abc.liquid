<header class="pfx-header-wrapper {% if section.settings.enable_transparent %}pfx-transparent{% endif %}" data-premium-header>
  <div class="pfx-container">
    
    <!-- Desktop Layout (Top Row) -->
    <div class="pfx-top-row {% unless customer %}no-search{% endunless %}">
      <!-- Logo Block -->
      <div class="pfx-logo-area">
        <a href="{{ routes.root_url }}" class="pfx-logo-link">
          {%- if section.settings.logo != blank -%}
            <img src="{{ section.settings.logo | image_url: width: 400 }}" class="pfx-logo-img" alt="{{ shop.name }}" width="{{ section.settings.logo_width }}" height="50">
          {%- else -自由 -%}
            <span>{{ shop.name }}</span>
          {%- endif -%}
        </a>
      </div>

      <!-- Search Architecture (Logged-in Protection Added) -->
