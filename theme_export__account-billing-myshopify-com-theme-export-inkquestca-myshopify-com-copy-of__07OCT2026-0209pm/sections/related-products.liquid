<script>
(function () {

  function initRelatedProductATC() {

    const relatedSection = document.querySelector(
      'product-recommendations[data-section-id="{{ section.id }}"]'
    );

    if (!relatedSection) return;

    const forms = relatedSection.querySelectorAll(
      'product-form form[data-type="add-to-cart-form"]'
    );

    forms.forEach(function (form) {

      if (form.dataset.relatedAtcReady === 'true') return;

      form.dataset.relatedAtcReady = 'true';

      form.addEventListener('submit', async function (event) {

        event.preventDefault();
        event.stopPropagation();

        const submitButton = form.querySelector(
          'button[type="submit"]'
        );

        const variantInput = form.querySelector(
          'input[name="id"]'
        );

        const quantityInput = form.querySelector(
          'input[name="quantity"]'
        );

        if (!variantInput) return;

        const variantId = variantInput.value;

        const quantity = quantityInput
          ? Math.max(1, parseInt(quantityInput.value) || 1)
          : 1;

        if (submitButton) {
          submitButton.disabled = true;
          submitButton.classList.add('loading');
        }

        try {

          const response = await fetch(
            window.Shopify.routes.root + 'cart/add.js',
            {
              method: 'POST',
              headers: {
                'Content-Type': 'application/json',
                'Accept': 'application/json'
              },
              body: JSON.stringify({
                items: [
                  {
                    id: Number(variantId),
                    quantity: quantity
                  }
                ],
                sections: [
                  'cart-drawer',
                  'cart-icon-bubble'
                ],
                sections_url: window.location.pathname
              })
            }
          );

          const data = await response.json();

          if (!response.ok) {
            throw new Error(
              data.description || 'Unable to add product to cart.'
            );
          }

          /*
           * Update cart drawer HTML
           */
          if (data.sections) {

            const cartDrawer = document.querySelector('cart-drawer');

            if (
              cartDrawer &&
              data.sections['cart-drawer']
            ) {

              cartDrawer.innerHTML =
                new DOMParser()
                  .parseFromString(
                    data.sections['cart-drawer'],
                    'text/html'
                  )
                  .querySelector('cart-drawer')
                  ?.innerHTML || cartDrawer.innerHTML;
            }

            /*
             * Update cart bubble
             */
            const cartBubble = document.querySelector(
              '#cart-icon-bubble'
            );

            if (
              cartBubble &&
              data.sections['cart-icon-bubble']
            ) {

              const bubbleHTML =
                new DOMParser()
                  .parseFromString(
                    data.sections['cart-icon-bubble'],
                    'text/html'
                  )
                  .querySelector('#cart-icon-bubble');

              if (bubbleHTML) {
                cartBubble.innerHTML = bubbleHTML.innerHTML;
              }
            }
          }

          /*
           * Open cart drawer
           */
          const drawer = document.querySelector('cart-drawer');

          if (drawer) {

            if (typeof drawer.open === 'function') {

              drawer.open();

            } else {

              drawer.classList.add('active');
              drawer.classList.remove('is-empty');

              document.body.classList.add(
                'overflow-hidden'
              );

            }

          } else {

            /*
             * Fallback:
             * try common Dawn cart drawer selectors
             */
            const fallbackDrawer =
              document.querySelector(
                '#CartDrawer, .cart-drawer'
              );

            if (fallbackDrawer) {

              fallbackDrawer.classList.add('active');

              document.body.classList.add(
                'overflow-hidden'
              );

            }

          }

          /*
           * Tell Shopify/theme that cart changed
           */
          document.dispatchEvent(
            new CustomEvent('cart:updated', {
              bubbles: true,
              detail: {
                item: data
              }
            })
          );

          document.dispatchEvent(
            new CustomEvent('cart-update', {
              bubbles: true,
              detail: {
                cart: data
              }
            })
          );

        } catch (error) {

          console.error(
            'Related product ATC error:',
            error
          );

          alert(
            error.message ||
            'Unable to add product to cart.'
          );

        } finally {

          if (submitButton) {

            submitButton.disabled = false;
            submitButton.classList.remove('loading');

          }

        }

      });

    });

  }


  /*
   * Initial load
   */
  if (document.readyState === 'loading') {

    document.addEventListener(
      'DOMContentLoaded',
      initRelatedProductATC
    );

  } else {

    initRelatedProductATC();

  }


  /*
   * Related products are loaded dynamically by
   * <product-recommendations>
   */
  document.addEventListener(
    'shopify:section:load',
    initRelatedProductATC
  );

  window.addEventListener(
    'load',
    initRelatedProductATC
  );

})();
</script>

