  .rd-invoice-search input{
    width:100%;
    height:46px;
    padding:0 16px 0 42px;
    border:1px solid #dedfdf;
    border-radius:10px;
    background:#fff;
    outline:none;
    font-family:inherit;
    font-size:14px;
    box-sizing:border-box;
  }

  .rd-invoice-search input:focus{
    border-color:#0d4f4f;
    box-shadow:0 0 0 3px rgba(13,79,79,.08);
  }

  .rd-invoice-filter{
    height:46px;
    padding:0 14px;
    border:1px solid #dedfdf;
    border-radius:10px;
    background:#fff;
    color:#263238;
    font-family:inherit;
    font-size:13px;
    outline:none;
    cursor:pointer;
  }


  /* =====================================================
     INVOICE TABLE
  ===================================================== */

  .rd-invoice-table-card{
    background:#fff;
    border:1px solid #e5e5e0;
    border-radius:14px;
    overflow:hidden;
  }

  .rd-invoice-table-scroll{
    overflow-x:auto;
    -webkit-overflow-scrolling:touch;
  }

  table.rd-invoice-table{
    width:100%;
    border-collapse:collapse;
    min-width:900px;
    font-size:13px;
  }

  .rd-invoice-table th{
    background:#faf9f7;
    padding:13px 14px;
    text-align:left;
    color:#6b7280;
    font-size:11px;
    font-weight:700;
    text-transform:uppercase;
    letter-spacing:.04em;
    border-bottom:1px solid #e5e5e0;
    white-space:nowrap;
  }

  .rd-invoice-table td{
    padding:15px 14px;
    border-bottom:1px solid #eeeeeb;
    color:#263238;
    vertical-align:middle;
    white-space:nowrap;
  }

  .rd-invoice-table tbody tr:last-child td{
    border-bottom:none;
  }

  .rd-invoice-table tbody tr:hover{
    background:#fcfcfb;
  }

  .rd-invoice-number{
    font-weight:700;
    color:#0d4f4f;
  }

  .rd-invoice-order{
    font-size:12px;
    color:#6b7280;
    margin-top:3px;
  }

  .rd-invoice-total{
    font-weight:700;
    color:#111827;
  }


  /* =====================================================
     STATUS
  ===================================================== */

  .rd-invoice-badge{
    display:inline-flex;
    align-items:center;
    gap:6px;
    padding:5px 9px;
    border-radius:999px;
    font-size:11px;
    font-weight:700;
  }

  .rd-invoice-badge.paid{
    background:#dcf5e6;
    color:#1a7a3f;
  }

  .rd-invoice-badge.pending{
    background:#fff2d8;
    color:#9a6a12;
  }

  .rd-invoice-badge.failed{
    background:#fde8e8;
    color:#b3261e;
  }

  .rd-invoice-badge.processing{
    background:#e8edf7;
    color:#42526e;
  }


  /* =====================================================
     ACTION BUTTONS
  ===================================================== */

  .rd-invoice-actions{
    display:flex;
    gap:6px;
  }

  .rd-invoice-action{
    width:34px;
    height:34px;
    display:inline-flex;
    align-items:center;
    justify-content:center;
    border:1px solid #dedfdf;
    border-radius:8px;
    background:#fff;
    color:#344054;
    cursor:pointer;
    transition:.2s ease;
  }

  .rd-invoice-action:hover{
    border-color:#0d4f4f;
    color:#0d4f4f;
    background:#e8f3f1;
  }

  .rd-invoice-action.send{
    width:auto;
    padding:0 11px;
    gap:6px;
    font-size:11px;
    font-weight:700;
  }


  /* =====================================================
     EMPTY
  ===================================================== */

  .rd-invoice-empty{
    text-align:center;
    padding:70px 20px;
  }

  .rd-invoice-empty-icon{
    width:58px;
    height:58px;
    margin:0 auto 14px;
    border-radius:16px;
    display:flex;
    align-items:center;
    justify-content:center;
    background:#e8f3f1;
    color:#0d4f4f;
  }

  .rd-invoice-empty h3{
    margin:0 0 6px;
    font-size:18px;
  }

  .rd-invoice-pager{
    display:flex;
    align-items:center;
    justify-content:space-between;
    gap:12px;
    margin-top:14px;
    flex-wrap:wrap;
  }
  .rd-invoice-pager-info{
    font-size:13px;
    color:var(--muted);
  }
  .rd-invoice-pager-btns{
    display:flex;
    gap:8px;
  }
  .rd-invoice-pager-btn{
    border:1px solid var(--border);
    background:#fff;
    color:var(--teal);
    border-radius:8px;
    padding:8px 14px;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    font-family:inherit;
  }
  .rd-invoice-pager-btn:disabled{
    opacity:.45;
    cursor:not-allowed;
  }
  .rd-invoice-loading,
  .rd-invoice-error{
    padding:28px 16px;
    text-align:center;
    color:var(--muted);
    font-size:14px;
  }
  .rd-invoice-error{ color:#b3261e; }

  .rd-invoice-empty{
    padding:36px 16px;
    text-align:center;
  }
  .rd-invoice-empty h3{
    margin:0 0 6px;
    font-size:18px;
  }
  .rd-invoice-empty p{
    margin:0;
    color:#6b7280;
    font-size:13px;
  }
  .rd-invoice-refresh{
    margin-top:16px;
    border:1px solid var(--border);
    background:#fff;
    color:var(--teal);
    border-radius:8px;
    padding:10px 18px;
    font-size:13px;
    font-weight:600;
    cursor:pointer;
    font-family:inherit;
  }
  .rd-invoice-refresh:hover{
    background:var(--teal-light);
  }


  /* =====================================================
     INVOICE MODAL
  ===================================================== */

  .rd-invoice-modal{
    position:fixed;
    inset:0;
    z-index:9999;
    background:rgba(0,0,0,.48);
    display:none;
    align-items:center;
    justify-content:center;
    padding:20px;
  }

  .rd-invoice-modal.active{
    display:flex;
  }

  .rd-invoice-modal-box{
    width:min(100%,1100px);
    max-height:92vh;
    overflow:auto;
    background:#fff;
    border-radius:16px;
    box-shadow:0 30px 100px rgba(0,0,0,.25);
  }

  .rd-invoice-modal-top{
    position:sticky;
    top:0;
    z-index:2;
    display:flex;
    align-items:center;
    justify-content:space-between;
    padding:14px 18px;
    background:#fff;
    border-bottom:1px solid #eeeeeb;
  }

  .rd-invoice-modal-title{
    font-size:14px;
    font-weight:700;
  }

  .rd-invoice-modal-close{
    width:34px;
    height:34px;
    border:0;
    border-radius:8px;
    background:#f3f4f6;
    cursor:pointer;
    font-size:18px;
  }


  /* =====================================================
     ACTUAL INVOICE (ERP sample layout)
  ===================================================== */

  .rd-print-invoice{
    padding:18px;
    color:#111;
    background:#fff;
    font-family: Arial, Helvetica, sans-serif;
    font-size:11px;
    line-height:1.35;
    overflow-x:auto;
  }

  .rd-erp-doc-wrap{
    width:100%;
  }

  .rd-erp-page{
    border:1px solid #222;
    padding:10px;
    min-width:720px;
    background:#fff;
  }

  .rd-erp-page + .rd-erp-page{
    margin-top:18px;
  }

  .rd-erp-continued{
    margin-top:8px;
    font-style:italic;
    font-size:10px;
    color:#333;
  }

  .rd-erp-header{
    display:grid;
    grid-template-columns:110px 1fr 190px;
    gap:12px;
    align-items:start;
    margin-bottom:10px;
  }

  .rd-erp-logo{
    width:96px;
    height:auto;
    max-height:110px;
    object-fit:contain;
    display:block;
  }

  .rd-erp-logo-fallback{
    width:96px;
    min-height:70px;
    display:flex;
    align-items:center;
    justify-content:center;
    font-weight:800;
    font-size:18px;
    letter-spacing:.04em;
    color:#5b2d91;
    border:1px solid #ddd;
  }

  .rd-erp-company{
    text-align:center;
    padding-top:4px;
  }

  .rd-erp-company-name{
    font-size:18px;
    font-weight:700;
    letter-spacing:.18em;
    margin:0 0 6px;
  }

  .rd-erp-company-addr{
    display:inline-block;
    border:1px solid #bbb;
    background:#f3f3f3;
    padding:6px 10px;
    font-size:10px;
    line-height:1.45;
    min-width:220px;
    text-align:center;
  }

  .rd-erp-doc{
    text-align:right;
  }

  .rd-erp-doc-title{
    margin:0 0 6px;
    font-size:28px;
    font-weight:700;
    letter-spacing:-.02em;
  }

  .rd-erp-meta-box{
    border:1px solid #222;
    border-collapse:collapse;
    width:100%;
    font-size:10px;
  }

  .rd-erp-meta-box th,
  .rd-erp-meta-box td{
    border:1px solid #222;
    padding:3px 6px;
    text-align:left;
    vertical-align:top;
  }

  .rd-erp-meta-box th{
    background:#f0f0f0;
    font-weight:700;
    white-space:nowrap;
    width:42%;
  }

  .rd-erp-parties{
    width:100%;
    border-collapse:collapse;
    margin-bottom:8px;
    table-layout:fixed;
  }

  .rd-erp-parties > tbody > tr > td{
    width:50%;
    vertical-align:top;
    padding:0;
  }

  .rd-erp-parties > tbody > tr > td:first-child{
    padding-right:5px;
  }

  .rd-erp-parties > tbody > tr > td:last-child{
    padding-left:5px;
  }

  .rd-erp-party-label{
    font-size:11px;
    font-weight:700;
    margin-bottom:2px;
  }

  .rd-erp-party-box{
    border:1px solid #999;
    background:#e8e8e8;
    min-height:72px;
    padding:8px 10px;
    font-size:11px;
    line-height:1.45;
  }

  .rd-erp-strip{
    width:100%;
    border-collapse:collapse;
    margin-bottom:0;
    table-layout:fixed;
  }

  .rd-erp-strip th,
  .rd-erp-strip td{
    border:1px solid #222;
    padding:3px 4px;
    font-size:9px;
    text-align:left;
    vertical-align:top;
    word-break:break-word;
  }

  .rd-erp-strip th{
    background:#f0f0f0;
    font-weight:700;
  }

  .rd-erp-items{
    width:100%;
    border-collapse:collapse;
    margin-top:0;
    table-layout:fixed;
  }

  .rd-erp-items th,
  .rd-erp-items td{
    border:1px solid #222;
    padding:4px 5px;
    font-size:10px;
    vertical-align:top;
  }

  .rd-erp-items th{
    background:#f0f0f0;
    font-weight:700;
    text-align:center;
    line-height:1.2;
  }

  .rd-erp-items td.num{
    text-align:center;
    white-space:nowrap;
  }

  .rd-erp-items td.money{
    text-align:right;
    white-space:nowrap;
  }

  .rd-erp-items td.item{
    text-align:left;
    word-break:break-word;
  }

  .rd-erp-items col.c-qty{ width:6%; }
  .rd-erp-items col.c-item{ width:12%; }
  .rd-erp-items col.c-desc{ width:38%; }
  .rd-erp-items col.c-price{ width:11%; }
  .rd-erp-items col.c-uom{ width:7%; }
  .rd-erp-items col.c-ext{ width:12%; }

  .rd-erp-footer{
    width:100%;
    border-collapse:collapse;
    margin-top:10px;
    table-layout:fixed;
  }

  .rd-erp-footer > tbody > tr > td{
    vertical-align:top;
    padding:0 6px 0 0;
  }

  .rd-erp-footer > tbody > tr > td:last-child{
    padding-right:0;
    padding-left:6px;
  }

  .rd-erp-footer td.col-legal{ width:38%; }
  .rd-erp-footer td.col-tax{ width:32%; }
  .rd-erp-footer td.col-totals{ width:30%; }

  .rd-erp-legal{
    font-size:10px;
    line-height:1.45;
  }

  .rd-erp-legal .gst-row{
    margin-bottom:8px;
  }

  .rd-erp-legal .gst-row span{
    display:inline-block;
    border:1px solid #bbb;
    background:#f3f3f3;
    padding:2px 6px;
    min-width:90px;
  }

  .rd-erp-legal ul{
    margin:0;
    padding-left:16px;
  }

  .rd-erp-legal li{
    margin-bottom:4px;
  }

  .rd-erp-tax{
    font-size:10px;
  }

  .rd-erp-tax-title{
    font-weight:700;
    margin-bottom:4px;
  }

  .rd-erp-tax-table{
    width:100%;
    border-collapse:collapse;
  }

  .rd-erp-tax-table td{
    border:1px solid #bbb;
    padding:3px 6px;
  }

  .rd-erp-tax-table td:last-child{
    text-align:right;
    background:#f7f7f7;
    width:45%;
  }

  .rd-erp-totals{
    border-collapse:collapse;
    width:100%;
    font-size:10px;
  }

  .rd-erp-totals th,
  .rd-erp-totals td{
    border:1px solid #222;
    padding:4px 6px;
  }

  .rd-erp-totals th{
    text-align:left;
    font-weight:700;
    background:#fff;
  }

  .rd-erp-totals td{
    text-align:right;
    background:#f7f7f7;
    white-space:nowrap;
  }

  .rd-erp-totals tr.grand th,
  .rd-erp-totals tr.grand td{
    font-weight:800;
    background:#eee;
  }

  .rd-erp-parties,
  .rd-erp-footer{
    page-break-inside:avoid;
    break-inside:avoid;
  }

  .rd-erp-items thead{
    display:table-header-group;
  }

  .rd-erp-items tr{
    page-break-inside:avoid;
    break-inside:avoid;
  }


  /* =====================================================
     MODAL BUTTONS
  ===================================================== */

  .rd-invoice-modal-actions{
    display:flex;
    gap:8px;
  }

  .rd-invoice-modal-btn{
    height:36px;
    padding:0 13px;
    border-radius:8px;
    border:1px solid #d9dddd;
    background:#fff;
    cursor:pointer;
    font-size:12px;
    font-weight:700;
  }

  .rd-invoice-modal-btn.primary{
    background:#0d4f4f;
    color:#fff;
    border-color:#0d4f4f;
  }


  /* =====================================================
     ERP SEND STATUS
  ===================================================== */

  .rd-erp-status{
    margin:15px 40px 0;
    padding:11px 13px;
    border-radius:9px;
    display:none;
    font-size:12px;
    font-weight:600;
  }

  .rd-erp-status.show{
    display:block;
  }

  .rd-erp-status.success{
    background:#dcf5e6;
    color:#1a7a3f;
  }

  .rd-erp-status.error{
    background:#fde8e8;
    color:#b3261e;
  }

  .rd-erp-status.loading{
    background:#f3f4f6;
    color:#475467;
  }


  /* =====================================================
     RESPONSIVE
  ===================================================== */

  @media(max-width:991px){

    .rd-invoice-stats{
      grid-template-columns:repeat(2,1fr);
    }

    .rd-print-info{
      grid-template-columns:1fr 1fr;
    }

    .rd-print-bottom{
      grid-template-columns:1fr;
    }

  }


  @media(max-width:767px){

    .rd-invoice-hero{
      flex-direction:column;
    }

    .rd-invoice-hero h2{
      font-size:23px;
    }

    .rd-invoice-stats{
      grid-template-columns:1fr 1fr;
      gap:8px;
    }

    .rd-invoice-stat{
      padding:14px;
    }

    .rd-invoice-stat-value{
      font-size:19px;
    }

    .rd-invoice-toolbar{
      flex-direction:column;
      align-items:stretch;
    }

    .rd-invoice-filter{
      width:100%;
    }

    .rd-invoice-modal{
      padding:0;
      align-items:flex-end;
    }

    .rd-invoice-modal-box{
      max-height:96vh;
      border-radius:16px 16px 0 0;
    }

    .rd-print-invoice{
      padding:12px;
    }

    .rd-erp-header{
      grid-template-columns:1fr;
      text-align:center;
    }

    .rd-erp-logo,
    .rd-erp-logo-fallback{
      margin:0 auto;
    }

    .rd-erp-doc{
      text-align:left;
    }

    .rd-erp-parties > tbody > tr{
      display:block;
    }

    .rd-erp-parties > tbody > tr > td{
      display:block;
      width:100% !important;
      padding:0 0 8px !important;
    }

    .rd-erp-footer > tbody > tr{
      display:block;
    }

    .rd-erp-footer > tbody > tr > td{
      display:block;
      width:100% !important;
      padding:0 0 10px !important;
    }

    .rd-invoice-modal-top{
      flex-wrap:wrap;
      gap:10px;
    }

    .rd-invoice-modal-actions{
      width:100%;
    }

    .rd-invoice-modal-btn{
      flex:1;
    }

    .rd-erp-status{
      margin:15px 22px 0;
    }

  }


  /* =====================================================
     PRINT (same-window via hidden iframe — no pop-up)
  ===================================================== */

  #rdInvoicePrintFrame{
    position:fixed !important;
    right:0 !important;
    bottom:0 !important;
    width:0 !important;
    height:0 !important;
    border:0 !important;
    opacity:0 !important;
    pointer-events:none !important;
  }

  @media print{

    @page{
      size: letter portrait;
      margin: 0.35in;
    }

  }

</style>

