    'Jul': 'juil.',
    'Aug': 'août',
    'Sep': 'sept.',
    'Oct': 'oct.',
    'Nov': 'nov.',
    'Dec': 'déc.'
  };

  const RD_SUBSTRING_FR = [
    ["Here's your account summary for", 'Voici le résumé de votre compte pour'],
    ['orders total', 'commandes au total'],
    ['Click the button below to receive a password reset email at:', 'Cliquez sur le bouton ci-dessous pour recevoir un e-mail de réinitialisation du mot de passe à :'],
    ['Password reset email has been sent successfully.', 'L’e-mail de réinitialisation du mot de passe a été envoyé avec succès.'],
    ['Unable to send password reset email.', 'Impossible d’envoyer l’e-mail de réinitialisation du mot de passe.']
  ];

  function normalize(value) {
    return String(value || '')
      .replace(/\u00a0/g, ' ')
      .replace(/\s+/g, ' ')
      .trim();
  }

  function translateTextNode(node) {
    const original = node.nodeValue;
    if (!original || !/[A-Za-z]/.test(original)) return;

    const normalized = normalize(original);
    if (!normalized) return;

    if (Object.prototype.hasOwnProperty.call(RD_FR, normalized)) {
      const start = original.search(/\S/);
      const end = original.search(/\s*$/);
      const leading = start > 0 ? original.slice(0, start) : '';
      const trailing = end >= 0 ? original.slice(end) : '';
      node.nodeValue = leading + RD_FR[normalized] + trailing;
      return;
    }

    let updated = original;
    RD_SUBSTRING_FR.forEach(function (pair) {
      updated = updated.split(pair[0]).join(pair[1]);
    });

    Object.keys(RD_FR).forEach(function (key) {
      if (key.length < 3 || key.indexOf(' ') === -1) return;
      if (updated.indexOf(key) !== -1) {
        updated = updated.split(key).join(RD_FR[key]);
      }
    });

    if (updated !== original) node.nodeValue = updated;
  }

  function translateAttributes(root) {
    const elements = root.querySelectorAll ? root.querySelectorAll('input, textarea, select, button, a, iframe, [aria-label], [title], [placeholder]') : [];
    elements.forEach(function (el) {
      ['placeholder', 'title', 'aria-label'].forEach(function (attr) {
        if (!el.hasAttribute(attr)) return;
        const value = normalize(el.getAttribute(attr));
        if (Object.prototype.hasOwnProperty.call(RD_FR, value)) {
          el.setAttribute(attr, RD_FR[value]);
        }
      });
    });
  }

  function translateRoot(root) {
    if (!root) return;

    if (root.nodeType === Node.TEXT_NODE) {
      translateTextNode(root);
      return;
    }

    if (root.nodeType !== Node.ELEMENT_NODE) return;
    if (/^(SCRIPT|STYLE|NOSCRIPT|TEMPLATE)$/i.test(root.tagName)) return;

    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT, {
      acceptNode: function (node) {
        const parent = node.parentElement;
        if (!parent || /^(SCRIPT|STYLE|NOSCRIPT|TEMPLATE)$/i.test(parent.tagName)) {
          return NodeFilter.FILTER_REJECT;
        }
        return NodeFilter.FILTER_ACCEPT;
      }
    });

    const nodes = [];
    let current;
    while ((current = walker.nextNode())) nodes.push(current);
    nodes.forEach(translateTextNode);
    translateAttributes(root);
  }

  function translateMonthNames(root) {
    const months = {
      January: 'janvier', February: 'février', March: 'mars', April: 'avril',
      May: 'mai', June: 'juin', July: 'juillet', August: 'août',
      September: 'septembre', October: 'octobre', November: 'novembre', December: 'décembre'
    };

    const walker = document.createTreeWalker(root, NodeFilter.SHOW_TEXT);
    const nodes = [];
    let node;
    while ((node = walker.nextNode())) nodes.push(node);

    nodes.forEach(function (textNode) {
      if (!textNode.nodeValue) return;
      let value = textNode.nodeValue;
      Object.keys(months).forEach(function (month) {
        value = value.replace(new RegExp('\\b' + month + '\\b', 'g'), months[month]);
      });
      if (value !== textNode.nodeValue) textNode.nodeValue = value;
    });
  }

  function applyTranslations(root) {
    translateRoot(root || document.body);
    translateMonthNames(root || document.body);
  }

  applyTranslations(document.body);

  const observer = new MutationObserver(function (mutations) {
    mutations.forEach(function (mutation) {
      mutation.addedNodes.forEach(function (node) {
        if (node.nodeType === Node.TEXT_NODE) {
          translateTextNode(node);
        } else if (node.nodeType === Node.ELEMENT_NODE) {
          applyTranslations(node);
        }
      });
    });
  });

  observer.observe(document.body, {
    childList: true,
    subtree: true
  });

  // The spending chart uses browser locale for month names.
  // This keeps the existing chart/UI unchanged while making its month labels French.
  window.INKQUEST_RD_LOCALE = RD_IS_FRENCH ? 'fr-CA' : 'en-CA';
})();
</script>