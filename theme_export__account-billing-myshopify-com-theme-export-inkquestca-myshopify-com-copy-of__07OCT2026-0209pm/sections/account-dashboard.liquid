</div>

    <div class="rd-main">

      {% comment %} ================= OVERVIEW ================= {% endcomment %}
      <div class="rd-section active" id="rd-overview">

        {% assign rd_hour = 'now' | date: '%H' | plus: 0 %}
        <div class="rd-greet">
       <h2>
  <span id="greeting">Hello</span>, {{ customer.first_name }} {{ customer.last_name }}
</h2>

          <p>Here's your account summary for {{ 'now' | date: '%B %Y' }}</p>
        </div>

        {% assign rd_open_orders = 0 %}
        {% assign rd_mtd_spend = 0 %}
        {% assign rd_this_month = 'now' | date: '%Y-%m' %}
        {% for order in customer.orders %}
          {% unless order.fulfillment_status == 'fulfilled' %}
            {% assign rd_open_orders = rd_open_orders | plus: 1 %}
          {% endunless %}
          {% assign rd_order_month = order.created_at | date: '%Y-%m' %}
          {% if rd_order_month == rd_this_month %}
            {% assign rd_mtd_spend = rd_mtd_spend | plus: order.total_price %}
          {% endif %}
        {% endfor %}

        <div class="rd-stats">
          <div class="rd-stat">
            <div class="rd-label">Open Orders</div>
            <div class="rd-value">{{ rd_open_orders }}</div>
            <div class="rd-sub">Not yet fulfilled</div>
          </div>
          <div class="rd-stat">
            <div class="rd-label">MTD Spend</div>
            <div class="rd-value">{{ rd_mtd_spend | money }}</div>
            <div class="rd-sub">{{ 'now' | date: '%B' }} total</div>
          </div>
          <div class="rd-stat">
            <div class="rd-label">Lifetime Spend</div>
            <div class="rd-value">{{ customer.total_spent | money }}</div>
            <div class="rd-sub">{{ customer.orders_count }} orders total</div>
          </div>
          <div class="rd-stat">
            <div class="rd-label">Outstanding Balance</div>
            <div class="rd-value" id="rdOverviewOutstanding">—</div>
            <div class="rd-sub">From invoices</div>
          </div>
        </div>

        <div class="rd-card-title">
          <h3>Recent Orders</h3>
          <a class="rd-nav-btn" data-target="rd-orders">View all</a>
        </div>
        <div class="rd-table-scroll">
        <table class="rd-table">
          <thead><tr
data-search="
{{ order.name }}
{{ order.shipping_address.name }}
{{ order.shipping_address.company }}
"><th>Order</th><th>Date</th> <th>PO Number</th><th>Ship To Name</th><th>Total</th><th>Status</th></tr></thead>
          <tbody>
            {% for order in customer.orders limit: 3 %}
            <tr>
              <td>{{ order.name }}</td>
              <td>{{ order.created_at | date: '%b %d' }}</td>
              <td>
  {% if order.note != blank %}
    {{ order.note }}
  {% else %}
    -
  {% endif %}
</td>
              <td>
  {{ order.shipping_address.name }}

  {% if order.shipping_address.company != blank %}
    <br>
    <small>{{ order.shipping_address.company }}</small>
  {% endif %}
</td>
              <td>{{ order.total_price | money }}</td>
              <td>
                {% if order.fulfillment_status == 'fulfilled' %}
                  <span class="rd-badge fulfilled">Shipped</span>
                {% elsif order.fulfillment_status == 'partial' %}
                  <span class="rd-badge partial">Partial</span>
                {% else %}
                  <span class="rd-badge unfulfilled">Processing</span>
                {% endif %}
              </td>
            </tr>
            {% else %}
            <tr><td colspan="4">There are no orders right now.</td></tr>
            {% endfor %}
          </tbody>
        </table>
        </div>
      </div>

      {% comment %} ================= ORDERS ================= {% endcomment %}
      <div class="rd-section" id="rd-orders">
        <div>
        <h2>All Orders</h2>
        <div class="rd-order-search">
  <input
    type="text"
    id="rdOrderSearch"
    placeholder="Search by Order # or Ship To Name..."
  >
</div>
</div>
        <div class="rd-table-scroll">
        <table class="rd-table">
          <thead><tr><th>Order</th><th>Date</th> <th>PO Number</th><th>Ship To Name</th><th>Items</th><th>Total</th><th>Status</th><th></th></tr></thead>
          <tbody>
           {% for order in customer.orders %}
<tr
  data-search="{{ order.name }} {{ order.note }} {{ order.shipping_address.name }} {{ order.shipping_address.company }} {{ order.total_price | money }} {{ order.line_items.size }}">
              <td>{{ order.name }}</td>
              <td>{{ order.created_at | date: '%b %d, %Y' }}</td>
              <td>
  {% if order.note != blank %}
    {{ order.note }}
  {% else %}
    -
  {% endif %}
</td>
            <td>
  {{ order.shipping_address.name }}

  {% if order.shipping_address.company != blank %}
    <br>
    <small>{{ order.shipping_address.company }}</small>
  {% endif %}
</td>
              <td>{{ order.line_items.size }}</td>
              <td>{{ order.total_price | money }}</td>
              <td>
                {% if order.fulfillment_status == 'fulfilled' %}
                  <span class="rd-badge fulfilled">Shipped</span>
                {% elsif order.fulfillment_status == 'partial' %}
                  <span class="rd-badge partial">Partial</span>
                {% else %}
                  <span class="rd-badge unfulfilled">Processing</span>
                {% endif %}
              </td>
              <td><a href="{{ order.customer_url }}">View</a></td>
            </tr>
            {% else %}
            <tr><td colspan="6">There are no orders right now.</td></tr>
            {% endfor %}
          </tbody>
        </table>
        </div>
      </div>


            {% comment %} ================= NEW ARRIVALS ================= {% endcomment %}

            {% assign new_arrivals = collections['new-arrivals'] %}

<div class="rd-section" id="rd-new-arrivals">

  <div class="rd-card-title">
    <h3>New Arrivals</h3>
  </div>

  <div class="rd-new-grid">

    {% for product in new_arrivals.products limit:8 %}

    <div class="rd-product-card">

 <a href="{{ product.url }}">
  {% if product.featured_image %}
    <img
      src="{{ product.featured_image | image_url: width:600 }}"
      alt="{{ product.title | escape }}"
      loading="lazy"
    >
  {% else %}
    <img
      src="https://cdn.shopify.com/s/files/1/0981/0844/0757/files/Ink_Quest.png?v=1786686761"
      alt="{{ product.title | escape }}"
      loading="lazy"
    >
  {% endif %}
</a>

      <h4>{{ product.title }}</h4>

      <div class="rd-price">
        {{ product.price | money }}
      </div>

      <form method="post" action="/cart/add">
        <input type="hidden"
               name="id"
               value="{{ product.selected_or_first_available_variant.id }}">

        <button>Add to Cart</button>
      </form>

    </div>

    {% endfor %}

  </div>

</div>
            {% comment %} ================= NEW ARRIVALS ================= {% endcomment %}

      {% comment %} ================= WISHLIST ================= {% endcomment %}
      <div class="rd-section" id="rd-wishlist">
        <div class="rd-card-title">
          <h3>My Wishlist</h3>
        </div>
        {% comment %} <p style="font-size:13px;color:var(--muted);margin-bottom:10px;">
          Yeh aapke "Wishlist by Square" app ka live page hai (inline embedded) — data seedha wahi se aa raha hai.
        </p> {% endcomment %}
        <iframe class="rd-wishlist-frame" src="{{ wishlist_url }}" title="Wishlist" loading="lazy"></iframe>
      </div>

      {% comment %} ================= TOTAL SPENDING ================= {% endcomment %}
      <div class="rd-section" id="rd-spending">
        <h2>Total Spending</h2>

        {% assign rd_avg_order = 0 %}
        {% if customer.orders_count > 0 %}
          {% assign rd_avg_order = customer.total_spent | divided_by: customer.orders_count %}
        {% endif %}

        <div class="rd-stats">
          <div class="rd-stat">
            <div class="rd-label">Lifetime Spend</div>
            <div class="rd-value">{{ customer.total_spent | money }}</div>
            <div class="rd-sub">All-time</div>
          </div>
          <div class="rd-stat">
            <div class="rd-label">Total Orders</div>
            <div class="rd-value">{{ customer.orders_count }}</div>
            <div class="rd-sub">Lifetime</div>
          </div>
          <div class="rd-stat">
            <div class="rd-label">Avg Order Value</div>
            <div class="rd-value">{{ rd_avg_order | money }}</div>
            <div class="rd-sub">Per order</div>
          </div>
        </div>

        <div class="rd-card-title"><h3>Order History (last 6 months)</h3></div>
        <div id="rd-chart" class="rd-chart"></div>
      </div>

<div class="rd-section" id="rd-invoices">

  <div class="rd-invoice-wrap">

    <div class="rd-invoice-hero">
      <div>
        <h2>Invoices</h2>
        <p>View and download invoices for your account.</p>
      </div>
    </div>

    {% if customer %}
      <script>
        window.RD_INVOICES = {
          proxyBase: '/apps/account-billing/customer/invoices',
          loggedIn: true,
          pageSize: 20,
          customerId: {{ customer.id | json }},
          customerEmail: {{ customer.email | json }},
          logoUrl: {{ 'inkquest-invoice-logo.svg' | asset_url | json }}
        };
        console.log('[RD Invoices] customer logged in', {
          customerId: window.RD_INVOICES.customerId,
          customerEmail: window.RD_INVOICES.customerEmail,
          proxyBase: window.RD_INVOICES.proxyBase
        });
      </script>

      <div class="rd-invoice-stats" id="rdInvoiceStats">
        <div class="rd-invoice-stat">
          <div class="rd-invoice-stat-top">
            <div class="rd-invoice-stat-label">Outstanding balance</div>
          </div>
          <div class="rd-invoice-stat-value" id="rdInvoiceOutstanding">Loading…</div>
          <div class="rd-invoice-stat-sub">Across your account</div>
        </div>
        <div class="rd-invoice-stat">
          <div class="rd-invoice-stat-top">
            <div class="rd-invoice-stat-label">Invoices</div>
          </div>
          <div class="rd-invoice-stat-value" id="rdInvoiceCount">Loading…</div>
          <div class="rd-invoice-stat-sub">On file</div>
        </div>
      </div>

      <div class="rd-invoice-toolbar">
