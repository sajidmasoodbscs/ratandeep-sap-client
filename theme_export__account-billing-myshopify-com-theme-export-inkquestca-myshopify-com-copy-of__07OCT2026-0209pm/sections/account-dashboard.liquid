<div class="rd-section" id="rd-reorder">

  <div class="rd-reorder-head">
    <div>
      <h2>Quick Re-Order</h2>
      <p>Quickly reorder products from your previous purchases.</p>
    </div>
  </div>

  {% assign shown_products = '' %}
  {% assign reorder_count = 0 %}

  <div class="rd-reorder-list">

    <!-- SELECT ALL -->
    <div class="rd-reorder-select-all">
      <label class="rd-check-label">
        <input
          type="checkbox"
          id="rdReorderSelectAll"
          class="rd-reorder-checkbox"
        >
        <span class="rd-custom-check"></span>
        <span>Select all</span>
      </label>
    </div>


    {% for order in customer.orders %}

      {% for item in order.line_items %}

        {% if item.product %}

          {% assign reorder_key = '|' | append: item.product.id | append: '-' | append: item.variant.id | append: '|' %}

          {% unless shown_products contains reorder_key %}

            {% assign shown_products = shown_products | append: reorder_key %}
            {% assign reorder_count = reorder_count | plus: 1 %}

            {% assign reorder_variant = item.variant %}

            <div
              class="rd-reorder-item"
              data-reorder-item
              data-product-id="{{ item.product.id }}"
              data-variant-id="{{ reorder_variant.id }}"
            >

              <!-- CHECKBOX -->
              <div class="rd-reorder-check">

                <label class="rd-check-label">

                  <input
                    type="checkbox"
                    class="rd-reorder-checkbox rd-item-checkbox"
                  >

                  <span class="rd-custom-check"></span>

                </label>

              </div>


              <!-- IMAGE -->
              <div class="rd-reorder-image">

                <a href="{{ item.product.url }}">

                  {% if item.image %}

                    <img
                      src="{{ item.image | image_url: width: 300 }}"
                      alt="{{ item.title | escape }}"
                      loading="lazy"
                    >

                  {% elsif item.product.featured_image %}

                    <img
                      src="{{ item.product.featured_image | image_url: width: 300 }}"
                      alt="{{ item.product.title | escape }}"
                      loading="lazy"
                    >

                 {% else %}
  <img
    src="https://cdn.shopify.com/s/files/1/0981/0844/0757/files/Ink_Quest.png?v=1786686761"
    alt="{{ item.product.title | escape }}"
    loading="lazy"
  >
{% endif %}

                </a>

              </div>


              <!-- PRODUCT INFORMATION -->
              <div class="rd-reorder-info">

                <a
                  href="{{ item.product.url }}"
                  class="rd-reorder-title"
                >
                  {{ item.product.title }}
                </a>


                {% unless item.variant.title == 'Default Title' %}

                  <div class="rd-reorder-variant">
                    {{ item.variant.title }}
                  </div>

                {% endunless %}


                {% if item.sku != blank %}

                  <div class="rd-reorder-sku">
                    SKU: {{ item.sku }}
                  </div>

                {% endif %}


                <div class="rd-reorder-price mobile-price">

                  {{ item.final_price | money }}

                </div>

              </div>


              <!-- PRICE -->
              <div class="rd-reorder-price desktop-price">

                {{ item.final_price | money }}

              </div>


              <!-- QUANTITY -->
              <div class="rd-reorder-qty">

                <button
                  type="button"
                  class="rd-qty-btn rd-qty-minus"
                  aria-label="Decrease quantity"
                >
                  −
                </button>

                <input
                  type="number"
                  class="rd-qty-input"
                  value="1"
                  min="1"
                  max="99"
                  aria-label="Quantity"
                >

                <button
                  type="button"
                  class="rd-qty-btn rd-qty-plus"
                  aria-label="Increase quantity"
                >
                  +
                </button>

              </div>


              <!-- ADD TO CART -->
              <div class="rd-reorder-action">

                <form
                  method="post"
                  action="/cart/add"
