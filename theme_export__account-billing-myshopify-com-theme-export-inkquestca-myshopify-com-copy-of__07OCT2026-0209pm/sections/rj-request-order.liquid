<style>
  :root {
    --so-teal-dark: #00404C;
    --so-teal: #00404C;
    --so-green: #00d68f;
    --so-green-dark: #00a873;
    --so-navy: #1a2c5b;
    --so-white: #ffffff;
    --so-ivory: #f6f8f7;
    --so-line: #dde4e2;
    --so-text: #1c2b2c;
    --so-text-soft: #5a6b6c;
  }

  .so-wrapper *,
  .so-wrapper *::before,
  .so-wrapper *::after {
    box-sizing: border-box;
    margin: 0;
    padding: 0;
  }

  .so-wrapper {
    color: var(--so-text);
    background-color: var(--so-white);
    width: 100%;
    overflow-x: hidden;
  }

  .so-wrapper h1,
  .so-wrapper h2,
  .so-wrapper h3 {
    font-weight: 700;
    color: #00404c;
    line-height: 1.2;
  }

  .so-wrapper a {
    color: inherit;
    text-decoration: none;
  }

  .so-wrap {
    max-width: 100%;
    width: 85%;
    margin: 0 auto;
    padding: 0 16px;
  }

  /* =========================
     HERO
  ========================= */

  .so-hero {
    background: linear-gradient(
      160deg,
      var(--so-teal-dark) 0%,
      var(--so-teal) 100%
    );
    color: var(--so-white);
    padding: 48px 0 56px;
    position: relative;
    overflow: hidden;
  }

  .so-hero::after {
    content: "";
    position: absolute;
    right: -80px;
    top: -80px;
    width: 340px;
    height: 340px;
    border: 1px solid rgba(255,255,255,.12);
    border-radius: 50%;
    pointer-events: none;
  }

  .so-hero::before {
    content: "";
    position: absolute;
    right: 20px;
    top: 60px;
    width: 220px;
    height: 220px;
    border: 1px solid rgba(255,255,255,.10);
    border-radius: 50%;
    pointer-events: none;
  }

  .so-eyebrow {
    display: inline-block;
    background: rgba(0,214,143,.16);
    color: var(--so-green);
    font-size: 12px;
    font-weight: 700;
    letter-spacing: 1.2px;
    text-transform: uppercase;
    padding: 6px 12px;
    border-radius: 3px;
    margin-bottom: 18px;
  }

  .so-hero h1 {
    color: var(--so-white);
    font-size: clamp(26px,4vw,40px);
    max-width: 640px;
    margin-bottom: 16px;
  }

  .so-hero p {
    color: #d7e6e6;
    font-size: 15px;
    line-height: 1.5;
    max-width: 560px;
  }

  .so-hero-stats {
    display: flex;
    gap: 32px;
    margin-top: 32px;
    flex-wrap: wrap;
  }

  .so-hero-stat .so-num {
    font-size: 26px;
    color: var(--so-green);
    font-weight: 700;
  }

  .so-hero-stat .so-label {
    font-size: 12px;
    color: #b9d0d0;
    letter-spacing: .3px;
    line-height: 1.3;
  }

  /* =========================
     LOOKUP
  ========================= */

  .so-lookup {
    background: var(--so-white);
    margin-top: -28px;
    position: relative;
    z-index: 2;
    border-radius: 8px;
    box-shadow: 0 8px 28px rgba(13,79,92,.14);
    padding: 20px 24px;
    display: flex;
    gap: 12px;
    align-items: center;
    flex-wrap: wrap;
  }

  .so-lookup label {
    font-size: 12px;
    font-weight: 700;
    color: var(--so-teal-dark);
    letter-spacing: .5px;
    text-transform: uppercase;
    width: 100%;
    margin-bottom: 2px;
  }

  .so-lookup input {
    flex: 1 1 200px;
    width: 100%;
    border: 1.5px solid var(--so-line);
    border-radius: 5px;
    padding: 12px 14px;
    font-size: 14px;
  }

  .so-lookup input:focus {
    outline: none;
    border-color: var(--so-teal);
  }

  .so-lookup button {
    background: var(--so-navy);
    color: var(--so-white);
    border: none;
    border-radius: 5px;
    padding: 12px 22px;
    font-size: 14px;
    font-weight: 700;
    cursor: pointer;
    transition: background .15s;
    width: auto;
  }

  .so-lookup button:hover {
    background: var(--so-teal-dark);
  }

  /* =========================
     MAIN
  ========================= */

  .so-main {
    padding: 48px 0 64px;
  }

  .so-grid {
    display: grid;
    grid-template-columns: 1.5fr 1fr;
    gap: 40px;
    align-items: start;
  }

  .so-section-label {
    font-size: 12px;
    font-weight: 700;
    color: var(--so-green-dark);
    letter-spacing: 1.2px;
    text-transform: uppercase;
    margin-bottom: 10px;
  }

  .so-grid h2 {
    font-size: clamp(22px,3vw,28px);
    margin-bottom: 8px;
  }

  .so-grid > div > p.so-lead {
    color: var(--so-text-soft);
    font-size: 15px;
    line-height: 1.5;
    margin-bottom: 28px;
    max-width: 520px;
  }

  /* =========================
     FORM
  ========================= */

  .so-form {
    background: var(--so-white);
    border: 1px solid var(--so-line);
    border-radius: 8px;
    padding: 28px;
  }

  .so-form-row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 16px;
    margin-bottom: 16px;
  }

  .so-field {
    display: flex;
    flex-direction: column;
    gap: 6px;
  }

  .so-field.so-full {
    grid-column: 1 / -1;
  }

  .so-field label {
    font-size: 12.5px;
    font-weight: 700;
    color: var(--so-navy);
  }

  .so-field .so-opt {
    color: var(--so-text-soft);
    font-weight: 400;
  }

  .so-field input,
  .so-field select,
  .so-field textarea {
    width: 100%;
    border: 1.5px solid var(--so-line);
    border-radius: 5px;
    padding: 11px 12px;
    font-size: 14px;
    color: var(--so-text);
    background: var(--so-white);
  }

  .so-field input:focus,
  .so-field select:focus,
  .so-field textarea:focus {
    outline: none;
    border-color: var(--so-teal);
  }

  .so-field textarea {
    resize: vertical;
    min-height: 88px;
  }

  /* =========================
     URGENCY
  ========================= */

  .so-urgency {
    display: flex;
    gap: 10px;
    flex-wrap: wrap;
  }

  .so-urgency label {
    flex: 1 1 100px;
    border: 1.5px solid var(--so-line);
    border-radius: 5px;
    padding: 10px 12px;
    text-align: center;
    font-size: 13px;
    font-weight: 700;
    color: var(--so-text-soft);
    cursor: pointer;
    transition: all .15s;
  }

  .so-urgency input {
    display: none;
  }

  .so-urgency input:checked + span {
    color: var(--so-white);
  }

  .so-urgency label:has(input:checked) {
    background: var(--so-teal-dark);
    border-color: var(--so-teal-dark);
  }

  /* =========================
     SUBMIT
  ========================= */

  .so-submit-row {
    display: flex;
    align-items: center;
    justify-content: space-between;
    margin-top: 8px;
    flex-wrap: wrap;
    gap: 16px;
  }

  .so-submit-row p {
    font-size: 12.5px;
    color: var(--so-text-soft);
    max-width: 280px;
    line-height: 1.4;
  }

  .so-form button[type="submit"] {
    background: var(--so-green);
    color: var(--so-navy);
    border: none;
    border-radius: 5px;
    padding: 14px 30px;
    font-size: 14.5px;
    font-weight: 700;
    cursor: pointer;
    transition: background .15s;
  }

  .so-form button[type="submit"]:hover {
    background: var(--so-green-dark);
    color: var(--so-white);
  }

  /* =========================
     SIDEBAR
  ========================= */

  .so-side-card {
    background: #00404c;
    color: var(--so-white);
    border-radius: 8px;
    padding: 24px;
    margin-bottom: 20px;
  }

  .so-side-card h3 {
    color: var(--so-white);
    font-size: 18px;
    margin-bottom: 16px;
  }

  .so-steps {
    list-style: none;
  }

  .so-steps li {
    display: flex;
    gap: 14px;
    padding: 12px 0;
    border-top: 1px solid rgba(255,255,255,.12);
  }

  .so-steps li:first-child {
    border-top: none;
  }

  .so-step-num {
    color: var(--so-green);
    font-weight: 700;
    font-size: 15px;
    width: 22px;
    flex-shrink: 0;
  }

  .so-steps p {
    font-size: 13.5px;
    color: #d7dfec;
    line-height: 1.4;
  }

  .so-steps p b {
    color: var(--so-white);
    display: block;
    font-size: 14px;
    margin-bottom: 2px;
  }

  /* =========================
     INFO
  ========================= */

  .so-info-card {
    background: var(--so-white);
    border: 1px solid var(--so-line);
    border-radius: 8px;
    padding: 24px;
    margin-bottom: 20px;
  }

  .so-info-card h3 {
    font-size: 16px;
    margin-bottom: 14px;
  }

  .so-lead-row {
    display: flex;
    justify-content: space-between;
    gap: 12px;
    padding: 9px 0;
    border-top: 1px solid var(--so-line);
    font-size: 13.5px;
  }

  .so-lead-row:first-of-type {
    border-top: none;
  }

  .so-lead-row span:first-child {
    color: var(--so-text-soft);
  }

  .so-lead-row span:last-child {
    font-weight: 700;
    color: var(--so-teal-dark);
    text-align: right;
  }

  /* =========================
     CONTACT
  ========================= */

  .so-contact-card {
    border: 1.5px dashed var(--so-teal);
    border-radius: 8px;
    padding: 20px 22px;
    background: rgba(13,110,122,.05);
  }

  .so-contact-card h3 {
    font-size: 15px;
    margin-bottom: 8px;
    color: var(--so-teal-dark);
  }

  .so-contact-card p {
    font-size: 13px;
    color: var(--so-text-soft);
    margin-bottom: 12px;
    line-height: 1.4;
  }

  .so-contact-card a.so-mail {
    display: block;
    font-size: 13.5px;
    font-weight: 700;
    color: var(--so-navy);
    padding: 6px 0;
    word-break: break-word;
  }

  /* =========================
     RESPONSIVE
  ========================= */

  @media (max-width: 992px) {
    .so-grid {
      grid-template-columns: 1fr;
      gap: 32px;
    }

    .so-wrap {
      width: 90%;
    }
  }

  @media (max-width: 600px) {

    .so-wrap {
      width: 100%;
      padding: 0 16px;
    }

    .so-hero {
      padding: 36px 0 44px;
    }

    .so-hero-stats {
      gap: 20px;
    }

    .so-hero-stat {
      flex: 1 1 100%;
    }

    .so-lookup {
      padding: 16px;
      margin-top: -20px;
    }

    .so-lookup button {
      width: 100%;
    }

    .so-form {
      padding: 20px 16px;
    }

    .so-form-row {
      grid-template-columns: 1fr;
      gap: 14px;
    }

    .so-urgency {
      flex-direction: column;
    }

    .so-urgency label {
      width: 100%;
    }

    .so-submit-row {
      flex-direction: column;
      align-items: stretch;
    }

    .so-submit-row p {
      max-width: 100%;
    }

    .so-form button[type="submit"] {
      width: 100%;
    }
  }
</style>


<div class="so-wrapper">

  <!-- =========================
       HERO
  ========================= -->

  <section class="so-hero">
    <div class="so-wrap">

      {% if section.settings.hero_eyebrow != blank %}
        <span class="so-eyebrow">
          {{ section.settings.hero_eyebrow }}
        </span>
      {% endif %}

      {% if section.settings.hero_title != blank %}
        <h1>{{ section.settings.hero_title }}</h1>
      {% endif %}

      {% if section.settings.hero_description != blank %}
        <p>{{ section.settings.hero_description }}</p>
      {% endif %}

      {% if section.blocks.size > 0 %}
        <div class="so-hero-stats">

          {% for block in section.blocks %}
            {% if block.type == 'hero_stat' %}

              <div class="so-hero-stat" {{ block.shopify_attributes }}>

                {% if block.settings.number != blank %}
                  <div class="so-num">
                    {{ block.settings.number }}
                  </div>
                {% endif %}

                {% if block.settings.label != blank %}
                  <div class="so-label">
                    {{ block.settings.label | newline_to_br }}
                  </div>
                {% endif %}

              </div>

            {% endif %}
          {% endfor %}

        </div>
      {% endif %}

    </div>
  </section>


  <!-- =========================
       LOOKUP
  ========================= -->

  {% if section.settings.show_lookup %}

    <div class="so-wrap">

      {% comment %} <div class="so-lookup">

        {% if section.settings.lookup_label != blank %}
          <label>
            {{ section.settings.lookup_label }}
          </label>
        {% endif %}

        <input
          type="text"
          name="stock_lookup"
          placeholder="{{ section.settings.lookup_placeholder }}"
        >

        <button type="button">
          {{ section.settings.lookup_button }}
        </button>

      </div> {% endcomment %}

    </div>

  {% endif %}


  <!-- =========================
       MAIN CONTENT
  ========================= -->

  <main class="so-main">

    <div class="so-wrap so-grid">

      <!-- LEFT -->

      <div>

        {% if section.settings.form_label != blank %}
          <div class="so-section-label">
            {{ section.settings.form_label }}
          </div>
        {% endif %}

        {% if section.settings.form_title != blank %}
          <h2>
            {{ section.settings.form_title }}
          </h2>
        {% endif %}

        {% if section.settings.form_description != blank %}
          <p class="so-lead">
            {{ section.settings.form_description }}
          </p>
        {% endif %}


        {% form 'contact', id: 'so-request-order-form', class: 'so-form' %}

          {% if form.posted_successfully? %}
            <div class="so-form-success" role="status" style="margin-bottom:16px;padding:12px 14px;border:1px solid #00a873;border-radius:5px;background:#eefbf6;color:#006b50;font-size:13px;">
              Request submitted successfully. Our team will review your request and contact you shortly.
            </div>
          {% endif %}

          {% if form.errors %}
            <div class="so-form-error" role="alert" style="margin-bottom:16px;padding:12px 14px;border:1px solid #d94a4a;border-radius:5px;background:#fff5f5;color:#9d2222;font-size:13px;">
              {{ form.errors | default_errors }}
            </div>
          {% endif %}

          <input type="hidden" name="contact[request_type]" value="Special Order Request">
          <input type="hidden" name="contact[page]" value="{{ page_title | escape }}">

          <!-- Company / Account -->

          <div class="so-form-row">

            <div class="so-field">

              <label>
                {{ section.settings.company_label }}
              </label>

              <input
                type="text"
                name="contact[company_name]"
                placeholder="{{ section.settings.company_placeholder }}"
              >

            </div>


            <div class="so-field">

              <label>
                {{ section.settings.account_label }}

                {% if section.settings.account_optional %}
                  <span class="so-opt">(if known)</span>
                {% endif %}

              </label>

              <input
                type="text"
                name="contact[account_number]"
                placeholder="{{ section.settings.account_placeholder }}"
              >

            </div>

          </div>


          <!-- Contact -->

          <div class="so-form-row">

            <div class="so-field">

              <label>
                {{ section.settings.contact_label }}
              </label>

              <input
                type="text"
                name="contact[contact_name]"
                placeholder="{{ section.settings.contact_placeholder }}"
              >

            </div>


            <div class="so-field">

              <label>
                {{ section.settings.email_label }}
              </label>

              <input
                type="email"
                name="contact[email]"
                placeholder="{{ section.settings.email_placeholder }}"
                required
              >

            </div>

          </div>


          <!-- Phone / Warehouse -->

          <div class="so-form-row">

            <div class="so-field">

              <label>
                {{ section.settings.phone_label }}
              </label>

              <input
                type="tel"
                name="contact[phone]"
                placeholder="{{ section.settings.phone_placeholder }}"
              >

            </div>


            <div class="so-field">

              <label>
                {{ section.settings.warehouse_label }}
              </label>

              <select
                name="contact[preferred_warehouse]"
                {% if section.settings.warehouse_required %}
                  required
                {% endif %}
              >

                <option value="" disabled selected>
                  {{ section.settings.warehouse_placeholder }}
                </option>

                {% assign warehouse_count = 0 %}

                {% for block in section.blocks %}

                  {% if block.type == 'warehouse' %}

                    {% assign warehouse_count = warehouse_count | plus: 1 %}

                    <option
                      value="{{ block.settings.value }}"
                      {{ block.shopify_attributes }}
                    >
                      {{ block.settings.name }}
                    </option>

                  {% endif %}

                {% endfor %}

              </select>

            </div>

          </div>


          <!-- Item -->

          <div
            class="so-field so-full"
            style="margin-bottom:16px;"
          >

            <label>
              {{ section.settings.item_label }}
            </label>

            <input
              type="text"
              name="contact[item]"
              placeholder="{{ section.settings.item_placeholder }}"
              {% if section.settings.item_required %}
                required
              {% endif %}
            >

          </div>


          <!-- Quantity / Date -->

          <div class="so-form-row">

            <div class="so-field">

              <label>
                {{ section.settings.quantity_label }}
              </label>

              <input
                type="number"
                name="contact[quantity]"
                min="1"
                placeholder="{{ section.settings.quantity_placeholder }}"
                {% if section.settings.quantity_required %}
                  required
                {% endif %}
              >

            </div>


            <div class="so-field">

              <label>
                {{ section.settings.date_label }}
              </label>

              <input
                type="date"
                name="contact[needed_by]"
              >

            </div>

          </div>


          <!-- Urgency -->

          <div
            class="so-field so-full"
            style="margin-bottom:16px;"
          >

            <label>
              {{ section.settings.urgency_label }}
            </label>

            <div class="so-urgency">

              {% for block in section.blocks %}

                {% if block.type == 'urgency' %}

                  <label {{ block.shopify_attributes }}>

                    <input
                      type="radio"
                      name="contact[urgency]"
                      value="{{ block.settings.value }}"
                      {% if block.settings.default_selected %}
                        checked
                      {% endif %}
                    >

                    <span>
                      {{ block.settings.label }}
                    </span>

                  </label>

                {% endif %}

              {% endfor %}

            </div>

          </div>


          <!-- Notes -->

          <div
            class="so-field so-full"
            style="margin-bottom:12px;"
          >

            <label>

              {{ section.settings.notes_label }}

              {% if section.settings.notes_optional %}
                <span class="so-opt">(optional)</span>
              {% endif %}

            </label>

            <textarea
              name="contact[additional_notes]"
              placeholder="{{ section.settings.notes_placeholder }}"
            ></textarea>

          </div>


          <!-- Submit -->

          <div class="so-submit-row">

            {% if section.settings.submit_note != blank %}

              <p>
                {{ section.settings.submit_note }}
              </p>

            {% endif %}

            <button type="submit">
              {{ section.settings.submit_button }}
            </button>

          </div>

        {% endform %}

      </div>


      <!-- =========================
           SIDEBAR
      ========================= -->

      <div>

        <!-- Steps -->

        <div class="so-side-card">

          {% if section.settings.steps_title != blank %}
            <h3>
              {{ section.settings.steps_title }}
            </h3>
          {% endif %}

          <ul class="so-steps">

            {% assign step_number = 0 %}

            {% for block in section.blocks %}

              {% if block.type == 'step' %}

                {% assign step_number = step_number | plus: 1 %}

                <li {{ block.shopify_attributes }}>

                  <div class="so-step-num">
                    {% if step_number < 10 %}
                      0{{ step_number }}
                    {% else %}
                      {{ step_number }}
                    {% endif %}
                  </div>

                  <p>

                    {% if block.settings.title != blank %}
                      <b>
                        {{ block.settings.title }}
                      </b>
                    {% endif %}

                    {{ block.settings.description }}

                  </p>

                </li>

              {% endif %}

            {% endfor %}

          </ul>

        </div>


        <!-- Lead Times -->

        <div class="so-info-card">

          {% if section.settings.lead_title != blank %}
            <h3>
              {{ section.settings.lead_title }}
            </h3>
          {% endif %}

          {% for block in section.blocks %}

            {% if block.type == 'lead_time' %}

              <div
                class="so-lead-row"
                {{ block.shopify_attributes }}
              >

                <span>
                  {{ block.settings.label }}
                </span>

                <span>
                  {{ block.settings.time }}
                </span>

              </div>

            {% endif %}

          {% endfor %}

        </div>


        <!-- Contact -->

        <div class="so-contact-card">

          {% if section.settings.contact_card_title != blank %}
            <h3>
              {{ section.settings.contact_card_title }}
            </h3>
          {% endif %}

          {% if section.settings.contact_card_description != blank %}
            <p>
              {{ section.settings.contact_card_description }}
            </p>
          {% endif %}


          {% for block in section.blocks %}

            {% if block.type == 'contact_email' %}

              {% if block.settings.email != blank %}

                <a
                  class="so-mail"
                  href="mailto:{{ block.settings.email }}"
                  {{ block.shopify_attributes }}
                >
                  {{ block.settings.email }}

                  {% if block.settings.location != blank %}
                    — {{ block.settings.location }}
                  {% endif %}

                </a>

              {% endif %}

            {% endif %}

          {% endfor %}

        </div>

      </div>

    </div>

  </main>

</div>


{% schema %}

{
  "name": "Request order",
  "tag": "section",
  "class": "request-order-section",

  "settings": [

    {
      "type": "header",
      "content": "Hero"
    },

    {
      "type": "text",
      "id": "hero_eyebrow",
      "label": "Eyebrow",
      "default": "Special Order Desk"
    },

    {
      "type": "text",
      "id": "hero_title",
      "label": "Title",
      "default": "Can't find it in stock? We'll still get it to you."
    },

    {
      "type": "textarea",
      "id": "hero_description",
      "label": "Description",
      "default": "Search any SKU to check live availability. If it's backordered, discontinued from our shelf, or a low-volume item we don't normally carry, submit a request and a CSR will source it and confirm pricing and lead time."
    },


    {
      "type": "header",
      "content": "Availability Lookup"
    },

    {
      "type": "checkbox",
      "id": "show_lookup",
