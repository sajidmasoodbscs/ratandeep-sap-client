  <script>
(function () {

  const API_URL =
    'https://ratandeep-sap-client.onrender.com/apps/sap-price-test/get-price-by-sku';

  const sectionId = {{ section.id | json }};

  const CUSTOMER_ID =
    {{ customer.id | json }};

  const SHOP_URL =
    {{ shop.permanent_domain | json }};

  const loader =
    document.getElementById(
      'sap-price-loader-' + sectionId
    );

  const priceContainer =
    document.getElementById(
      'price-' + sectionId
    );


  /*
   * Shopify product variants
   */
  const variants = [
    {% for variant in product.variants %}
      {
        id: {{ variant.id | json }},
        sku: {{ variant.sku | json }},
        price: {{ variant.price | json }}
      }{% unless forloop.last %},{% endunless %}
    {% endfor %}
  ];


  /*
   * Get currently selected variant
   */
  function getSelectedVariant() {

    const variantInput =
      document.querySelector(
        '#product-form-' + sectionId +
        ' input[name="id"]'
      );

    if (!variantInput) {
      return variants[0];
    }

    const variantId =
      String(variantInput.value);

    return variants.find(function (variant) {

      return String(variant.id) === variantId;

    });

  }


  /*
   * Format price
   */
  function formatPrice(price) {

    return new Intl.NumberFormat(
      undefined,
      {
        style: 'currency',
        currency: 'USD'
      }
    ).format(Number(price));

  }


  /*
   * Put SAP price into Shopify price element
   */
  function displaySapPrice(price) {

    if (!priceContainer) {
      return;
    }

    /*
     * Find the actual price text
     */
    const priceElements =
      priceContainer.querySelectorAll(
        '.price-item'
      );

    const formatted =
      formatPrice(price);


    if (priceElements.length) {

      priceElements.forEach(function (element) {

        element.textContent =
          formatted;

      });

    } else {

      /*
       * Fallback if theme markup differs
       */
      priceContainer.textContent =
        formatted;

    }


    /*
     * Show price
     */
    priceContainer.classList.remove(
      'sap-price-loading'
    );


    /*
     * Hide loader
     */
    if (loader) {
      loader.classList.add(
        'sap-price-loaded'
      );
    }

  }


  /*
   * Get price from your API
   */
  async function fetchSapPrice(variant) {

    if (!variant || !variant.sku) {

      console.warn(
        '[SAP] Variant has no SKU'
      );

      return;

    }


    console.log(
      '[SAP] Fetching price:',
      variant.sku
    );


    const response =
      await fetch(
        API_URL,
        {
          method: 'POST',

          headers: {
            'Content-Type':
              'application/json',

            'Accept':
              'application/json'
          },

          body: JSON.stringify({

            customerId:
              CUSTOMER_ID,

            sku:
              variant.sku,

            shopUrl:
              SHOP_URL,

            // Shopify variant.price is cents → dollars for server-side compare
            shopifyPrice:
              Number(variant.price) / 100

          })
        }
      );


    if (!response.ok) {

      throw new Error(
        'SAP API HTTP ' +
        response.status
      );

    }


    const data =
      await response.json();


    console.log(
      '[SAP] Response:',
      data
    );


    /*
     * Expected:
     *
     * {
     *   price: 123.45
     * }
     */


    if (
      data.price === undefined ||
      data.price === null
    ) {

      throw new Error(
        'No price returned from SAP'
      );

    }


    return Number(data.price);

  }


  /*
   * Shopify variant.price is in cents.
   * Use Redis/SAP only when it is > 0 and strictly below Shopify.
   */
  function resolveDisplayPrice(sapPrice, variant) {

    const shopifyDollars =
      variant && variant.price != null
        ? Number(variant.price) / 100
        : NaN;

    const redisPrice =
      Number(sapPrice);

    if (
      !Number.isFinite(redisPrice) ||
      redisPrice <= 0
    ) {

      console.log(
        '[SAP] SAP/Redis price zero or invalid — keeping Shopify price'
      );

      return Number.isFinite(shopifyDollars)
        ? shopifyDollars
        : null;

    }

    if (
      Number.isFinite(shopifyDollars) &&
      redisPrice >= shopifyDollars
    ) {

      console.log(
        '[SAP] Redis price higher than Shopify sales price — keeping Shopify price',
        {
          redisPrice: redisPrice,
          shopifyPrice: shopifyDollars
        }
      );

      return shopifyDollars;

    }

    return redisPrice;

  }


  /*
   * Load price
   */
  async function loadPrice() {

    const variant =
      getSelectedVariant();


    if (!variant) {
      return;
    }


    /*
     * Show loader
     */
    if (loader) {
      loader.classList.remove(
        'sap-price-loaded'
      );
    }


    /*
     * Hide normal Shopify price
     */
    if (priceContainer) {
      priceContainer.classList.add(
        'sap-price-loading'
      );
    }


    try {

      const sapPrice =
        await fetchSapPrice(
          variant
        );


      const finalPrice =
        resolveDisplayPrice(
          sapPrice,
          variant
        );


      console.log(
        '[SAP] Price received:',
        sapPrice,
        'display:',
        finalPrice
      );


      if (finalPrice == null) {

        throw new Error(
          'No usable price to display'
        );

      }


      displaySapPrice(
        finalPrice
      );


    } catch (error) {

      console.error(
        '[SAP] Failed to load price:',
        error
      );


      /*
       * API failed.
       *
       * Don't leave the customer
       * staring at the loader forever.
       */
      if (priceContainer) {

        priceContainer.classList.remove(
          'sap-price-loading'
        );

      }

      if (loader) {

        loader.classList.add(
          'sap-price-loaded'
        );

      }

    }

  }


  /*
   * Initial PDP load
   */
  loadPrice();


  /*
   * Detect variant changes
   */
  document.addEventListener(
    'change',
    function (event) {

      if (
        event.target &&
        (
          event.target.name === 'id' ||
          event.target.closest(
            'variant-selects'
          ) ||
          event.target.closest(
            'variant-radios'
          )
        )
      ) {

        /*
         * Give Shopify a moment to
         * update the variant ID.
         */
        setTimeout(
          loadPrice,
          150
        );

      }

    }
  );

})();
</script>
</product-info>

