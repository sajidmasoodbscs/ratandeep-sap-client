{% doc %}
  @prompt
    make spacing secition 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-spacing-block-{{ ai_gen_id }} {
    display: block;
    width: 100%;
  }

  @media screen and (min-width: 750px) {
    .ai-spacing-block-{{ ai_gen_id }} {
      padding-top: {{ block.settings.spacing_desktop }}px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-spacing-block-{{ ai_gen_id }} {
      padding-top: {{ block.settings.spacing_mobile }}px;
    }
  }
{% endstyle %}

<spacing-block-{{ ai_gen_id }}
  class="ai-spacing-block-{{ ai_gen_id }}"
  {{ block.shopify_attributes }}
>
</spacing-block-{{ ai_gen_id }}>

{% schema %}
{
  "name": "Spacing",
  "settings": [
    {
      "type": "range",
      "id": "spacing_desktop",
      "label": "Desktop spacing",
      "min": 0,
      "max": 200,
      "step": 4,
      "unit": "px",
      "default": 40
    },
    {
      "type": "range",
      "id": "spacing_mobile",
      "label": "Mobile spacing",
      "min": 0,
      "max": 100,
      "step": 4,
      "unit": "px",
      "default": 20
    }
  ],
  "presets": [
    {
      "name": "Spacing"
    }
  ]
}
{% endschema %}
