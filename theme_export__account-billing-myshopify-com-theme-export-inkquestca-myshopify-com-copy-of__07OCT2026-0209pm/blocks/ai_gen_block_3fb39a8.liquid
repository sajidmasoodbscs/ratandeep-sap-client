    4 block with image small like icone and heading description and left align with slide in mobile 1-1, click krne pr backgroud gredient me hona chahiye and text whhite, ek block active hona chahiye bg color ke sath, icone black hona chahiye uspr backgroud color ni hoga or jispr hoga uspr white hona chchiye
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-features-container-{{ ai_gen_id }} {
    width: 100%;
    padding: {{ block.settings.section_padding_top }}px 0 {{ block.settings.section_padding_bottom }}px;
    background-color: {{ block.settings.background_color }};
  }

  .ai-features-wrapper-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-features-grid-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: {{ block.settings.gap }}px;
  }

  .ai-feature-item-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    text-align: left;
    padding: {{ block.settings.item_padding }}px;
    border-radius: {{ block.settings.item_border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    background: transparent;
  }

  .ai-feature-item-{{ ai_gen_id }}.active {
    background: {{ block.settings.active_gradient }};
  }

  .ai-feature-item-{{ ai_gen_id }}.active .ai-feature-heading-{{ ai_gen_id }},
  .ai-feature-item-{{ ai_gen_id }}.active .ai-feature-description-{{ ai_gen_id }} {
    color: {{ block.settings.active_text_color }};
  }

  .ai-feature-item-{{ ai_gen_id }}.active .ai-feature-icon-{{ ai_gen_id }} {
    filter: brightness(0) invert(1);
  }

  .ai-feature-item-{{ ai_gen_id }}:hover {
    background: {{ block.settings.hover_gradient }};
  }

  .ai-feature-item-{{ ai_gen_id }}:hover .ai-feature-heading-{{ ai_gen_id }},
  .ai-feature-item-{{ ai_gen_id }}:hover .ai-feature-description-{{ ai_gen_id }} {
    color: {{ block.settings.hover_text_color }};
  }

  .ai-feature-item-{{ ai_gen_id }}:hover .ai-feature-icon-{{ ai_gen_id }} {
    filter: brightness(0) invert(1);
  }

  .ai-feature-icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: {{ block.settings.icon_spacing }}px;
    flex-shrink: 0;
  }

  .ai-feature-icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    transition: filter 0.3s ease;
  }

  .ai-feature-icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-icon-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-feature-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: {{ block.settings.heading_weight }};
    color: {{ block.settings.heading_color }};
    margin: 0 0 {{ block.settings.heading_spacing }}px;
    line-height: 1.3;
    transition: color 0.3s ease;
  }

  .ai-feature-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    margin: 0;
    line-height: 1.6;
    transition: color 0.3s ease;
  }

  @media screen and (max-width: 989px) {
    .ai-features-grid-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
    }
  }

  @media screen and (max-width: 749px) {
    .ai-features-wrapper-{{ ai_gen_id }} {
      padding: 0;
      overflow: hidden;
    }

    .ai-features-grid-{{ ai_gen_id }} {
      display: flex;
      overflow-x: auto;
      scroll-snap-type: x mandatory;
      gap: {{ block.settings.gap }}px;
      padding: 0 20px;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
    }

    .ai-features-grid-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-feature-item-{{ ai_gen_id }} {
      flex: 0 0 100%;
      scroll-snap-align: start;
      min-width: 100%;
    }
  }
{% endstyle %}

<feature-icons-{{ ai_gen_id }} class="ai-features-container-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-features-wrapper-{{ ai_gen_id }}">
    <div class="ai-features-grid-{{ ai_gen_id }}">
      {% for i in (1..4) %}
        {% liquid
          assign icon_key = 'icon_' | append: i
          assign heading_key = 'heading_' | append: i
          assign description_key = 'description_' | append: i

          assign icon = block.settings[icon_key]
          assign heading = block.settings[heading_key]
          assign description = block.settings[description_key]
        %}

        <div class="ai-feature-item-{{ ai_gen_id }} {% if forloop.index == 1 %}active{% endif %}" data-feature-index="{{ forloop.index }}">
          <div class="ai-feature-icon-wrapper-{{ ai_gen_id }}">
            {% if icon %}
              <img
                src="{{ icon | image_url: width: 200 }}"
                alt="{{ heading | escape }}"
                class="ai-feature-icon-{{ ai_gen_id }}"
                loading="lazy"
                width="{{ block.settings.icon_size }}"
                height="{{ block.settings.icon_size }}"
              >
            {% else %}
              <div class="ai-feature-icon-placeholder-{{ ai_gen_id }}">
                {{ 'image' | placeholder_svg_tag }}
              </div>
            {% endif %}
          </div>

          {% if heading != blank %}
            <h3 class="ai-feature-heading-{{ ai_gen_id }}">{{ heading }}</h3>
          {% endif %}

          {% if description != blank %}
            <p class="ai-feature-description-{{ ai_gen_id }}">{{ description }}</p>
          {% endif %}
        </div>
      {% endfor %}
    </div>
  </div>
</feature-icons-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureIcons{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.items = this.querySelectorAll('.ai-feature-item-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.items.forEach((item) => {
          item.addEventListener('click', () => {
            this.items.forEach((i) => i.classList.remove('active'));
            item.classList.add('active');
          });
        });
      }
    }

    customElements.define('feature-icons-{{ ai_gen_id }}', FeatureIcons{{ ai_gen_id }});
  })();
</script>

