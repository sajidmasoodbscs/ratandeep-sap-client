{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
 .newsletter-wrapper {
    padding: 10px;
    text-align: center;
  }

  .newsletter-container {
    max-width: 600px;
    margin: 0 auto;
  }

  .newsletter-title {
    font-size: 32px;
    margin-bottom: 10px;
    font-weight: 700;
  }

  .newsletter-subtext {
    font-size: 16px;
    margin-bottom: 20px;
    color: #555;
  }

  .newsletter-form {
    display: flex;
    gap: 10px;
    justify-content: center;
  }

  .newsletter-input {
    padding: 12px 15px;
    width: 70%;
    border: 1px solid #ccc;
    border-radius: 5px;
    font-size: 16px;
  }

  .newsletter-button {
    padding: 12px 20px;
    background: #000;
    color: #fff;
    border: none;
    border-radius: 5px;
    cursor: pointer;
    font-size: 16px;
    font-weight: 600;
  }

  .newsletter-button:hover {
    opacity: .9;
  }

  .newsletter-success {
    font-size: 18px;
    color: #00404C;
    font-weight: 600;
  }

  @media (max-width: 600px) {
    .newsletter-form {
      flex-direction: column;
    }

    .newsletter-input {
      width: 100%;
    }

    .newsletter-button {
      width: 100%;
    }
  }

  .ai-footer-{{ ai_gen_id }} {
    background-color: {{ block.settings.background_color }};
    color: {{ block.settings.text_color }};
    padding: {{ block.settings.padding_top }}px 0 {{ block.settings.padding_bottom }}px;
  }

  .ai-footer-container-{{ ai_gen_id }} {
    max-width: 75%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-footer-grid-{{ ai_gen_id }} {
    display: grid;
    gap: 40px;
    margin-bottom: 40px;
  }

  .ai-footer-column-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
  }

  .ai-footer-logo-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-footer-logo-{{ ai_gen_id }} img {
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
    border-radius:0px;
  }

  .ai-footer-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 60px;
    background-color: rgba(255, 255, 255, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-footer-logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    opacity: 0.3;
  }

  .ai-footer-address-{{ ai_gen_id }} {
    font-size: 14px;
    line-height: 1.6;
    color: {{ block.settings.text_color }};
    opacity: 0.8;
  }

  .ai-footer-menu-title-{{ ai_gen_id }} {
    font-size: 16px;
    font-weight: 600;
    margin-bottom: 16px;
    color: {{ block.settings.text_color }};
  }

  .ai-footer-menu-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-footer-menu-{{ ai_gen_id }} li {
    margin-bottom: 12px;
  }

  .ai-footer-menu-{{ ai_gen_id }} a {
    color: {{ block.settings.text_color }};
    text-decoration: none;
    font-size: 14px;
    opacity: 0.8;
    transition: opacity 0.3s ease;
  }

  .ai-footer-menu-{{ ai_gen_id }} a:hover {
    opacity: 1;
  }

  .ai-footer-social-{{ ai_gen_id }} {
    border-top: 1px solid rgba(255, 255, 255, 0.1);
    padding-top: 30px;
  }

  .ai-footer-social-icons-{{ ai_gen_id }} {
    display: flex;
    gap: 16px;
    justify-content: center;
  }

  .ai-footer-social-icon-{{ ai_gen_id }} {
    width: {{ block.settings.social_icon_size }}px;
    height: {{ block.settings.social_icon_size }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    background-color: {{ block.settings.social_icon_bg }};
    border-radius: 50%;
    transition: background-color 0.3s ease;
  }

  .ai-footer-social-icon-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.social_icon_hover_bg }};
  }

  .ai-footer-social-icon-{{ ai_gen_id }} svg {
    width: calc({{ block.settings.social_icon_size }}px * 0.5);
    height: calc({{ block.settings.social_icon_size }}px * 0.5);
    fill: {{ block.settings.social_icon_color }};
  }
.shopify-section-group-footer-group{
  box-shadow: rgba(67, 71, 85, 0.27) 0px 0px 0.25em, rgba(90, 125, 188, 0.05) 0px 0.25em 1em;
    padding: 50px 0;
        background: #f4f4f4;
}
.ai-footer-grid-{{ ai_gen_id }} {
  display: grid;
  grid-template-columns: 
    {{ block.settings.col1_width }}% 
    {{ block.settings.col2_width }}%
    {{ block.settings.col3_width }}%
    {{ block.settings.col4_width }}%;
  gap: 40px;
  margin-bottom: 40px;
}

  @media screen and (max-width: 749px) {
    .ai-footer-grid-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 0;
    }
 .ai-footer-container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }

    .ai-footer-column-{{ ai_gen_id }} {
      border-bottom: 1px solid rgba(255, 255, 255, 0.1);
    }

    .ai-footer-column-{{ ai_gen_id }}:first-child {
      padding-bottom: 24px;
      margin-bottom: 0;
    }

    .ai-footer-column-{{ ai_gen_id }}:not(:first-child) .ai-footer-menu-title-{{ ai_gen_id }} {
      cursor: pointer;
      padding: 16px 0;
      position: relative;
      user-select: none;
    }

    .ai-footer-column-{{ ai_gen_id }}:not(:first-child) .ai-footer-menu-title-{{ ai_gen_id }}::after {
      content: '+';
      position: absolute;
      right: 0;
      font-size: 20px;
      transition: transform 0.3s ease;
    }

    .ai-footer-column-{{ ai_gen_id }}:not(:first-child).active .ai-footer-menu-title-{{ ai_gen_id }}::after {
      content: '−';
    }

    .ai-footer-column-{{ ai_gen_id }}:not(:first-child) .ai-footer-menu-{{ ai_gen_id }} {
      max-height: 0;
      overflow: hidden;
      transition: max-height 0.3s ease;
    }

    .ai-footer-column-{{ ai_gen_id }}:not(:first-child).active .ai-footer-menu-{{ ai_gen_id }} {
      max-height: 500px;
      padding-bottom: 16px;
    }

    .ai-footer-column-{{ ai_gen_id }}:nth-child(2).active {
      border-bottom: none;
    }

    .ai-footer-column-{{ ai_gen_id }}:nth-child(2).active ~ .ai-footer-column-{{ ai_gen_id }}:nth-child(3) {
      border-top: 1px solid rgba(255, 255, 255, 0.1);
    }
  }
  .newsletter-submit-btn {
  position: relative;
  padding: 12px 20px;
  background: #00404C;
  color: #fff;
  border: none;
  border-radius: 5px;
  cursor: pointer;
  font-size: 16px;
  font-weight: 600;
  width: 100%;
  transition: all 0.25s ease;
  overflow: hidden;
}

.newsletter-submit-btn:hover {
  background: #00343e;
}

.newsletter-submit-btn:active {
  transform: scale(0.98);
}

.newsletter-submit-btn.is-loading {
  cursor: wait;
  opacity: 0.9;
  pointer-events: none;
}

.newsletter-btn-text {
  display: inline-block;
  transition: opacity 0.2s ease;
}

.newsletter-btn-loader {
  display: none;
  width: 18px;
  height: 18px;
  border: 2px solid rgba(255,255,255,0.35);
  border-top-color: #fff;
  border-radius: 50%;
  vertical-align: middle;
  animation: newsletter-spin 0.7s linear infinite;
}

.newsletter-submit-btn.is-loading .newsletter-btn-text {
  display: none;
}

.newsletter-submit-btn.is-loading .newsletter-btn-loader {
  display: inline-block;
}

@keyframes newsletter-spin {
  to {
    transform: rotate(360deg);
  }
}
{% endstyle %}

