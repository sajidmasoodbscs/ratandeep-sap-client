</footer-collapsible-{{ ai_gen_id }}>

<script>
  (function() {
    class FooterCollapsible{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.setupMobileAccordion();
        this.openFirstTab();
      }

      setupMobileAccordion() {
        const menuColumns = this.querySelectorAll('.ai-footer-menu-column-{{ ai_gen_id }}');
        
        menuColumns.forEach((column) => {
          const title = column.querySelector('.ai-footer-menu-title-{{ ai_gen_id }}');
          
          title.addEventListener('click', () => {
            if (window.innerWidth <= 749) {
              const isActive = column.classList.contains('active');
              
              menuColumns.forEach((col) => {
                col.classList.remove('active');
              });
              
              if (!isActive) {
                column.classList.add('active');
              }
            }
          });
        });
      }

      openFirstTab() {
        const firstMenuColumn = this.querySelector('.ai-footer-menu-column-{{ ai_gen_id }}[data-menu-index="2"]');
        if (firstMenuColumn && window.innerWidth <= 749) {
          firstMenuColumn.classList.add('active');
        }
      }
    }

    customElements.define('footer-collapsible-{{ ai_gen_id }}', FooterCollapsible{{ ai_gen_id }});
  })();
</script>

