
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-blocks-{{ ai_gen_id }} {
    padding: 40px 20px;
  }

  .ai-feature-blocks__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    max-width: 75%;
    margin: 0 auto;
  }

  .ai-feature-block-{{ ai_gen_id }} {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    padding: 30px 20px;
    border-radius: {{ block.settings.border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    background: transparent;
    border: 1px solid transparent;
    border: 2px solid rgb(234, 231, 231);
  }

  .ai-feature-block-{{ ai_gen_id }}.active {
    background: {{ block.settings.active_gradient_start }};
    background: linear-gradient(135deg, {{ block.settings.active_gradient_start }} 0%, {{ block.settings.active_gradient_end }} 100%);
    border-color: {{ block.settings.active_gradient_start }};
  }

  .ai-feature-block__icon-wrapper-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: 16px;
    display: flex;
    align-items: center;
    justify-content: center;
    flex-shrink: 0;
    position: relative;
  }

  .ai-feature-block__icon-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    object-fit: contain;
    position: absolute;
    top: 0;
    left: 0;
    transition: opacity 0.3s ease;
  }

  .ai-feature-block__icon-default-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-feature-block__icon-active-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-feature-block-{{ ai_gen_id }}.active .ai-feature-block__icon-default-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-feature-block-{{ ai_gen_id }}.active .ai-feature-block__icon-active-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-feature-block__icon-wrapper-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
  }

  .ai-feature-block-{{ ai_gen_id }}:not(.active) .ai-feature-block__icon-wrapper-{{ ai_gen_id }} svg {
    fill: {{ block.settings.icon_color }};
  }

  .ai-feature-block-{{ ai_gen_id }}.active .ai-feature-block__icon-wrapper-{{ ai_gen_id }} svg {
    fill: {{ block.settings.active_icon_color }};
  }

  .ai-feature-block__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0 0 8px 0;
    color: {{ block.settings.text_color }};
    transition: color 0.3s ease;
  }

  .ai-feature-block-{{ ai_gen_id }}.active .ai-feature-block__heading-{{ ai_gen_id }} {
    color: {{ block.settings.active_text_color }};
  }

  .ai-feature-block__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.5;
    margin: 0;
    color: {{ block.settings.text_color }};
    transition: color 0.3s ease;
  }

  .ai-feature-block-{{ ai_gen_id }}.active .ai-feature-block__description-{{ ai_gen_id }} {
    color: {{ block.settings.active_text_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-feature-blocks__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-blocks__container-{{ ai_gen_id }} {
      margin: 0 20px;
      grid-template-columns: 1fr;
      gap: 0;
      overflow-x: auto;
      display: flex;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      scrollbar-width: none;
      padding-bottom: 10px;
    }

    .ai-feature-blocks__container-{{ ai_gen_id }}::-webkit-scrollbar {
      display: none;
    }

    .ai-feature-block-{{ ai_gen_id }} {
      min-width: 280px;
      scroll-snap-align: start;
      margin-right: 16px;
    }

    .ai-feature-block-{{ ai_gen_id }}:last-child {
      margin-right: 0;
    }
  }
{% endstyle %}

<feature-blocks-{{ ai_gen_id }} class="ai-feature-blocks-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-blocks__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign icon_key = 'block_' | append: i | append: '_icon'
        assign icon_active_key = 'block_' | append: i | append: '_icon_active'
        assign heading_key = 'block_' | append: i | append: '_heading'
        assign description_key = 'block_' | append: i | append: '_description'
        
        assign icon = block.settings[icon_key]
        assign icon_active = block.settings[icon_active_key]
        assign heading = block.settings[heading_key]
        assign description = block.settings[description_key]
      %}
      
      <div 
        class="ai-feature-block-{{ ai_gen_id }} {% if i == 1 %}active{% endif %}" 
        data-block-index="{{ i }}"
      >
        <div class="ai-feature-block__icon-wrapper-{{ ai_gen_id }}">
          {% if icon != blank %}
            <img 
              src="{{ icon | image_url: width: 200 }}" 
              alt="{{ heading | escape }}"
              class="ai-feature-block__icon-{{ ai_gen_id }} ai-feature-block__icon-default-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.icon_size }}"
              height="{{ block.settings.icon_size }}"
            >
          {% else %}
            <div class="ai-feature-block__icon-{{ ai_gen_id }} ai-feature-block__icon-default-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
          
          {% if icon_active != blank %}
            <img 
              src="{{ icon_active | image_url: width: 200 }}" 
              alt="{{ heading | escape }}"
              class="ai-feature-block__icon-{{ ai_gen_id }} ai-feature-block__icon-active-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.icon_size }}"
              height="{{ block.settings.icon_size }}"
            >
          {% elsif icon != blank %}
            <img 
              src="{{ icon | image_url: width: 200 }}" 
              alt="{{ heading | escape }}"
              class="ai-feature-block__icon-{{ ai_gen_id }} ai-feature-block__icon-active-{{ ai_gen_id }}"
              loading="lazy"
              width="{{ block.settings.icon_size }}"
              height="{{ block.settings.icon_size }}"
            >
          {% else %}
            <div class="ai-feature-block__icon-{{ ai_gen_id }} ai-feature-block__icon-active-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        {% if heading != blank %}
          <h3 class="ai-feature-block__heading-{{ ai_gen_id }}">{{ heading }}</h3>
        {% endif %}
        
        {% if description != blank %}
          <p class="ai-feature-block__description-{{ ai_gen_id }}">{{ description }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</feature-blocks-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureBlocks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.blocks = this.querySelectorAll('.ai-feature-block-{{ ai_gen_id }}');
      }

      connectedCallback() {
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.blocks.forEach((block) => {
          block.addEventListener('click', () => {
            this.blocks.forEach(b => b.classList.remove('active'));
            block.classList.add('active');
          });
        });
      }
    }

    customElements.define('feature-blocks-{{ ai_gen_id }}', FeatureBlocks{{ ai_gen_id }});
  })();
</script>

