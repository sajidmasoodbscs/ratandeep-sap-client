      padding: {{ block.settings.vertical_padding | times: 0.7 }}px {{ block.settings.horizontal_padding | times: 0.7 }}px;
    }

    .ai-premium-search-input-{{ ai_gen_id }} {
      font-size: {{ block.settings.input_font_size | minus: 2 }}px;
    }

    .ai-premium-search-product-image-{{ ai_gen_id }} {
      width: {{ block.settings.product_image_size | times: 0.8 }}px;
