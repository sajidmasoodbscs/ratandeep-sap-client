    color: {{ block.settings.dropdown_text_color | color_modify: 'alpha', 0.7 }};
  }

  .ai-premium-search-product-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_meta_size }}px;
    font-weight: 600;
    color: {{ block.settings.dropdown_text_color }};
  }

  .ai-premium-search-product-compare-price-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_meta_size }}px;
    color: {{ block.settings.dropdown_text_color | color_modify: 'alpha', 0.5 }};
    text-decoration: line-through;
  }

  .ai-premium-search-product-availability-{{ ai_gen_id }} {
    font-size: {{ block.settings.product_meta_size | minus: 1 }}px;
    padding: 2px 8px;
    border-radius: 12px;
    font-weight: 500;
  }

  .ai-premium-search-product-availability-{{ ai_gen_id }}.in-stock {
    background-color: {{ block.settings.in_stock_bg_color }};
    color: {{ block.settings.in_stock_text_color }};
  }

  .ai-premium-search-product-availability-{{ ai_gen_id }}.out-of-stock {
    background-color: {{ block.settings.out_of_stock_bg_color }};
    color: {{ block.settings.out_of_stock_text_color }};
  }

  .ai-premium-search-empty-{{ ai_gen_id }} {
    padding: 32px 24px;
