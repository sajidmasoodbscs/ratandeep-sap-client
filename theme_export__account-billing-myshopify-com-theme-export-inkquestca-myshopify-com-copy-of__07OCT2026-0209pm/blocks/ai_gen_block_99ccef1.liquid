<script>
(function() {
  class PremiumSearch{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.searchInput = this.querySelector('.ai-premium-search-input-{{ ai_gen_id }}');
      this.clearButton = this.querySelector('.ai-premium-search-clear-{{ ai_gen_id }}');
      this.loadingIndicator = this.querySelector('.ai-premium-search-loading-{{ ai_gen_id }}');
      this.dropdown = this.querySelector('.ai-premium-search-dropdown-{{ ai_gen_id }}');
      this.resultsContainer = this.querySelector('.ai-premium-search-results-{{ ai_gen_id }}');
      this.form = this.querySelector('.ai-premium-search-form-{{ ai_gen_id }}');
      
      this.debounceTimer = null;
      this.currentRequest = null;
      this.cache = {};
      this.focusedIndex = -1;
      this.products = [];
      this.minChars = {{ block.settings.min_characters }};
      this.debounceDelay = {{ block.settings.debounce_delay }};
    }

    connectedCallback() {
      this.setupScrollListener();
      this.setupSearchListeners();
      this.setupKeyboardNavigation();
      this.setupClickOutside();
    }

    setupScrollListener() {
      let ticking = false;
      window.addEventListener('scroll', () => {
        if (!ticking) {
          window.requestAnimationFrame(() => {
            if (window.scrollY > 50) {
              this.classList.add('scrolled');
            } else {
              this.classList.remove('scrolled');
            }
            ticking = false;
          });
          ticking = true;
        }
      });
    }

    setupSearchListeners() {
      this.searchInput.addEventListener('input', (e) => {
        const query = e.target.value.trim();
        
        if (query.length > 0) {
          this.clearButton.classList.add('visible');
        } else {
          this.clearButton.classList.remove('visible');
        }

        clearTimeout(this.debounceTimer);
        
        if (query.length >= this.minChars) {
          this.debounceTimer = setTimeout(() => {
            this.performSearch(query);
          }, this.debounceDelay);
        } else {
          this.hideDropdown();
        }
      });

      this.clearButton.addEventListener('click', () => {
        this.searchInput.value = '';
        this.clearButton.classList.remove('visible');
        this.hideDropdown();
        this.searchInput.focus();
      });

      this.form.addEventListener('submit', (e) => {
        if (this.searchInput.value.trim().length === 0) {
          e.preventDefault();
        }
      });
    }

    setupKeyboardNavigation() {
      this.searchInput.addEventListener('keydown', (e) => {
        if (!this.dropdown.classList.contains('visible')) return;

        switch(e.key) {
          case 'ArrowDown':
            e.preventDefault();
            this.focusNext();
            break;
          case 'ArrowUp':
            e.preventDefault();
            this.focusPrevious();
            break;
          case 'Enter':
            e.preventDefault();
            if (this.focusedIndex >= 0 && this.products[this.focusedIndex]) {
              window.location.href = this.products[this.focusedIndex].url;
            } else if (this.searchInput.value.trim()) {
              this.form.submit();
            }
            break;
          case 'Escape':
            e.preventDefault();
            this.hideDropdown();
            break;
        }
      });
    }

    setupClickOutside() {
      document.addEventListener('click', (e) => {
        if (!this.contains(e.target)) {
          this.hideDropdown();
        }
      });
    }

    focusNext() {
      this.focusedIndex = Math.min(this.focusedIndex + 1, this.products.length - 1);
      this.updateFocus();
    }

    focusPrevious() {
      this.focusedIndex = Math.max(this.focusedIndex - 1, -1);
      this.updateFocus();
    }

    updateFocus() {
      const productElements = this.dropdown.querySelectorAll('.ai-premium-search-product-{{ ai_gen_id }}');
      productElements.forEach((el, index) => {
        if (index === this.focusedIndex) {
          el.classList.add('focused');
          el.scrollIntoView({ block: 'nearest', behavior: 'smooth' });
        } else {
          el.classList.remove('focused');
        }
      });
    }

    async performSearch(query) {
      if (this.cache[query]) {
        this.displayResults(this.cache[query], query);
        return;
      }

      if (this.currentRequest) {
        this.currentRequest.abort();
      }

      this.showLoading();

      this.currentRequest = new AbortController();
      
      try {
        const response = await fetch(
          `/search/suggest.json?q=${encodeURIComponent(query)}&resources[type]=product&resources[limit]=10`,
          { signal: this.currentRequest.signal }
        );

        if (!response.ok) throw new Error('Search failed');

        const data = await response.json();
        const products = data.resources.results.products || [];
        
        this.cache[query] = products;
        this.displayResults(products, query);
      } catch (error) {
        if (error.name !== 'AbortError') {
          console.error('Search error:', error);
          this.hideLoading();
        }
      }
    }

    displayResults(products, query) {
      this.hideLoading();
      this.products = products;
      this.focusedIndex = -1;

      if (products.length === 0) {
        this.displayEmptyState(query);
        return;
      }

      const html = products.map(product => this.renderProduct(product, query)).join('');
      this.resultsContainer.innerHTML = html;
      this.showDropdown();
    }

    renderProduct(product, query) {
      const image = product.featured_image || '';
      const title = this.highlightText(product.title, query);
      const price = this.formatMoney(product.price);
      const comparePrice = product.compare_at_price_max > product.price ? this.formatMoney(product.compare_at_price_max) : '';
      const vendor = product.vendor || '';
      const available = product.available;
      const showVendor = {{ block.settings.show_vendor | json }};
      const showPrice = {{ block.settings.show_price | json }};
      const showAvailability = {{ block.settings.show_availability | json }};

      return `
        <a href="${product.url}" class="ai-premium-search-product-{{ ai_gen_id }}">
          <div class="ai-premium-search-product-image-{{ ai_gen_id }}">
            ${image ? `<img src="${image}" alt="${product.title}" loading="lazy">` : ''}
          </div>
          <div class="ai-premium-search-product-info-{{ ai_gen_id }}">
            <h3 class="ai-premium-search-product-title-{{ ai_gen_id }}">${title}</h3>
            <div class="ai-premium-search-product-meta-{{ ai_gen_id }}">
              ${showVendor && vendor ? `<span class="ai-premium-search-product-vendor-{{ ai_gen_id }}">${vendor}</span>` : ''}
              ${showPrice ? `
                <span class="ai-premium-search-product-price-{{ ai_gen_id }}">${price}</span>
                ${comparePrice ? `<span class="ai-premium-search-product-compare-price-{{ ai_gen_id }}">${comparePrice}</span>` : ''}
              ` : ''}
              ${showAvailability ? `
                <span class="ai-premium-search-product-availability-{{ ai_gen_id }} ${available ? 'in-stock' : 'out-of-stock'}">
                  ${available ? 'In Stock' : 'Out of Stock'}
                </span>
              ` : ''}
            </div>
          </div>
        </a>
      `;
    }

    async displayEmptyState(query) {
      const showSuggestions = {{ block.settings.show_suggestions | json }};
      let suggestionsHtml = '';

      if (showSuggestions) {
        try {
          const response = await fetch(`/search/suggest.json?q=&resources[type]=product&resources[limit]=4`);
          const data = await response.json();
          const suggestions = data.resources.results.products || [];
          
          if (suggestions.length > 0) {
            suggestionsHtml = `
              <div class="ai-premium-search-suggestions-{{ ai_gen_id }}">
                ${suggestions.map(product => this.renderProduct(product, '')).join('')}
              </div>
            `;
          }
        } catch (error) {
          console.error('Failed to load suggestions:', error);
        }
      }

      this.resultsContainer.innerHTML = `
        <div class="ai-premium-search-empty-{{ ai_gen_id }}">
          <h3 class="ai-premium-search-empty-title-{{ ai_gen_id }}">{{ block.settings.empty_state_title }}</h3>
          <p class="ai-premium-search-empty-subtitle-{{ ai_gen_id }}">{{ block.settings.empty_state_subtitle }}</p>
          ${suggestionsHtml}
        </div>
      `;
      this.showDropdown();
    }

    highlightText(text, query) {
      if (!query) return text;
      const regex = new RegExp(`(${query.replace(/[.*+?^${}()|[\]\\]/g, '\\$&')})`, 'gi');
      return text.replace(regex, '<mark>$1</mark>');
    }

    formatMoney(cents) {
      const amount = cents / 100;
      return new Intl.NumberFormat('{{ shop.locale }}', {
        style: 'currency',
        currency: '{{ cart.currency.iso_code }}'
      }).format(amount);
    }

    showLoading() {
      this.loadingIndicator.classList.add('visible');
    }

    hideLoading() {
      this.loadingIndicator.classList.remove('visible');
    }

    showDropdown() {
      this.dropdown.classList.add('visible');
      this.searchInput.setAttribute('aria-expanded', 'true');
    }

    hideDropdown() {
      this.dropdown.classList.remove('visible');
      this.searchInput.setAttribute('aria-expanded', 'false');
      this.focusedIndex = -1;
    }
  }

  customElements.define('premium-search-{{ ai_gen_id }}', PremiumSearch{{ ai_gen_id }});
})();
</script>

