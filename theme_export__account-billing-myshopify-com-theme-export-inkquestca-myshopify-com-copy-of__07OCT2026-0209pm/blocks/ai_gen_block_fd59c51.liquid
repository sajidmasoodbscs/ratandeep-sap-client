    4 block with image small like icone and heading description and left align with slide in mobile 1-1, click krne pr backgroud gredient me hona chahiye and text whhite, ek block active hona chahiye bg color ke sath, icone black hona chahiye uspr backgroud color ni hoga or jispr hoga uspr white hona chchiye
    logo do dal ske like ek active or ek none active k liye ya fir icon ho jay jo better ho
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-feature-blocks-{{ ai_gen_id }} {
    padding: 40px 20px;
  }

  .ai-feature-blocks__container-{{ ai_gen_id }} {
    display: grid;
    grid-template-columns: repeat(4, 1fr);
    gap: 20px;
    max-width: 1200px;
    margin: 0 auto;
  }

  .ai-feature-block-{{ ai_gen_id }} {
    padding: 30px 20px;
    border-radius: {{ block.settings.border_radius }}px;
    cursor: pointer;
    transition: all 0.3s ease;
    text-align: left;
    border: 1px solid transparent;
  }

  .ai-feature-block-{{ ai_gen_id }}.active {
    background: {{ block.settings.active_gradient_start }};
    background: linear-gradient(135deg, {{ block.settings.active_gradient_start }} 0%, {{ block.settings.active_gradient_end }} 100%);
  }

  .ai-feature-block__icon-{{ ai_gen_id }} {
    width: {{ block.settings.icon_size }}px;
    height: {{ block.settings.icon_size }}px;
    margin-bottom: 20px;
    display: flex;
    align-items: center;
    justify-content: flex-start;
  }

  .ai-feature-block__icon-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    object-fit: contain;
    filter: brightness(0);
  }

  .ai-feature-block-{{ ai_gen_id }}.active .ai-feature-block__icon-{{ ai_gen_id }} img {
    filter: brightness(0) invert(1);
  }

  .ai-feature-block__icon-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #e0e0e0;
    border-radius: 8px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-feature-block__icon-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-feature-block__heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    font-weight: 600;
    margin: 0 0 12px 0;
    color: {{ block.settings.text_color }};
    transition: color 0.3s ease;
  }

  .ai-feature-block-{{ ai_gen_id }}.active .ai-feature-block__heading-{{ ai_gen_id }} {
    color: {{ block.settings.active_text_color }};
  }

  .ai-feature-block__description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    line-height: 1.6;
    margin: 0;
    color: {{ block.settings.text_color }};
    transition: color 0.3s ease;
  }

  .ai-feature-block-{{ ai_gen_id }}.active .ai-feature-block__description-{{ ai_gen_id }} {
    color: {{ block.settings.active_text_color }};
  }

  @media screen and (max-width: 989px) {
    .ai-feature-blocks__container-{{ ai_gen_id }} {
      grid-template-columns: repeat(2, 1fr);
      gap: 16px;
    }
  }

  @media screen and (max-width: 749px) {
    .ai-feature-blocks__container-{{ ai_gen_id }} {
      grid-template-columns: 1fr;
      gap: 12px;
      overflow-x: auto;
      display: flex;
      scroll-snap-type: x mandatory;
      -webkit-overflow-scrolling: touch;
      padding-bottom: 10px;
    }

    .ai-feature-block-{{ ai_gen_id }} {
      min-width: 280px;
      scroll-snap-align: start;
    }
  }
{% endstyle %}

<feature-blocks-{{ ai_gen_id }} class="ai-feature-blocks-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-feature-blocks__container-{{ ai_gen_id }}">
    {% for i in (1..4) %}
      {% liquid
        assign icon_key = 'block_' | append: i | append: '_icon'
        assign heading_key = 'block_' | append: i | append: '_heading'
        assign description_key = 'block_' | append: i | append: '_description'
        
        assign icon = block.settings[icon_key]
        assign heading = block.settings[heading_key]
        assign description = block.settings[description_key]
        
        assign is_active = false
        if i == block.settings.default_active_block
          assign is_active = true
        endif
      %}
      
      <div 
        class="ai-feature-block-{{ ai_gen_id }} {% if is_active %}active{% endif %}"
        data-block-index="{{ i }}"
      >
        <div class="ai-feature-block__icon-{{ ai_gen_id }}">
          {% if icon %}
            <img 
              src="{{ icon | image_url: width: 200 }}" 
              alt="{{ heading | escape }}"
              loading="lazy"
              width="200"
              height="200"
            >
          {% else %}
            <div class="ai-feature-block__icon-placeholder-{{ ai_gen_id }}">
              {{ 'image' | placeholder_svg_tag }}
            </div>
          {% endif %}
        </div>
        
        {% if heading != blank %}
          <h3 class="ai-feature-block__heading-{{ ai_gen_id }}">{{ heading }}</h3>
        {% endif %}
        
        {% if description != blank %}
          <p class="ai-feature-block__description-{{ ai_gen_id }}">{{ description }}</p>
        {% endif %}
      </div>
    {% endfor %}
  </div>
</feature-blocks-{{ ai_gen_id }}>

<script>
  (function() {
    class FeatureBlocks{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.blocks = this.querySelectorAll('.ai-feature-block-{{ ai_gen_id }}');
        this.setupEventListeners();
      }

      setupEventListeners() {
        this.blocks.forEach((block) => {
          block.addEventListener('click', () => {
            this.blocks.forEach((b) => b.classList.remove('active'));
            block.classList.add('active');
          });
        });
      }
    }

    customElements.define('feature-blocks-{{ ai_gen_id }}', FeatureBlocks{{ ai_gen_id }});
  })();
</script>

