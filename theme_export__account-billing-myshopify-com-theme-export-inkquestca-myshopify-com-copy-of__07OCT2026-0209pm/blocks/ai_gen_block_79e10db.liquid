{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
  }

  .ai-header-{{ ai_gen_id }}.transparent {
    background-color: transparent;
  }

  .ai-header-{{ ai_gen_id }}.scrolled {
    background-color: {{ block.settings.scrolled_bg_color }};
    box-shadow: 0 2px 8px rgba(0, 0, 0, 0.1);
  }

  .ai-header-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.header_padding }}px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ai-header-logo-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-header-logo-{{ ai_gen_id }} img {
    display: block;
    max-width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-header-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 40px;
    background-color: rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    font-size: 12px;
    color: #666;
  }

  .ai-header-nav-{{ ai_gen_id }} {
    flex-grow: 1;
    display: flex;
    justify-content: center;
  }

  .ai-header-menu-{{ ai_gen_id }} {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    gap: {{ block.settings.menu_spacing }}px;
  }

  .ai-header-menu-item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-header-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.menu_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.menu_font_size }}px;
    font-weight: {{ block.settings.menu_font_weight }};
    padding: 8px 12px;
    display: block;
    transition: color 0.3s ease;
  }

  .ai-header-{{ ai_gen_id }}.scrolled .ai-header-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.scrolled_menu_text_color }};
  }

  .ai-header-menu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.menu_hover_color }};
  }

  .ai-header-actions-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 16px;
  }

  .ai-header-icon-btn-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    gap: 6px;
    color: {{ block.settings.icon_color }};
    transition: color 0.3s ease;
  }

  .ai-header-{{ ai_gen_id }}.scrolled .ai-header-icon-btn-{{ ai_gen_id }} {
    color: {{ block.settings.scrolled_icon_color }};
  }

  .ai-header-icon-btn-{{ ai_gen_id }}:hover {
    color: {{ block.settings.icon_hover_color }};
  }

  .ai-header-icon-{{ ai_gen_id }} {
    width: 24px;
    height: 24px;
  }

  .ai-header-lang-text-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
  }

  .ai-header-mobile-toggle-{{ ai_gen_id }} {
    display: none;
  }

  .ai-header-mobile-menu-{{ ai_gen_id }} {
    display: none;
  }

  @media screen and (max-width: 989px) {
    .ai-header-nav-{{ ai_gen_id }} {
      display: none;
    }

    .ai-header-actions-{{ ai_gen_id }} {
      display: none;
    }

    .ai-header-mobile-toggle-{{ ai_gen_id }} {
      display: block;
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      color: {{ block.settings.icon_color }};
    }

    .ai-header-{{ ai_gen_id }}.scrolled .ai-header-mobile-toggle-{{ ai_gen_id }} {
      color: {{ block.settings.scrolled_icon_color }};
    }

    .ai-header-hamburger-{{ ai_gen_id }} {
      width: 24px;
      height: 20px;
      position: relative;
      display: flex;
      flex-direction: column;
      justify-content: space-between;
    }

    .ai-header-hamburger-line-{{ ai_gen_id }} {
      width: 100%;
      height: 2px;
      background-color: currentColor;
      transition: all 0.3s ease;
    }

    .ai-header-mobile-menu-{{ ai_gen_id }} {
      position: fixed;
      top: 0;
      right: -100%;
      width: 80%;
      max-width: 400px;
      height: 100vh;
      background-color: {{ block.settings.mobile_menu_bg }};
      box-shadow: -2px 0 8px rgba(0, 0, 0, 0.1);
      transition: right 0.3s ease;
      z-index: 1001;
      overflow-y: auto;
    }

    .ai-header-mobile-menu-{{ ai_gen_id }}.active {
      right: 0;
    }

    .ai-header-mobile-header-{{ ai_gen_id }} {
      display: flex;
      justify-content: space-between;
      align-items: center;
      padding: 20px;
      border-bottom: 1px solid rgba(0, 0, 0, 0.1);
    }

    .ai-header-mobile-close-{{ ai_gen_id }} {
      background: none;
      border: none;
      cursor: pointer;
      padding: 8px;
      color: {{ block.settings.mobile_menu_text_color }};
    }

    .ai-header-mobile-nav-{{ ai_gen_id }} {
      padding: 20px;
    }

    .ai-header-mobile-menu-list-{{ ai_gen_id }} {
      list-style: none;
      margin: 0;
      padding: 0;
    }

    .ai-header-mobile-menu-item-{{ ai_gen_id }} {
      margin-bottom: 8px;
    }

    .ai-header-mobile-menu-link-{{ ai_gen_id }} {
      color: {{ block.settings.mobile_menu_text_color }};
      text-decoration: none;
      font-size: 16px;
      padding: 12px 0;
      display: block;
      transition: color 0.3s ease;
    }

    .ai-header-mobile-menu-link-{{ ai_gen_id }}:hover {
      color: {{ block.settings.menu_hover_color }};
    }

    .ai-header-mobile-actions-{{ ai_gen_id }} {
      padding: 20px;
      border-top: 1px solid rgba(0, 0, 0, 0.1);
      display: flex;
      flex-direction: column;
      gap: 16px;
    }

    .ai-header-overlay-{{ ai_gen_id }} {
      position: fixed;
      top: 0;
      left: 0;
      right: 0;
      bottom: 0;
      background-color: rgba(0, 0, 0, 0.5);
      opacity: 0;
      visibility: hidden;
      transition: opacity 0.3s ease, visibility 0.3s ease;
      z-index: 1000;
    }

    .ai-header-overlay-{{ ai_gen_id }}.active {
      opacity: 1;
      visibility: visible;
    }
  }
{% endstyle %}

<transparent-header-{{ ai_gen_id }}
  class="ai-header-{{ ai_gen_id }} transparent"
  {{ block.shopify_attributes }}
>
  <div class="ai-header-container-{{ ai_gen_id }}">
    <div class="ai-header-logo-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <a href="/">
          <img
            src="{{ block.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            width="{{ block.settings.logo_width }}"
            height="auto"
            loading="eager"
          >
        </a>
      {% else %}
        <div class="ai-header-logo-placeholder-{{ ai_gen_id }}">
          Logo
        </div>
      {% endif %}
    </div>

    <nav class="ai-header-nav-{{ ai_gen_id }}">
      {% if block.settings.menu != blank %}
        <ul class="ai-header-menu-{{ ai_gen_id }}">
          {% for link in linklists[block.settings.menu].links %}
            <li class="ai-header-menu-item-{{ ai_gen_id }}">
              <a href="{{ link.url }}" class="ai-header-menu-link-{{ ai_gen_id }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <div class="ai-header-actions-{{ ai_gen_id }}">
      <a href="/account" class="ai-header-icon-btn-{{ ai_gen_id }}" aria-label="Account">
        <svg class="ai-header-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
      </a>

      <button class="ai-header-icon-btn-{{ ai_gen_id }} ai-header-lang-toggle-{{ ai_gen_id }}" aria-label="Change language">
        <svg class="ai-header-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span class="ai-header-lang-text-{{ ai_gen_id }}">EN/FR</span>
      </button>
    </div>

    <button class="ai-header-mobile-toggle-{{ ai_gen_id }}" aria-label="Open menu">
      <div class="ai-header-hamburger-{{ ai_gen_id }}">
        <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
        <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
        <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
      </div>
    </button>
  </div>

  <div class="ai-header-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-header-mobile-menu-{{ ai_gen_id }}">
    <div class="ai-header-mobile-header-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <img
          src="{{ block.settings.logo | image_url: width: 200 }}"
          alt="{{ shop.name }}"
          width="{{ block.settings.logo_width | times: 0.8 }}"
          height="auto"
        >
      {% else %}
        <div>Logo</div>
      {% endif %}
      <button class="ai-header-mobile-close-{{ ai_gen_id }}" aria-label="Close menu">
        <svg width="24" height="24" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <line x1="18" y1="6" x2="6" y2="18"></line>
          <line x1="6" y1="6" x2="18" y2="18"></line>
        </svg>
      </button>
    </div>

    <nav class="ai-header-mobile-nav-{{ ai_gen_id }}">
      {% if block.settings.menu != blank %}
        <ul class="ai-header-mobile-menu-list-{{ ai_gen_id }}">
          {% for link in linklists[block.settings.menu].links %}
            <li class="ai-header-mobile-menu-item-{{ ai_gen_id }}">
              <a href="{{ link.url }}" class="ai-header-mobile-menu-link-{{ ai_gen_id }}">
                {{ link.title }}
              </a>
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

    <div class="ai-header-mobile-actions-{{ ai_gen_id }}">
      <a href="/account" class="ai-header-icon-btn-{{ ai_gen_id }}" style="color: {{ block.settings.mobile_menu_text_color }};">
        <svg class="ai-header-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"></path>
          <circle cx="12" cy="7" r="4"></circle>
        </svg>
        <span>Account</span>
      </a>

      <button class="ai-header-icon-btn-{{ ai_gen_id }} ai-header-mobile-lang-toggle-{{ ai_gen_id }}" style="color: {{ block.settings.mobile_menu_text_color }};">
        <svg class="ai-header-icon-{{ ai_gen_id }}" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
          <circle cx="12" cy="12" r="10"></circle>
          <line x1="2" y1="12" x2="22" y2="12"></line>
          <path d="M12 2a15.3 15.3 0 0 1 4 10 15.3 15.3 0 0 1-4 10 15.3 15.3 0 0 1-4-10 15.3 15.3 0 0 1 4-10z"></path>
        </svg>
        <span class="ai-header-lang-text-{{ ai_gen_id }}">EN/FR</span>
      </button>
    </div>
  </div>
</transparent-header-{{ ai_gen_id }}>

<script>
  (function() {
    class TransparentHeader{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.header = this;
        this.mobileToggle = this.querySelector('.ai-header-mobile-toggle-{{ ai_gen_id }}');
        this.mobileMenu = this.querySelector('.ai-header-mobile-menu-{{ ai_gen_id }}');
        this.mobileClose = this.querySelector('.ai-header-mobile-close-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-header-overlay-{{ ai_gen_id }}');
        this.langToggle = this.querySelector('.ai-header-lang-toggle-{{ ai_gen_id }}');
        this.mobileLangToggle = this.querySelector('.ai-header-mobile-lang-toggle-{{ ai_gen_id }}');
        this.currentLang = 'en';
      }

      connectedCallback() {
        this.setupScrollListener();
        this.setupMobileMenu();
        this.setupLanguageToggle();
      }

      setupScrollListener() {
        let lastScroll = 0;
        window.addEventListener('scroll', () => {
          const currentScroll = window.pageYOffset;
          
          if (currentScroll > 50) {
            this.header.classList.add('scrolled');
            this.header.classList.remove('transparent');
          } else {
            this.header.classList.remove('scrolled');
            this.header.classList.add('transparent');
          }
          
          lastScroll = currentScroll;
        });
      }

      setupMobileMenu() {
        this.mobileToggle.addEventListener('click', () => {
          this.mobileMenu.classList.add('active');
          this.overlay.classList.add('active');
          document.body.style.overflow = 'hidden';
        });

        this.mobileClose.addEventListener('click', () => {
          this.closeMobileMenu();
        });

        this.overlay.addEventListener('click', () => {
          this.closeMobileMenu();
        });

        const mobileLinks = this.querySelectorAll('.ai-header-mobile-menu-link-{{ ai_gen_id }}');
        mobileLinks.forEach(link => {
          link.addEventListener('click', () => {
            this.closeMobileMenu();
          });
        });
      }

      closeMobileMenu() {
        this.mobileMenu.classList.remove('active');
        this.overlay.classList.remove('active');
        document.body.style.overflow = '';
      }

      setupLanguageToggle() {
        const toggleLanguage = () => {
          this.currentLang = this.currentLang === 'en' ? 'fr' : 'en';
          
          const langTexts = this.querySelectorAll('.ai-header-lang-text-{{ ai_gen_id }}');
          langTexts.forEach(text => {
            text.textContent = this.currentLang === 'en' ? 'EN/FR' : 'FR/EN';
          });

          console.log('Language switched to:', this.currentLang);
        };

        if (this.langToggle) {
          this.langToggle.addEventListener('click', toggleLanguage);
        }

        if (this.mobileLangToggle) {
          this.mobileLangToggle.addEventListener('click', toggleLanguage);
        }
      }
    }

    customElements.define('transparent-header-{{ ai_gen_id }}', TransparentHeader{{ ai_gen_id }});
  })();
</script>

