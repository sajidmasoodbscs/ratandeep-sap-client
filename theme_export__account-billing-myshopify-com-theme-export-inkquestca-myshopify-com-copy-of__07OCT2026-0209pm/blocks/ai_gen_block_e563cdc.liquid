    },
    {
      "type": "text",
      "id": "menu_link_2_text",
      "label": "Link 2 text",
      "default": "Shop"
    },
    {
      "type": "url",
      "id": "menu_link_2_url",
      "label": "Link 2 URL"
    },
    {
      "type": "text",
      "id": "menu_link_3_text",
      "label": "Link 3 text",
      "default": "About"
    },
    {
      "type": "url",
      "id": "menu_link_3_url",
      "label": "Link 3 URL"
    },
    {
      "type": "text",
      "id": "menu_link_4_text",
      "label": "Link 4 text",
      "default": "Contact"
    },
    {
      "type": "url",
      "id": "menu_link_4_url",
      "label": "Link 4 URL"
    },
    {
      "type": "text",
      "id": "menu_link_5_text",
      "label": "Link 5 text"
    },
    {
      "type": "url",
      "id": "menu_link_5_url",
