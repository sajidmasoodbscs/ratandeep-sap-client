      "default": 120
    },
    {
      "type": "header",
      "content": "Layout"
    },
    {
      "type": "range",
      "id": "max_width",
      "min": 1000,
      "max": 1600,
      "step": 100,
      "unit": "px",
      "label": "Maximum width",
      "default": 1200
    },
    {
      "type": "range",
      "id": "padding_vertical",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Vertical padding",
      "default": 20
    },
    {
      "type": "range",
      "id": "padding_horizontal",
      "min": 10,
      "max": 50,
      "step": 5,
      "unit": "px",
      "label": "Horizontal padding",
      "default": 20
    },
    {
      "type": "header",
      "content": "Hamburger menu"
    },
    {
      "type": "range",
      "id": "hamburger_width",
      "min": 20,
      "max": 40,
      "step": 2,
      "unit": "px",
      "label": "Width",
      "default": 30
    },
    {
      "type": "range",
      "id": "hamburger_thickness",
      "min": 2,
      "max": 6,
      "step": 1,
      "unit": "px",
      "label": "Line thickness",
      "default": 3
    },
    {
      "type": "range",
