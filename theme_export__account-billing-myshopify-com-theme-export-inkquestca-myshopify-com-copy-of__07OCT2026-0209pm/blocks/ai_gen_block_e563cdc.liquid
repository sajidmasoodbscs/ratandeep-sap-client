{% doc %}
  @prompt
    create header those have logo in left side and right side hamburger menu with transparent section 
{% enddoc %}
{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    background-color: transparent;
    padding: {{ block.settings.padding_vertical }}px {{ block.settings.padding_horizontal }}px;
    z-index: 100;
  }

  .ai-header-container-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    max-width: {{ block.settings.max_width }}px;
    margin: 0 auto;
  }

  .ai-header-logo-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-header-logo-{{ ai_gen_id }} img {
    display: block;
    width: {{ block.settings.logo_width }}px;
    height: auto;
  }

  .ai-header-logo-placeholder-{{ ai_gen_id }} {
    width: {{ block.settings.logo_width }}px;
    height: 60px;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-header-logo-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: contain;
  }

  .ai-header-hamburger-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.hamburger_gap }}px;
    z-index: 101;
  }

  .ai-header-hamburger-line-{{ ai_gen_id }} {
    width: {{ block.settings.hamburger_width }}px;
    height: {{ block.settings.hamburger_thickness }}px;
    background-color: {{ block.settings.hamburger_color }};
    transition: all 0.3s ease;
  }

  .ai-header-hamburger-{{ ai_gen_id }}:hover .ai-header-hamburger-line-{{ ai_gen_id }} {
    background-color: {{ block.settings.hamburger_hover_color }};
  }

  .ai-header-menu-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    right: -100%;
    width: {{ block.settings.menu_width }}%;
    height: 100vh;
    background-color: {{ block.settings.menu_background_color }};
    transition: right 0.3s ease;
    z-index: 100;
    overflow-y: auto;
    padding: 80px 30px 30px;
  }

  .ai-header-menu-{{ ai_gen_id }}.active {
    right: 0;
  }

  .ai-header-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease;
    z-index: 99;
  }

  .ai-header-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-header-menu-list-{{ ai_gen_id }} {
    list-style: none;
    padding: 0;
    margin: 0;
  }

  .ai-header-menu-item-{{ ai_gen_id }} {
    margin-bottom: 20px;
  }

  .ai-header-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.menu_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.menu_font_size }}px;
    display: block;
    padding: 10px 0;
    transition: color 0.3s ease;
  }

  .ai-header-menu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.menu_hover_color }};
  }

  .ai-header-close-{{ ai_gen_id }} {
    position: absolute;
    top: 20px;
    right: 20px;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.menu_text_color }};
  }

  .ai-header-close-{{ ai_gen_id }}:hover {
    color: {{ block.settings.menu_hover_color }};
  }

  @media screen and (max-width: 749px) {
    .ai-header-menu-{{ ai_gen_id }} {
      width: 80%;
    }

    .ai-header-logo-{{ ai_gen_id }} img {
      width: {{ block.settings.logo_width | times: 0.8 }}px;
    }

    .ai-header-logo-placeholder-{{ ai_gen_id }} {
      width: {{ block.settings.logo_width | times: 0.8 }}px;
    }
  }
{% endstyle %}

<header-menu-{{ ai_gen_id }} class="ai-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-container-{{ ai_gen_id }}">
    <div class="ai-header-logo-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <a href="/">
          <img
            src="{{ block.settings.logo | image_url: width: 400 }}"
            alt="{{ shop.name }}"
            width="{{ block.settings.logo_width }}"
            height="auto"
            loading="lazy"
          >
        </a>
      {% else %}
        <div class="ai-header-logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <button
      class="ai-header-hamburger-{{ ai_gen_id }}"
      aria-label="Open menu"
      aria-expanded="false"
    >
      <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
      <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
      <span class="ai-header-hamburger-line-{{ ai_gen_id }}"></span>
    </button>
  </div>

  <div class="ai-header-overlay-{{ ai_gen_id }}"></div>

  <nav class="ai-header-menu-{{ ai_gen_id }}">
    <button
      class="ai-header-close-{{ ai_gen_id }}"
      aria-label="Close menu"
    >
      <svg
        xmlns="http://www.w3.org/2000/svg"
        width="30"
        height="30"
        viewBox="0 0 24 24"
        fill="none"
        stroke="currentColor"
        stroke-width="2"
        stroke-linecap="round"
        stroke-linejoin="round"
      >
        <line x1="18" y1="6" x2="6" y2="18"></line>
        <line x1="6" y1="6" x2="18" y2="18"></line>
      </svg>
    </button>

    <ul class="ai-header-menu-list-{{ ai_gen_id }}">
      {% if block.settings.menu_link_1_text != blank %}
        <li class="ai-header-menu-item-{{ ai_gen_id }}">
          <a href="{{ block.settings.menu_link_1_url }}" class="ai-header-menu-link-{{ ai_gen_id }}">
            {{ block.settings.menu_link_1_text }}
          </a>
        </li>
      {% endif %}

      {% if block.settings.menu_link_2_text != blank %}
        <li class="ai-header-menu-item-{{ ai_gen_id }}">
          <a href="{{ block.settings.menu_link_2_url }}" class="ai-header-menu-link-{{ ai_gen_id }}">
            {{ block.settings.menu_link_2_text }}
          </a>
        </li>
      {% endif %}

      {% if block.settings.menu_link_3_text != blank %}
        <li class="ai-header-menu-item-{{ ai_gen_id }}">
          <a href="{{ block.settings.menu_link_3_url }}" class="ai-header-menu-link-{{ ai_gen_id }}">
            {{ block.settings.menu_link_3_text }}
          </a>
        </li>
      {% endif %}

      {% if block.settings.menu_link_4_text != blank %}
        <li class="ai-header-menu-item-{{ ai_gen_id }}">
          <a href="{{ block.settings.menu_link_4_url }}" class="ai-header-menu-link-{{ ai_gen_id }}">
            {{ block.settings.menu_link_4_text }}
          </a>
        </li>
      {% endif %}

      {% if block.settings.menu_link_5_text != blank %}
        <li class="ai-header-menu-item-{{ ai_gen_id }}">
          <a href="{{ block.settings.menu_link_5_url }}" class="ai-header-menu-link-{{ ai_gen_id }}">
            {{ block.settings.menu_link_5_text }}
          </a>
        </li>
      {% endif %}
    </ul>
  </nav>
</header-menu-{{ ai_gen_id }}>

<script>
  (function() {
    class HeaderMenu{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
      }

      connectedCallback() {
        this.hamburger = this.querySelector('.ai-header-hamburger-{{ ai_gen_id }}');
        this.menu = this.querySelector('.ai-header-menu-{{ ai_gen_id }}');
        this.overlay = this.querySelector('.ai-header-overlay-{{ ai_gen_id }}');
        this.closeButton = this.querySelector('.ai-header-close-{{ ai_gen_id }}');

        this.setupEventListeners();
      }

      setupEventListeners() {
        this.hamburger.addEventListener('click', () => this.openMenu());
        this.closeButton.addEventListener('click', () => this.closeMenu());
        this.overlay.addEventListener('click', () => this.closeMenu());

        document.addEventListener('keydown', (e) => {
          if (e.key === 'Escape' && this.menu.classList.contains('active')) {
            this.closeMenu();
          }
        });
      }

      openMenu() {
        this.menu.classList.add('active');
        this.overlay.classList.add('active');
        this.hamburger.setAttribute('aria-expanded', 'true');
        document.body.style.overflow = 'hidden';
      }

      closeMenu() {
        this.menu.classList.remove('active');
        this.overlay.classList.remove('active');
        this.hamburger.setAttribute('aria-expanded', 'false');
        document.body.style.overflow = '';
      }
    }

    customElements.define('header-menu-{{ ai_gen_id }}', HeaderMenu{{ ai_gen_id }});
  })();
</script>

{% schema %}
{
  "name": "Transparent header",
  "tag": null,
  "settings": [
    {
      "type": "header",
      "content": "Logo"
    },
    {
      "type": "image_picker",
      "id": "logo",
      "label": "Logo image"
    },
    {
      "type": "range",
      "id": "logo_width",
      "min": 50,
      "max": 300,
      "step": 10,
