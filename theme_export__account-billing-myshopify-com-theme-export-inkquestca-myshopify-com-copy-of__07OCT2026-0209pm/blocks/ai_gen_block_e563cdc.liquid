      "min": 30,
      "max": 100,
      "step": 5,
      "unit": "%",
      "label": "Width",
      "default": 40
    },
    {
      "type": "color",
      "id": "menu_background_color",
      "label": "Background color",
      "default": "#ffffff"
    },
    {
      "type": "color",
      "id": "menu_text_color",
      "label": "Text color",
      "default": "#121212"
    },
    {
      "type": "color",
      "id": "menu_hover_color",
      "label": "Hover color",
      "default": "#666666"
    },
    {
      "type": "range",
      "id": "menu_font_size",
      "min": 14,
      "max": 30,
      "step": 2,
      "unit": "px",
      "label": "Font size",
      "default": 18
    },
    {
      "type": "header",
      "content": "Menu links"
    },
    {
      "type": "text",
      "id": "menu_link_1_text",
      "label": "Link 1 text",
      "default": "Home"
    },
    {
      "type": "url",
      "id": "menu_link_1_url",
