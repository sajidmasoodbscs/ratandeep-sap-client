{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-brand-slider-{{ ai_gen_id }} {
    width: 100%;
    overflow: hidden;
    padding: {{ block.settings.section_padding }}px 0;
    background-color: {{ block.settings.background_color }};
  }

  .ai-brand-slider__container-{{ ai_gen_id }} {
    max-width: 75%;
    margin: 0 auto;
    padding: 0 20px;
  }

  .ai-brand-slider__heading-{{ ai_gen_id }} {
    text-align: center;
    margin-bottom: 0px;
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
  }

  .ai-brand-slider__wrapper-{{ ai_gen_id }} {
    position: relative;
    overflow: hidden;
  }

  .ai-brand-slider__track-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.icon_gap }}px;
    transition: transform 0.5s ease;
  }

  .ai-brand-slider__item-{{ ai_gen_id }} {
    flex: 0 0 calc((100% - ({{ block.settings.icon_gap }}px * ({{ block.settings.icons_per_row_desktop }} - 1))) / {{ block.settings.icons_per_row_desktop }});
    display: flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.icon_padding }}px;
    background-color: {{ block.settings.icon_background }};
    border-radius: {{ block.settings.icon_border_radius }}px;
    transition: all 0.3s ease;
  }

  .ai-brand-slider__item-{{ ai_gen_id }}:hover {
    transform: translateY(-5px);
    box-shadow: 0 5px 15px rgba(0, 0, 0, 0.1);
  }

  .ai-brand-slider__image-wrapper-{{ ai_gen_id }} {
    width: 100%;
    height: {{ block.settings.icon_height }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-brand-slider__image-{{ ai_gen_id }} {
    max-width: 100%;
    max-height: 100%;
    width: auto;
    height: auto;
    object-fit: contain;
    transition: opacity 0.3s ease;
  }

  .ai-brand-slider__image-color-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    opacity: 0;
    transition: opacity 0.3s ease;
  }

  .ai-brand-slider__item-{{ ai_gen_id }}:hover .ai-brand-slider__image-gray-{{ ai_gen_id }} {
    opacity: 0;
  }

  .ai-brand-slider__item-{{ ai_gen_id }}:hover .ai-brand-slider__image-color-{{ ai_gen_id }} {
    opacity: 1;
  }

  .ai-brand-slider__navigation-{{ ai_gen_id }} {
    display: flex;
    justify-content: center;
    align-items: center;
    gap: 20px;
    margin-top: 30px;
  }

  .ai-brand-slider__nav-button-{{ ai_gen_id }} {
    width: 40px;
    height: 40px;
    border-radius: 50%;
    background-color: {{ block.settings.nav_button_color }};
    color: {{ block.settings.nav_button_icon_color }};
    border: none;
    cursor: pointer;
    display: flex;
    align-items: center;
    justify-content: center;
    transition: all 0.3s ease;
  }

  .ai-brand-slider__nav-button-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.nav_button_hover_color }};
    transform: scale(1.1);
  }

  .ai-brand-slider__nav-button-{{ ai_gen_id }}:disabled {
    opacity: 0.3;
    cursor: not-allowed;
  }

  .ai-brand-slider__nav-button-{{ ai_gen_id }}:disabled:hover {
    transform: scale(1);
  }

  .ai-brand-slider__dots-{{ ai_gen_id }} {
    display: flex;
    gap: 8px;
  }

  .ai-brand-slider__dot-{{ ai_gen_id }} {
    width: 10px;
    height: 10px;
    border-radius: 50%;
    background-color: {{ block.settings.dot_color }};
    opacity: 0.3;
    border: none;
    cursor: pointer;
    padding: 0;
    transition: all 0.3s ease;
  }

  .ai-brand-slider__dot-{{ ai_gen_id }}.active {
    opacity: 1;
    transform: scale(1.2);
  }

  .ai-brand-slider__empty-state-{{ ai_gen_id }} {
    text-align: center;
    padding: 40px 20px;
    color: #666;
    font-size: 14px;
  }

  @media screen and (max-width: 749px) {
    .ai-brand-slider__item-{{ ai_gen_id }} {
      flex: 0 0 calc((100% - ({{ block.settings.icon_gap }}px * ({{ block.settings.icons_per_row_mobile }} - 1))) / {{ block.settings.icons_per_row_mobile }});
    }
  .ai-brand-slider__container-{{ ai_gen_id }} {
    max-width: 100%;
    margin: 0 auto;
    padding: 0 20px;
  }
    {% if block.settings.enable_mobile_auto_scroll %}
      .ai-brand-slider__track-{{ ai_gen_id }} {
        animation: ai-brand-slider-scroll-{{ ai_gen_id }} {{ block.settings.slider_speed }}s linear infinite;
      }

      .ai-brand-slider__wrapper-{{ ai_gen_id }}:hover .ai-brand-slider__track-{{ ai_gen_id }} {
        animation-play-state: paused;
      }

      @keyframes ai-brand-slider-scroll-{{ ai_gen_id }} {
        0% {
          transform: translateX(0);
        }
        100% {
          transform: translateX(calc(-100% - {{ block.settings.icon_gap }}px));
        }
      }
    {% endif %}
  }
{% endstyle %}

<brand-slider-{{ ai_gen_id }} class="ai-brand-slider-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-brand-slider__container-{{ ai_gen_id }}">
    {% if block.settings.heading != blank %}
      <h2 class="ai-brand-slider__heading-{{ ai_gen_id }}">{{ block.settings.heading }}</h2>
      
    {% endif %}
      {% if block.settings.dec2 != blank %}
      <p style="text-align: center;">{{ block.settings.dec2 }}</p>
    
    {% endif %}

    {% assign has_icons = false %}
    {% assign icon_count = 0 %}
    {% for i in (1..10) %}
      {% assign icon_key = 'icon_' | append: i %}
      {% if block.settings[icon_key] != blank %}
        {% assign has_icons = true %}
        {% assign icon_count = icon_count | plus: 1 %}
      {% endif %}
    {% endfor %}

    {% if has_icons %}
      <div class="ai-brand-slider__wrapper-{{ ai_gen_id }}">
        <div class="ai-brand-slider__track-{{ ai_gen_id }}" data-slider-track>
          {% for i in (1..10) %}
            {% assign icon_key = 'icon_' | append: i %}
            {% if block.settings[icon_key] != blank %}
              <div class="ai-brand-slider__item-{{ ai_gen_id }}" data-slide-item>
                <div class="ai-brand-slider__image-wrapper-{{ ai_gen_id }}">
                  <img
                    src="{{ block.settings[icon_key] | image_url: width: 400 }}"
                    alt="{{ block.settings[icon_key].alt | escape }}"
                    loading="lazy"
                    class="ai-brand-slider__image-{{ ai_gen_id }} ai-brand-slider__image-gray-{{ ai_gen_id }}"
                    style="filter: grayscale(100%);"
                  >
                  <img
                    src="{{ block.settings[icon_key] | image_url: width: 400 }}"
                    alt="{{ block.settings[icon_key].alt | escape }}"
                    loading="lazy"
                    class="ai-brand-slider__image-{{ ai_gen_id }} ai-brand-slider__image-color-{{ ai_gen_id }}"
                  >
                </div>
              </div>
            {% endif %}
          {% endfor %}

          {% for i in (1..10) %}
            {% assign icon_key = 'icon_' | append: i %}
            {% if block.settings[icon_key] != blank %}
              <div class="ai-brand-slider__item-{{ ai_gen_id }}" data-slide-duplicate>
                <div class="ai-brand-slider__image-wrapper-{{ ai_gen_id }}">
                  <img
                    src="{{ block.settings[icon_key] | image_url: width: 400 }}"
                    alt="{{ block.settings[icon_key].alt | escape }}"
                    loading="lazy"
                    class="ai-brand-slider__image-{{ ai_gen_id }} ai-brand-slider__image-gray-{{ ai_gen_id }}"
                    style="filter: grayscale(100%);"
                  >
                  <img
                    src="{{ block.settings[icon_key] | image_url: width: 400 }}"
                    alt="{{ block.settings[icon_key].alt | escape }}"
                    loading="lazy"
                    class="ai-brand-slider__image-{{ ai_gen_id }} ai-brand-slider__image-color-{{ ai_gen_id }}"
                  >
                </div>
              </div>
            {% endif %}
          {% endfor %}
        </div>
      </div>

      <div class="ai-brand-slider__navigation-{{ ai_gen_id }}" data-navigation>
        <button 
          class="ai-brand-slider__nav-button-{{ ai_gen_id }}" 
          data-prev-button
          aria-label="Previous slide"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="15 18 9 12 15 6"></polyline>
          </svg>
        </button>

        <div class="ai-brand-slider__dots-{{ ai_gen_id }}" data-dots></div>

        <button 
          class="ai-brand-slider__nav-button-{{ ai_gen_id }}" 
          data-next-button
          aria-label="Next slide"
        >
          <svg width="20" height="20" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <polyline points="9 18 15 12 9 6"></polyline>
          </svg>
        </button>
      </div>
    {% else %}
      <div class="ai-brand-slider__empty-state-{{ ai_gen_id }}">
        Add brand icons to get started
      </div>
    {% endif %}
  </div>
</brand-slider-{{ ai_gen_id }}>

<script>
  (function() {
    class BrandSlider{{ ai_gen_id }} extends HTMLElement {
      constructor() {
        super();
        this.currentPage = 0;
        this.iconsPerPage = {{ block.settings.icons_per_row_desktop }};
        this.totalIcons = 0;
        this.totalPages = 0;
        this.isDesktop = window.innerWidth > 749;
      }

      connectedCallback() {
        this.track = this.querySelector('[data-slider-track]');
        this.prevButton = this.querySelector('[data-prev-button]');
        this.nextButton = this.querySelector('[data-next-button]');
        this.dotsContainer = this.querySelector('[data-dots]');
        this.navigation = this.querySelector('[data-navigation]');

        if (!this.track) return;

        this.init();

        window.addEventListener('resize', () => {
          const wasDesktop = this.isDesktop;
          this.isDesktop = window.innerWidth > 749;
          if (wasDesktop !== this.isDesktop) {
            this.init();
          }
        });
      }

      init() {
        if (this.isDesktop) {
          this.setupDesktopSlider();
        } else {
          this.setupMobileSlider();
        }
      }

      setupDesktopSlider() {
        const items = this.querySelectorAll('[data-slide-item]');
        this.totalIcons = items.length;
        this.totalPages = Math.ceil(this.totalIcons / this.iconsPerPage);

        const duplicates = this.querySelectorAll('[data-slide-duplicate]');
        duplicates.forEach(dup => dup.style.display = 'none');

        if (this.totalPages <= 1) {
          if (this.navigation) {
            this.navigation.style.display = 'none';
          }
          this.track.style.transform = 'translateX(0)';
          return;
        }

        if (this.navigation) {
          this.navigation.style.display = 'flex';
        }

        this.createDots();
        this.updateSlider();

        if (this.prevButton) {
          this.prevButton.removeEventListener('click', this.boundPrevSlide);
          this.boundPrevSlide = () => this.prevSlide();
          this.prevButton.addEventListener('click', this.boundPrevSlide);
        }

        if (this.nextButton) {
          this.nextButton.removeEventListener('click', this.boundNextSlide);
          this.boundNextSlide = () => this.nextSlide();
          this.nextButton.addEventListener('click', this.boundNextSlide);
        }
      }

      setupMobileSlider() {
        const duplicates = this.querySelectorAll('[data-slide-duplicate]');
        duplicates.forEach(dup => dup.style.display = 'flex');

        if (this.navigation) {
          this.navigation.style.display = 'none';
        }

        this.track.style.transform = 'translateX(0)';

        const enableAutoScroll = {{ block.settings.enable_mobile_auto_scroll | json }};
        if (!enableAutoScroll) return;

        this.track.addEventListener('mouseenter', () => {
          this.track.style.animationPlayState = 'paused';
        });

        this.track.addEventListener('mouseleave', () => {
          this.track.style.animationPlayState = 'running';
        });

        this.track.addEventListener('touchstart', () => {
          this.track.style.animationPlayState = 'paused';
        });

        this.track.addEventListener('touchend', () => {
          this.track.style.animationPlayState = 'running';
        });
      }

      createDots() {
        if (!this.dotsContainer) return;
        
        this.dotsContainer.innerHTML = '';
        
        for (let i = 0; i < this.totalPages; i++) {
          const dot = document.createElement('button');
          dot.className = 'ai-brand-slider__dot-{{ ai_gen_id }}';
          dot.setAttribute('aria-label', 'Go to slide ' + (i + 1));
          if (i === 0) {
            dot.classList.add('active');
          }
          dot.addEventListener('click', () => this.goToPage(i));
          this.dotsContainer.appendChild(dot);
        }
      }

      updateSlider() {
        const itemWidth = this.track.querySelector('[data-slide-item]').offsetWidth;
        const gap = {{ block.settings.icon_gap }};
        const offset = this.currentPage * this.iconsPerPage * (itemWidth + gap);
        
        this.track.style.transform = `translateX(-${offset}px)`;

        if (this.prevButton) {
          this.prevButton.disabled = this.currentPage === 0;
        }

        if (this.nextButton) {
          this.nextButton.disabled = this.currentPage === this.totalPages - 1;
        }

        const dots = this.dotsContainer.querySelectorAll('.ai-brand-slider__dot-{{ ai_gen_id }}');
        dots.forEach((dot, index) => {
          if (index === this.currentPage) {
            dot.classList.add('active');
          } else {
            dot.classList.remove('active');
          }
        });
      }

      nextSlide() {
        if (this.currentPage < this.totalPages - 1) {
          this.currentPage++;
          this.updateSlider();
        }
      }

      prevSlide() {
        if (this.currentPage > 0) {
          this.currentPage--;
          this.updateSlider();
        }
      }

      goToPage(pageIndex) {
        this.currentPage = pageIndex;
        this.updateSlider();
      }
    }

    customElements.define('brand-slider-{{ ai_gen_id }}', BrandSlider{{ ai_gen_id }});
  })();
</script>

