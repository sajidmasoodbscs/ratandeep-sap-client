{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-content-image-section-{{ ai_gen_id }} {
    position: relative;
    width: 100%;
    overflow: hidden;
  }

  .ai-content-image-bg-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    z-index: 0;
  }

  .ai-content-image-bg-{{ ai_gen_id }} img {
    width: 100%;
    height: 100%;
    /* object-fit: cover; */
  }

  .ai-content-image-bg-placeholder-{{ ai_gen_id }} {
    width: 100%;
    height: 100%;
    background-color: #f4f4f4;
  }

  .ai-content-image-bg-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    /* object-fit: cover; */
  }

  .ai-content-image-overlay-{{ ai_gen_id }} {
    position: absolute;
    top: 0;
    left: 0;
    width: 100%;
    height: 100%;
    background-color: {{ block.settings.overlay_color }};
    opacity: {{ block.settings.overlay_opacity | divided_by: 100.0 }};
    z-index: 1;
  }

  .ai-content-image-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: 75%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }

  .ai-content-image-wrapper-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: {{ block.settings.content_gap }}px;
  }

  .ai-content-image-wrapper-{{ ai_gen_id }}.ai-image-left-{{ ai_gen_id }} {
    flex-direction: row;
  }

  .ai-content-image-wrapper-{{ ai_gen_id }}.ai-image-right-{{ ai_gen_id }} {
    flex-direction: row-reverse;
  }

  .ai-content-image-content-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    flex-direction: column;
    gap: {{ block.settings.text_spacing }}px;
  }

  .ai-content-image-subheading-{{ ai_gen_id }} {
    font-size: {{ block.settings.subheading_size }}px;
    color: {{ block.settings.subheading_color }};
    margin: 0;
    text-transform: uppercase;
    letter-spacing: 1px;
    font-weight: 500;
  }

  .ai-content-image-heading-{{ ai_gen_id }} {
    font-size: {{ block.settings.heading_size }}px;
    color: {{ block.settings.heading_color }};
    margin: 0;
    line-height: 1.2;
        font-weight: 600;

  }

  .ai-content-image-description-{{ ai_gen_id }} {
    font-size: {{ block.settings.description_size }}px;
    color: {{ block.settings.description_color }};
    line-height: 1.6;
  }

  .ai-content-image-buttons-{{ ai_gen_id }} {
    display: flex;
    gap: {{ block.settings.button_spacing }}px;
    flex-wrap: wrap;
  }

  .ai-content-image-button-{{ ai_gen_id }} {
    display: inline-flex;
    align-items: center;
    justify-content: center;
    padding: {{ block.settings.button_padding_vertical }}px {{ block.settings.button_padding_horizontal }}px;
    font-size: {{ block.settings.button_font_size }}px;
    text-decoration: none;
    border-radius: {{ block.settings.button_border_radius }}px;
    transition: all 0.3s ease;
    border: 2px solid transparent;
    cursor: pointer;
  }

  .ai-content-image-button-primary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_1_bg_color }};
    color: {{ block.settings.button_1_text_color }};
    border-color: {{ block.settings.button_1_bg_color }};
  }

  .ai-content-image-button-primary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_1_hover_bg_color }};
    color: {{ block.settings.button_1_hover_text_color }};
    border-color: {{ block.settings.button_1_hover_bg_color }};
  }

  .ai-content-image-button-secondary-{{ ai_gen_id }} {
    background-color: {{ block.settings.button_2_bg_color }};
    color: {{ block.settings.button_2_text_color }};
    border-color: {{ block.settings.button_2_bg_color }};
  }

  .ai-content-image-button-secondary-{{ ai_gen_id }}:hover {
    background-color: {{ block.settings.button_2_hover_bg_color }};
    color: {{ block.settings.button_2_hover_text_color }};
    border-color: {{ block.settings.button_2_hover_bg_color }};
  }

  .ai-content-image-image-{{ ai_gen_id }} {
    flex: 1;
    display: flex;
    align-items: center;
    justify-content: center;
  }

  .ai-content-image-image-{{ ai_gen_id }} img {
    width: 100%;
    height: auto;
    border-radius: {{ block.settings.image_border_radius }}px;
    object-fit: cover;
  }

  .ai-content-image-placeholder-{{ ai_gen_id }} {
    width: 100%;
    aspect-ratio: 4 / 3;
    background-color: #f4f4f4;
    border-radius: {{ block.settings.image_border_radius }}px;
    display: flex;
    align-items: center;
    justify-content: center;
    position: relative;
  }

  .ai-content-image-placeholder-{{ ai_gen_id }} svg {
    width: 100%;
    height: 100%;
    object-fit: cover;
    border-radius: {{ block.settings.image_border_radius }}px;
  }

  .ai-content-image-empty-state-{{ ai_gen_id }} {
    position: absolute;
    bottom: 20px;
    left: 50%;
    transform: translateX(-50%);
    padding: 12px 20px;
    font-size: 14px;
    color: #666;
    text-align: center;
    pointer-events: none;
  }

  @media screen and (max-width: 768px) {
    .ai-content-image-wrapper-{{ ai_gen_id }} {
      flex-direction: column!important;
      gap: 30px;
    }
      .ai-content-image-container-{{ ai_gen_id }} {
    position: relative;
    z-index: 2;
    max-width: 100%;
    margin: 0 auto;
    padding: {{ block.settings.section_padding_top }}px 20px {{ block.settings.section_padding_bottom }}px;
  }
    .ai-content-image-wrapper-aou9odzrfagpxagjvmaigenblock71fecddh3xbyg.ai-image-left-aou9odzrfagpxagjvmaigenblock71fecddh3xbyg{
      display:block;
    }
    .ai-content-image-heading-{{ ai_gen_id }} {
      font-size: {{ block.settings.heading_size | times: 0.7 }}px;
      font-weight:600;
    }

    .ai-content-image-subheading-{{ ai_gen_id }} {
      font-size: {{ block.settings.subheading_size | times: 0.8 }}px;
    }

    .ai-content-image-description-{{ ai_gen_id }} {
      font-size: {{ block.settings.description_size | times: 0.9 }}px;
    }

    .ai-content-image-buttons-{{ ai_gen_id }} {
      flex-direction: column;
      /* width: 100%; */
    }

    .ai-content-image-button-{{ ai_gen_id }} {
      /* width: 100%; */
    }
  }
  .content-slider{
  overflow:hidden;
}

.content-slider .swiper-slide{
  height:auto;
}

.content-slider .swiper-pagination{
  position:relative;
  margin-top:20px;
}
{% endstyle %}
<div class="swiper content-slider">
  <div class="swiper-wrapper">

    <!-- Slide 1 -->
    <div class="swiper-slide">
     
<div class="ai-content-image-section-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  {% if block.settings.background_image %}
    <div class="ai-content-image-bg-{{ ai_gen_id }}">
      <img
        src="{{ block.settings.background_image | image_url: width: 2000 }}"
        alt="{{ block.settings.background_image.alt | escape }}"
        loading="lazy"
        width="{{ block.settings.background_image.width }}"
        height="{{ block.settings.background_image.height }}"
      >
    </div>
  {% elsif block.settings.show_bg_placeholder %}
    <div class="ai-content-image-bg-{{ ai_gen_id }}">
      <div class="ai-content-image-bg-placeholder-{{ ai_gen_id }}">
        {{ 'lifestyle-1' | placeholder_svg_tag }}
      </div>
    </div>
  {% endif %}

  <div class="ai-content-image-overlay-{{ ai_gen_id }}"></div>

  <div class="ai-content-image-container-{{ ai_gen_id }}">
    <div class="ai-content-image-wrapper-{{ ai_gen_id }} ai-image-{{ block.settings.image_position }}-{{ ai_gen_id }}">
      <div class="ai-content-image-content-{{ ai_gen_id }}">
        {% if block.settings.subheading != blank %}
          <div class="ai-content-image-subheading-{{ ai_gen_id }}">
            {{ block.settings.subheading }}
          </div>
        {% endif %}

        {% if block.settings.heading != blank %}
          <h2 class="ai-content-image-heading-{{ ai_gen_id }}">
            {{ block.settings.heading }}
          </h2>
        {% endif %}

        {% if block.settings.description != blank %}
          <div class="ai-content-image-description-{{ ai_gen_id }}">
            {{ block.settings.description }}
          </div>
        {% endif %}

        <div class="ai-content-image-buttons-{{ ai_gen_id }}">
          
          {% if block.settings.button_1_text != blank %}
            <a
              href="{{ block.settings.button_1_link }}"
              class="ai-content-image-button-{{ ai_gen_id }} ai-content-image-button-primary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_1_text }}
            </a>
          {% endif %}

          {% if block.settings.button_2_text != blank %}
            <a
              href="{{ block.settings.button_2_link }}"
              class="ai-content-image-button-{{ ai_gen_id }} ai-content-image-button-secondary-{{ ai_gen_id }}"
            >
              {{ block.settings.button_2_text }}
            </a>
          {% endif %}
        </div>
      </div>

      <div class="ai-content-image-image-{{ ai_gen_id }}">
        {% if block.settings.image %}
          <img
            src="{{ block.settings.image | image_url: width: 1000 }}"
            alt="{{ block.settings.image.alt | escape }}"
            loading="lazy"
            width="{{ block.settings.image.width }}"
            height="{{ block.settings.image.height }}"
          >
        {% else %}
          <div class="ai-content-image-placeholder-{{ ai_gen_id }}">
            {{ 'image' | placeholder_svg_tag }}
            <div class="ai-content-image-empty-state-{{ ai_gen_id }}">
              Add an image
            </div>
          </div>
        {% endif %}
      </div>
    </div>
  </div>
</div>
    </div>

    <!-- Slide 2 -->
    {% unless block.settings.hide_slide_2 %}
    <div class="swiper-slide">

      <div class="ai-content-image-wrapper-{{ ai_gen_id }} ai-image-{{ block.settings.image_position_2 }}-{{ ai_gen_id }}">

        <div class="ai-content-image-content-{{ ai_gen_id }}">

          {% if block.settings.subheading_2 != blank %}
            <div class="ai-content-image-subheading-{{ ai_gen_id }}">
              {{ block.settings.subheading_2 }}
            </div>
          {% endif %}

          <h2 class="ai-content-image-heading-{{ ai_gen_id }}">
            {{ block.settings.heading_2 }}
          </h2>

          <div class="ai-content-image-description-{{ ai_gen_id }}">
            {{ block.settings.description_2 }}
          </div>

        </div>

        <div class="ai-content-image-image-{{ ai_gen_id }}">
          {% if block.settings.image_2 %}
            <img src="{{ block.settings.image_2 | image_url: width: 1000 }}">
          {% endif %}
        </div>

      </div>

    </div>
    {% endunless %}

  </div>

  <div class="swiper-pagination"></div>
</div>


<script>
document.addEventListener('DOMContentLoaded', function () {
  new Swiper('.content-slider', {
    loop: true,
    autoplay: {
      delay: 5000
    },
    pagination: {
      el: '.swiper-pagination',
      clickable: true
    }
  });
});
</script>
