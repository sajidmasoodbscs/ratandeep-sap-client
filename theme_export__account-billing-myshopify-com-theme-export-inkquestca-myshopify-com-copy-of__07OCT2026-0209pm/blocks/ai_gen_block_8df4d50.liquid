<link rel="stylesheet"
      href="{{ 'component-cart-notification.css' | asset_url }}"
      media="print"
      onload="this.media='all'">

<script src="{{ 'cart-notification.js' | asset_url }}" defer="defer"></script>

{% assign ai_gen_id = block.id | replace: '_', '' | downcase %}

{% style %}
  .ai-header-{{ ai_gen_id }} {
    position: fixed;
    top: 49px;
    left: 0;
    right: 0;
    z-index: 1000;
    transition: background-color 0.3s ease, box-shadow 0.3s ease;
    background-color: transparent;
  }

  .ai-header-{{ ai_gen_id }}.scrolled {
    background-color: {{ block.settings.scrolled_bg_color }};
  }

  .ai-header-container-{{ ai_gen_id }} {
    max-width: {{ block.settings.container_width }}px;
    margin: 0 auto;
    padding: {{ block.settings.header_padding }}px 20px;
    display: flex;
    align-items: center;
    justify-content: space-between;
  }

  .ai-header-logo-{{ ai_gen_id }} {
    flex-shrink: 0;
  }

  .ai-header-logo-{{ ai_gen_id }} img {
    height: {{ block.settings.logo_height }}px;
    width: auto;
    display: block;
  }

  .ai-header-logo-placeholder-{{ ai_gen_id }} {
    height: {{ block.settings.logo_height }}px;
    width: 120px;
    background-color: rgba(0, 0, 0, 0.1);
    display: flex;
    align-items: center;
    justify-content: center;
    border-radius: 4px;
  }

  .ai-header-logo-placeholder-{{ ai_gen_id }} svg {
    width: 60%;
    height: 60%;
    opacity: 0.3;
  }

  .ai-header-nav-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 30px;
    flex-grow: 1;
    justify-content: center;
  }

  .ai-header-menu-{{ ai_gen_id }} {
    display: flex;
    gap: 30px;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-header-menu-item-{{ ai_gen_id }} {
    position: relative;
  }

  .ai-header-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.menu_text_color }};
    text-decoration: none;
    font-size: {{ block.settings.menu_font_size }}px;
    font-weight: {{ block.settings.menu_font_weight }};
    padding: 10px 0;
    display: flex;
    align-items: center;
    gap: 5px;
    transition: color 0.3s ease;
  }

  .ai-header-{{ ai_gen_id }}.scrolled .ai-header-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.scrolled_menu_text_color }};
  }

  .ai-header-menu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.menu_hover_color }};
  }

  .ai-header-dropdown-icon-{{ ai_gen_id }} {
    width: 12px;
    height: 12px;
    transition: transform 0.3s ease;
  }

  .ai-header-menu-item-{{ ai_gen_id }}:hover .ai-header-dropdown-icon-{{ ai_gen_id }} {
    transform: rotate(180deg);
  }

  .ai-header-mega-menu-{{ ai_gen_id }} {
    position: absolute;
    top: 100%;
    left: 50%;
    transform: translateX(-50%);
    background-color: {{ block.settings.dropdown_bg_color }};
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.15);
    border-radius: 8px;
    padding: 30px;
    min-width: 250px;
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.3s ease, visibility 0.3s ease, transform 0.3s ease;
    transform: translateX(-50%) translateY(10px);
    margin-top: 10px;
  }

  .ai-header-menu-item-{{ ai_gen_id }}:hover .ai-header-mega-menu-{{ ai_gen_id }} {
    opacity: 1;
    visibility: visible;
    transform: translateX(-50%) translateY(0);
  }

  .ai-header-mega-menu-grid-{{ ai_gen_id }} {

     display: grid;
    grid-template-columns: 1fr;
    gap: 0px;
  }

  .ai-header-mega-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.dropdown_text_color }};
    text-decoration: none;
    padding: 5px 0;
    display: block;
    transition: color 0.3s ease;
    font-size: 14px;
  }

  .ai-header-mega-menu-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.menu_hover_color }};
  }

  .ai-header-actions-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 0px;
  }

  .ai-header-icon-btn-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    display: flex;
    align-items: center;
    gap: 5px;
    color: {{ block.settings.icon_color }};
    transition: color 0.3s ease;
    text-decoration: none;
  }

  .ai-header-{{ ai_gen_id }}.scrolled .ai-header-icon-btn-{{ ai_gen_id }} {
    color: {{ block.settings.scrolled_icon_color }};
  }

  .ai-header-icon-btn-{{ ai_gen_id }}:hover {
    color: {{ block.settings.menu_hover_color }};
  }

  .ai-header-icon-btn-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-header-lang-text-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 500;
  }

  .ai-header-mobile-toggle-{{ ai_gen_id }} {
    display: none;
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.icon_color }};
  }

  .ai-header-{{ ai_gen_id }}.scrolled .ai-header-mobile-toggle-{{ ai_gen_id }} {
    color: {{ block.settings.scrolled_icon_color }};
  }

  .ai-header-mobile-toggle-{{ ai_gen_id }} svg {
    width: 28px;
    height: 28px;
  }

  .ai-header-mobile-menu-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    right: -100%;
    width: 85%;
    max-width: 400px;
    height: 100vh;
    background-color: {{ block.settings.mobile_menu_bg_color }};
    box-shadow: -5px 0 20px rgba(0, 0, 0, 0.2);
    transition: right 0.4s cubic-bezier(0.4, 0, 0.2, 1);
    z-index: 1001;
    overflow-y: auto;
    display: flex;
    flex-direction: column;
  }

  .ai-header-mobile-menu-{{ ai_gen_id }}.active {
    right: 0;
  }

  .ai-header-mobile-overlay-{{ ai_gen_id }} {
    position: fixed;
    top: 0;
    left: 0;
    width: 100%;
    height: 100vh;
    background-color: rgba(0, 0, 0, 0.5);
    opacity: 0;
    visibility: hidden;
    transition: opacity 0.4s ease, visibility 0.4s ease;
    z-index: 1000;
  }

  .ai-header-mobile-overlay-{{ ai_gen_id }}.active {
    opacity: 1;
    visibility: visible;
  }

  .ai-header-mobile-header-{{ ai_gen_id }} {
    display: flex;
    justify-content: space-between;
    align-items: center;
    padding: 20px;
    border-bottom: 1px solid rgba(0, 0, 0, 0.1);
  }

  .ai-header-mobile-close-{{ ai_gen_id }} {
    background: none;
    border: none;
    cursor: pointer;
    padding: 8px;
    color: {{ block.settings.mobile_menu_text_color }};
  }

  .ai-header-mobile-close-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-header-mobile-nav-{{ ai_gen_id }} {
    padding: 20px;
    flex-grow: 1;
  }

  .ai-header-mobile-menu-list-{{ ai_gen_id }} {
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .ai-header-mobile-menu-item-{{ ai_gen_id }} {
    border-bottom: 1px solid rgba(0, 0, 0, 0.05);
  }

  .ai-header-mobile-menu-link-{{ ai_gen_id }} {
    color: {{ block.settings.mobile_menu_text_color }};
    text-decoration: none;
    padding: 15px 0;
    display: flex;
    justify-content: space-between;
    align-items: center;
    font-size: 16px;
  }

  .ai-header-mobile-submenu-{{ ai_gen_id }} {
    list-style: none;
    margin: 0;
    padding: 0 0 10px 20px;
    max-height: 0;
    overflow: hidden;
    transition: max-height 0.3s ease;
  }

  .ai-header-mobile-submenu-{{ ai_gen_id }}.active {
    max-height: 500px;
  }

  .ai-header-mobile-submenu-link-{{ ai_gen_id }} {
    color: {{ block.settings.mobile_menu_text_color }};
    text-decoration: none;
    padding: 10px 0;
    display: block;
    font-size: 14px;
    opacity: 0.8;
  }

  .ai-header-mobile-actions-{{ ai_gen_id }} {
    padding: 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
    display: flex;
    flex-direction: column;
    gap: 15px;
  }

  .ai-header-mobile-action-btn-{{ ai_gen_id }} {
    display: flex;
    align-items: center;
    gap: 12px;
    padding: 12px 0;
    color: {{ block.settings.mobile_menu_text_color }};
    text-decoration: none;
    font-size: 16px;
    transition: color 0.3s ease;
  }

  .ai-header-mobile-action-btn-{{ ai_gen_id }}:hover {
    color: {{ block.settings.menu_hover_color }};
  }

  .ai-header-mobile-action-btn-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

  .ai-header-mobile-social-{{ ai_gen_id }} {
    padding: 20px;
    border-top: 1px solid rgba(0, 0, 0, 0.1);
  }

  .ai-header-mobile-social-title-{{ ai_gen_id }} {
    font-size: 14px;
    font-weight: 600;
    margin-bottom: 15px;
    color: {{ block.settings.mobile_menu_text_color }};
  }

  .ai-header-mobile-social-links-{{ ai_gen_id }} {
    display: flex;
    gap: 15px;
  }

  .ai-header-mobile-social-link-{{ ai_gen_id }} {
    color: {{ block.settings.mobile_menu_text_color }};
    transition: color 0.3s ease;
  }

  .ai-header-mobile-social-link-{{ ai_gen_id }}:hover {
    color: {{ block.settings.menu_hover_color }};
  }

  .ai-header-mobile-social-link-{{ ai_gen_id }} svg {
    width: 24px;
    height: 24px;
  }

.lang-switcher {
  display: flex;
  gap: 6px;
  align-items: center;
}

.lang-btn {
  border: none;
  background: #f3f3f3;
  border-radius: 6px;
  padding: 6px 10px;
  cursor: pointer;
  font-size: 13px;
  font-weight: 600;
  color: #222;
  transition: 0.3s;
}

.lang-btn:hover {
  background: #e3e3e3;
}

.active-lang {
  background: #00404C;
  color: #fff;
}

/* 🖥️ Header style adjustments */
#lang-switcher-header {
  margin-left: 20px;
  display: flex;
}

/* 📱 Mobile Drawer adjustments */
#lang-switcher-mobile {
  margin-top: 15px;
  padding-left: 1rem;
}

/* Hide floating version if any */
#lang-switcher {
  display: none !important;
}

 @media only screen and (max-width: 800px) {
    .ai-header-nav-{{ ai_gen_id }},
    .ai-header-actions-{{ ai_gen_id }} .ai-header-icon-btn-{{ ai_gen_id }} {
      display: none;
    }

    .ai-header-mobile-toggle-{{ ai_gen_id }} {
      display: block;
    }
    .desktop-tran{
    display: none;
    }
  }

  .ai-header-{{ ai_gen_id }}.scrolled {
  background-color: {{ block.settings.scrolled_bg_color }};
  border-bottom: 1px solid rgba(0,0,0,0.08);
}
{% endstyle %}

<header-{{ ai_gen_id }} class="ai-header-{{ ai_gen_id }}" {{ block.shopify_attributes }}>
  <div class="ai-header-container-{{ ai_gen_id }}">
    <div class="ai-header-logo-{{ ai_gen_id }}">
      {% if block.settings.logo %}
        <a href="/">
          <img src="{{ block.settings.logo | image_url: width: 300 }}" alt="{{ shop.name }}" loading="eager">
        </a>
      {% else %}
        <div class="ai-header-logo-placeholder-{{ ai_gen_id }}">
          {{ 'image' | placeholder_svg_tag }}
        </div>
      {% endif %}
    </div>

    <nav class="ai-header-nav-{{ ai_gen_id }}">
      {% if block.settings.menu != blank %}
        <ul class="ai-header-menu-{{ ai_gen_id }}">
          {% for link in linklists[block.settings.menu].links %}
            <li class="ai-header-menu-item-{{ ai_gen_id }}">
              <a href="{{ link.url }}" class="ai-header-menu-link-{{ ai_gen_id }}">
                {{ link.title }}
                {% if link.links.size > 0 %}
                  <svg class="ai-header-dropdown-icon-{{ ai_gen_id }}" viewBox="0 0 12 8" fill="none" stroke="currentColor" stroke-width="2">
                    <path d="M1 1l5 5 5-5"/>
                  </svg>
                {% endif %}
              </a>
              {% if link.links.size > 0 %}
                <div class="ai-header-mega-menu-{{ ai_gen_id }}">
                  <div class="ai-header-mega-menu-grid-{{ ai_gen_id }}">
                    {% for child_link in link.links %}
                      <a href="{{ child_link.url }}" class="ai-header-mega-menu-link-{{ ai_gen_id }}">
                        {{ child_link.title }}
                      </a>
                    {% endfor %}
                  </div>
                </div>
              {% endif %}
            </li>
          {% endfor %}
        </ul>
      {% endif %}
    </nav>

 
    <div class="ai-header-actions-{{ ai_gen_id }}">

      
    {% if customer %}
 {% render 'header-search', input_id: 'Search-In-Modal' %}
 {% endif %}
      {% if block.settings.show_account_icon %}
        <a href="/pages/my-account" class="ai-header-icon-btn-{{ ai_gen_id }}" aria-label="Account">
          <svg viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2">
            <path d="M20 21v-2a4 4 0 0 0-4-4H8a4 4 0 0 0-4 4v2"/>
            <circle cx="12" cy="7" r="4"/>
          </svg>
        </a>
      {% endif %}

       <a href="{{ routes.cart_url }}" class="header__icon header__icon--cart link focus-inset" id="cart-icon-bubble">
        {% if cart == empty %}
          <span class="svg-wrapper">{{ 'icon-cart-empty.svg' | inline_asset_content }}</span>
        {% else %}
          <span class="svg-wrapper">{{ 'icon-cart.svg' | inline_asset_content }}</span>
        {% endif %}
        <span class="visually-hidden">{{ 'templates.cart.cart' | t }}</span>
        {%- if cart != empty -%}
          <div class="cart-count-bubble">
            {%- if cart.item_count < 100 -%}
              <span aria-hidden="true">{{ cart.item_count }}</span>
            {%- endif -%}
            <span class="visually-hidden">{{ 'sections.header.cart_count' | t: count: cart.item_count }}</span>
          </div>
        {%- endif -%}
      </a>

<div id="vitals-wishlist-header"></div>
      
