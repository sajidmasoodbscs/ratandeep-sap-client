                <path d="M23.953 4.57a10 10 0 01-2.825.775 4.958 4.958 0 002.163-2.723c-.951.555-2.005.959-3.127 1.184a4.92 4.92 0 00-8.384 4.482C7.69 8.095 4.067 6.13 1.64 3.162a4.822 4.822 0 00-.666 2.475c0 1.71.87 3.213 2.188 4.096a4.904 4.904 0 01-2.228-.616v.06a4.923 4.923 0 003.946 4.827 4.996 4.996 0 01-2.212.085 4.936 4.936 0 004.604 3.417 9.867 9.867 0 01-6.102 2.105c-.39 0-.779-.023-1.17-.067a13.995 13.995 0 007.557 2.209c9.053 0 13.998-7.496 13.998-13.985 0-.21 0-.42-.015-.63A9.935 9.935 0 0024 4.59z"/>
              </svg>
            </a>
          {% endif %}
          {% if block.settings.youtube_url != blank %}
            <a href="{{ block.settings.youtube_url }}" class="ai-header-mobile-social-link-{{ ai_gen_id }}" target="_blank" rel="noopener" aria-label="YouTube">
              <svg viewBox="0 0 24 24" fill="currentColor">
                <path d="M23.498 6.186a3.016 3.016 0 0 0-2.122-2.136C19.505 3.545 12 3.545 12 3.545s-7.505 0-9.377.505A3.017 3.017 0 0 0 .502 6.186C0 8.07 0 12 0 12s0 3.93.502 5.814a3.016 3.016 0 0 0 2.122 2.136c1.871.505 9.376.505 9.376.505s7.505 0 9.377-.505a3.015 3.015 0 0 0 2.122-2.136C24 15.93 24 12 24 12s0-3.93-.502-5.814zM9.545 15.568V8.432L15.818 12l-6.273 3.568z"/>
              </svg>
            </a>
          {% endif %}
        </div>
      </div>
    {% endif %}
  </div>
</header-{{ ai_gen_id }}>
{%- if settings.cart_type == 'notification' -%}
  {%- render 'cart-notification' -%}
{%- endif -%}

<script>
(function() {
  class Header{{ ai_gen_id }} extends HTMLElement {
    constructor() {
      super();
      this.header = this;
      this.mobileToggle = this.querySelector('.ai-header-mobile-toggle-{{ ai_gen_id }}');
      this.mobileMenu = this.querySelector('.ai-header-mobile-menu-{{ ai_gen_id }}');
      this.mobileOverlay = this.querySelector('.ai-header-mobile-overlay-{{ ai_gen_id }}');
      this.mobileClose = this.querySelector('.ai-header-mobile-close-{{ ai_gen_id }}');
      this.mobileMenuItems = this.querySelectorAll('.ai-header-mobile-menu-item-{{ ai_gen_id }}');
    }

    connectedCallback() {
      this.setupScrollBehavior();
      this.setupMobileMenu();
      this.setupMobileDropdowns();
    }

    setupScrollBehavior() {
      let lastScroll = 0;
      window.addEventListener('scroll', () => {
        const currentScroll = window.pageYOffset;
        if (currentScroll > 50) {
          this.header.classList.add('scrolled');
        } else {
          this.header.classList.remove('scrolled');
        }
        lastScroll = currentScroll;
      });
    }

    setupMobileMenu() {
      this.mobileToggle.addEventListener('click', () => {
        this.mobileMenu.classList.add('active');
        this.mobileOverlay.classList.add('active');
        document.body.style.overflow = 'hidden';
      });

      this.mobileClose.addEventListener('click', () => {
        this.closeMobileMenu();
      });

      this.mobileOverlay.addEventListener('click', () => {
        this.closeMobileMenu();
      });
    }

    closeMobileMenu() {
      this.mobileMenu.classList.remove('active');
      this.mobileOverlay.classList.remove('active');
      document.body.style.overflow = '';
    }

    setupMobileDropdowns() {
      this.mobileMenuItems.forEach(item => {
        const link = item.querySelector('.ai-header-mobile-menu-link-{{ ai_gen_id }}');
        const submenu = item.querySelector('.ai-header-mobile-submenu-{{ ai_gen_id }}');
        
        if (submenu) {
          link.addEventListener('click', (e) => {
            e.preventDefault();
            submenu.classList.toggle('active');
          });
        }
      });
    }
  }

  customElements.define('header-{{ ai_gen_id }}', Header{{ ai_gen_id }});
})();
</script>

