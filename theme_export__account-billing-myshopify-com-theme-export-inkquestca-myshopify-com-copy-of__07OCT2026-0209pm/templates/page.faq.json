{"sections":{"main":{"type":"main-page","custom_css":[],"settings":{"padding_top":24,"padding_bottom":28}},"custom_liquid_wF3NnQ":{"type":"custom-liquid","disabled":true,"name":"t:sections.custom-liquid.presets.name","settings":{"custom_liquid":"<section class=\"custom-collapsible-section\">\n<div class=\"container\">\n<div class=\"collapsible-wrapper\">\n\n<!-- 1. Account & Ordering -->\n<h3 class=\"faq-category-heading\">1. Account &amp; Ordering<\/h3>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: How do I create an account?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: Click on the “Sign Up” button on the top right corner of our website. Fill out the required information and submit your request. Once your account is approved, you can start placing orders.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: Do I have to pay to create an account?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: Nope! Creating an Ink Quest account is totally free. You only pay when you order.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: Can I place an order without an account?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: No. An approved account is required to place orders to ensure secure transactions and accurate order tracking.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: Do I need to meet a minimum order amount?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: No minimums! You can order as little or as much as you need.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: How do I place an order?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: After logging in, browse our online catalogue, select the products you need, and add them to your cart. Follow the checkout process to complete your purchase.<\/p>\n<\/div>\n<\/div>\n\n\n\n\n<!-- 2. Shipping & Delivery -->\n<h3 class=\"faq-category-heading\">2. Shipping &amp; Delivery<\/h3>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: Do you offer dropshipping?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: Yes. During the checkout process, you can select the dropship option and provide the recipient’s address.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: How long will delivery take?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: Delivery times vary depending on location and shipping method. Most orders are processed within 1–2 business days. You will receive a tracking number once your order has shipped.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: Do you ship internationally?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: Currently, we ship within Canada only.<\/p>\n<\/div>\n<\/div>\n\n\n\n\n<!-- 3. Payments & Billing -->\n<h3 class=\"faq-category-heading\">3. Payments &amp; Billing<\/h3>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: What payment methods do you accept?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: We accept credit cards, e-transfer, EFT, Bill Payment and Cheque for approved business accounts. Please note that e-transfers are not accepted.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: Can I get a copy of my invoice?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: Yes. Invoices are automatically emailed to you after each purchase.<\/p>\n<\/div>\n<\/div>\n\n\n\n\n<!-- 4. Returns & Exchanges -->\n<h3 class=\"faq-category-heading\">4. Returns &amp; Exchanges<\/h3>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: What is your return policy?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: Eligible items can be returned within 30 days of delivery. Products must be unused, in original condition, and in their original packaging.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: Are there items that cannot be returned?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: Yes. Custom or altered products, clearance\/final sale items, and perishable goods are not eligible for returns.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: How do I initiate a return?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: Contact our support team via email or phone to request a return. We will provide instructions and a return authorization if your item is eligible.<\/p>\n<\/div>\n<\/div>\n\n\n\n\n<!-- 5. Products & Catalog -->\n<h3 class=\"faq-category-heading\">5. Products &amp; Catalog<\/h3>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: How often do you update your product catalog?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: We add new products daily to ensure our customers have access to the latest and most compatible printer ink and accessories.<\/p>\n<\/div>\n<\/div>\n\n<div class=\"collapsible-item\">\n<button type=\"button\" class=\"collapsible-toggle\">Q: Do you carry compatible and original ink cartridges?<span class=\"icon\">+<\/span><\/button>\n<div class=\"collapsible-content\">\n<p>A: Yes. Ink Quest offers both original brand cartridges and high-quality compatible alternatives.<\/p>\n<\/div>\n<\/div>\n\n<\/div>\n<\/div>\n<\/section>\n\n<style>\n.custom-collapsible-section {\n  padding: 0px 20px 40px 20px;\n  background: #fff;\n}\n.container {\n  max-width: 75%;\n  margin: 0 auto;\n}\n.section-heading {\n  text-align: center;\n  font-size: 24px;\n  font-weight: 700;\n  margin-bottom: 20px;\n}\n.faq-category-heading {\n  text-align: center;\n  font-size: 24px;\n  font-weight: 600;\n  margin-bottom: 20px;\n      margin-top: 55px;\n}\n\n.collapsible-item {\n  border: 1px solid #ddd;\n  border-radius: 10px;\n  margin-bottom: 12px;\n  overflow: hidden;\n  transition: all 0.3s ease;\n}\n.collapsible-toggle {\n  width: 100%;\n  text-align: left;\n  padding: 15px 20px;\n  font-size: 18px;\n  font-weight: 600;\n  background: #f8f8f8;\n  border: none;\n  cursor: pointer;\n  position: relative;\n}\n.collapsible-toggle .icon {\n  position: absolute;\n  right: 20px;\n  font-weight: bold;\n  transition: transform 0.3s ease;\n}\n.collapsible-content {\n  max-height: 0;\n  overflow: hidden;\n  padding: 0 20px;\n  background: #fff;\n  color: #333;\n  transition: max-height 0.4s ease;\n}\n.collapsible-item.active .collapsible-content {\n  padding: 15px 20px;\n  max-height: 500px;\n}\n.collapsible-item.active .icon {\n  transform: rotate(45deg);\n}\n.collapsible-content {\n  max-height: 0;\n  overflow: hidden;\n  padding: 0 20px;\n  background: #fff;\n  color: #333;\n  transition: max-height .35s ease, padding .35s ease;\n}\n\n.collapsible-item.active .collapsible-content {\n  padding: 15px 20px;\n}\n<\/style>\n<script>\ndocument.addEventListener(\"DOMContentLoaded\", function () {\n\n  document.querySelectorAll(\".collapsible-toggle\").forEach(function(btn){\n\n    btn.addEventListener(\"click\", function(){\n\n      const item = this.closest(\".collapsible-item\");\n      const content = item.querySelector(\".collapsible-content\");\n\n      if(item.classList.contains(\"active\")){\n        item.classList.remove(\"active\");\n        content.style.maxHeight = null;\n      } else {\n\n        document.querySelectorAll(\".collapsible-item\").forEach(function(el){\n          el.classList.remove(\"active\");\n          el.querySelector(\".collapsible-content\").style.maxHeight = null;\n        });\n\n        item.classList.add(\"active\");\n        content.style.maxHeight = content.scrollHeight + \"px\";\n      }\n\n    });\n\n  });\n\n});\n<\/script>","color_scheme":"","padding_top":40,"padding_bottom":52}}},"order":["main","custom_liquid_wF3NnQ"]}