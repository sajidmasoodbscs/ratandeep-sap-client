<script>
(function() {
  function scrollToSec(id) {
    var sec = document.getElementById(id);
    if (sec) setTimeout(function() { sec.scrollIntoView({behavior: 'smooth', block: 'center'}); }, 60);
  }
  document.querySelectorAll('.tour-radio').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var m = this.id.match(/^tour(\d+)$/);
      if (m) scrollToSec('sec' + m[1]);
    });
  });
  document.querySelectorAll('.iq-toggle').forEach(function(radio) {
    radio.addEventListener('change', function() {
      var m = this.id.match(/^iq(\d+)$/);
      if (m) scrollToSec('sec' + m[1]);
    });
  });
})();
</script>
