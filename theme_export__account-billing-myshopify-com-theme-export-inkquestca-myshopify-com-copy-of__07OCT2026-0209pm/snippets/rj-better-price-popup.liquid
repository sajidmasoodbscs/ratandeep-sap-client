<script>
(function () {

  function crxBetterPriceInit() {

    const wrap =
      document.querySelector('.crx-bp-wrap');

    if (!wrap) return;

    const trigger =
      wrap.querySelector('.crx-bp-trigger');

    const overlay =
      wrap.querySelector('.crx-bp-overlay');

    const closeBtn =
      wrap.querySelector('.crx-bp-close');

    const form =
      wrap.querySelector('#crx-bp-form-wrap');

    const confirm =
      wrap.querySelector('#crx-bp-confirm');

    const file =
      wrap.querySelector('#crx-bp-file');

    const upload =
      wrap.querySelector('#crx-bp-upload');

    const fileName =
      wrap.querySelector('#crx-bp-file-name');

    const email =
      wrap.querySelector('#crx-bp-email');

    const replyTo =
      wrap.querySelector('#crx-bp-replyto');

    const submitBtn =
      wrap.querySelector('#crx-bp-submit');

    const iframe =
      document.getElementById('crx-bp-submit-frame');

    let formSubmitted = false;


    /* =========================================
       OPEN POPUP
    ========================================= */

    trigger.addEventListener(
      'click',
      function () {

        overlay.classList.add(
          'crx-bp-open'
        );

        overlay.setAttribute(
          'aria-hidden',
          'false'
        );

        document.body.classList.add(
          'crx-bp-lock'
        );

      }
    );


    /* =========================================
       CLOSE POPUP
    ========================================= */

    function crxBPClosePopup() {

      overlay.classList.remove(
        'crx-bp-open'
      );

      overlay.setAttribute(
        'aria-hidden',
        'true'
      );

      document.body.classList.remove(
        'crx-bp-lock'
      );

    }


    closeBtn.addEventListener(
      'click',
      crxBPClosePopup
    );


    /* =========================================
       OUTSIDE CLICK
    ========================================= */

    overlay.addEventListener(
      'click',
      function (event) {

        if (event.target === overlay) {
          crxBPClosePopup();
        }

      }
    );


    /* =========================================
       ESCAPE
    ========================================= */

    document.addEventListener(
      'keydown',
      function (event) {

        if (
          event.key === 'Escape' &&
          overlay.classList.contains(
            'crx-bp-open'
          )
        ) {

          crxBPClosePopup();

        }

      }
    );


    /* =========================================
       FILE NAME
    ========================================= */

    if (file) {

      file.addEventListener(
        'change',
        function () {

          if (
            this.files &&
            this.files.length
          ) {

            upload.classList.add(
              'crx-bp-has-file'
            );

            fileName.textContent =
              '📎 ' +
              this.files[0].name;

            fileName.classList.add(
              'crx-bp-show'
            );

          } else {

            upload.classList.remove(
              'crx-bp-has-file'
            );

            fileName.textContent = '';

            fileName.classList.remove(
              'crx-bp-show'
            );

          }

        }
      );

    }


    /* =========================================
       CUSTOMER EMAIL → REPLY TO
    ========================================= */

    if (
      email &&
      replyTo
    ) {

      email.addEventListener(
        'input',
        function () {

          replyTo.value =
            email.value;

        }
      );

    }


    /* =========================================
       FORM SUBMIT
    ========================================= */

    form.addEventListener(
      'submit',
      function (event) {

        const price =
          wrap.querySelector(
            '#crx-bp-price'
          );

        const quantity =
          wrap.querySelector(
            '#crx-bp-quantity'
          );


        /* PRICE VALIDATION */

        if (
          !price.value ||
          Number(price.value) <= 0
        ) {

          event.preventDefault();

          price.focus();

          return;

        }


        /* QUANTITY VALIDATION */

        if (
          !quantity.value ||
          Number(quantity.value) <= 0
        ) {

          event.preventDefault();

          quantity.focus();

          return;

        }


        /* EMAIL VALIDATION */

        if (
          !email.value ||
          !email.checkValidity()
        ) {

          event.preventDefault();

          email.focus();

          return;

        }


        /* REPLY EMAIL */

        if (replyTo) {

          replyTo.value =
            email.value;

        }


        /*
          IMPORTANT:
          DO NOT use event.preventDefault()
          here.

          FormSubmit will receive the
          original multipart form including
          the attachment.

          target="crx-bp-submit-frame"
          keeps the main Shopify page open.
        */

        formSubmitted = true;


        /* LOADING STATE */

        submitBtn.disabled = true;

        submitBtn.style.opacity =
          '0.65';

        submitBtn.style.pointerEvents =
          'none';

        submitBtn.innerHTML =
          '<span>Sending request...</span>' +
          '<span>...</span>';

      }
    );


    /* =========================================
       FORMSUBMIT RESPONSE
    ========================================= */

    if (iframe) {

      iframe.addEventListener(
        'load',
        function () {

          if (!formSubmitted) return;

          formSubmitted = false;


          /* HIDE FORM */

          form.style.display =
            'none';


          /* SHOW THANK YOU */

          if (confirm) {

            confirm.classList.add(
              'crx-bp-confirm-show'
            );

          }


          /* CLOSE POPUP AFTER 2.5 SEC */

          setTimeout(
            function () {

              crxBPClosePopup();


              /* RESET FORM */

              form.reset();


              /* SHOW FORM AGAIN */

              form.style.display =
                '';


              /* HIDE THANK YOU */

              if (confirm) {

                confirm.classList.remove(
                  'crx-bp-confirm-show'
                );

              }


              /* RESET FILE UI */

              if (upload) {

                upload.classList.remove(
                  'crx-bp-has-file'
                );

              }


              if (fileName) {

                fileName.textContent =
                  '';

                fileName.classList.remove(
                  'crx-bp-show'
                );

              }


              /* RESET BUTTON */

              submitBtn.disabled =
                false;

              submitBtn.style.opacity =
                '';

              submitBtn.style.pointerEvents =
                '';

              submitBtn.innerHTML =
                '<span>Send request</span>' +
                '<span>→</span>';

            },
            2500
          );

        }
      );

    }

  }


  /* =========================================
     INITIALIZE
  ========================================= */

  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      crxBetterPriceInit
    );

  } else {

    crxBetterPriceInit();

  }

})();
</script>