{% comment %} 
{% if product.metafields.custom.firmware_info != blank %}
  <div class="firmware-pill">
    <svg
      class="fw-icon"
      width="18"
      height="18"
      viewBox="0 0 24 24"
      fill="none"
      stroke="currentColor"
      stroke-width="2.3"
    >
      <path d="M20 6L9 17l-5-5"/>
    </svg>

    <div class="fw-text">
      <strong>Compatible with the latest firmware</strong><br>
      {{ product.metafields.custom.firmware_info | newline_to_br }}
    </div>
  </div>
{% endif %}


{% assign customer_warehouse = '' %}

{% if customer and customer.default_address %}
  {% assign customer_province = customer.default_address.province_code | upcase %}

  {% case customer_province %}

    {% when 'BC' %}
      {% assign customer_warehouse = 'Ink Quest, Richmond, BC' %}

    {% when 'AB', 'SK', 'MB' %}
      {% assign customer_warehouse = 'Ink Quest, Edmonton, AB' %}

    {% when 'NB', 'NL', 'NT', 'NS', 'NU', 'ON', 'PE', 'QC', 'YT' %}
      {% assign customer_warehouse = 'Ink Quest / JCMD, St-Eustache, QC' %}

  {% endcase %}
{% endif %}


{% assign stores = variant.store_availabilities | where: 'pick_up_enabled', true %}


{% if stores.size > 0 %}

  <div
    class="warehouse-card"
    id="warehouseCard"
    data-variant-id="{{ variant.id }}"
  >

    <div class="warehouse-title">
      Warehouse Availability
    </div>


    <div class="warehouse-list">

      {% for store in stores %}

        <div
          class="warehouse-row"
          data-location-name="{{ store.location.name | strip | escape }}"
        >

          <div class="warehouse-left">

            <strong>
              {{ store.location.name }}
            </strong>

            {% if customer_warehouse != blank and store.location.name contains customer_warehouse %}
              <span class="warehouse-badge">
                YOUR WAREHOUSE
              </span>
            {% endif %}

          </div>


          <div class="warehouse-right">

            <!-- Loading state -->
            <span class="warehouse-stock warehouse-loading">
              Checking...
            </span>

          </div>

        </div>

      {% endfor %}

    </div>

  </div>

{% endif %}


<style>

/* =========================================
   WAREHOUSE STOCK - PREMIUM UI
   ========================================= */

.warehouse-card {
  border: 0 !important;
  border-radius: 0 !important;
  padding: 0 !important;
  background: transparent !important;
  box-shadow: none !important;
}

.warehouse-title {
  font-size: 16px !important;
  font-weight: 700 !important;
  line-height: 1.3 !important;
  color: #00404C !important;
  margin: 0 0 10px !important;
}

.warehouse-list {
  display: grid !important;
  grid-template-columns: repeat(3, 1fr) !important;
  gap: 12px !important;
}

.warehouse-row {
  min-width: 0 !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;
  justify-content: flex-start !important;

  gap: 4px !important;

  padding: 12px 14px !important;

  border: 1px solid #ddd9cf !important;
  border-radius: 10px !important;

  background: #fff !important;

  box-sizing: border-box !important;
}

.warehouse-row:last-child {
  border-bottom: 1px solid #ddd9cf !important;
}


/* =========================================
   LOCATION NAME
   ========================================= */

.warehouse-left {
  width: 100% !important;

  display: flex !important;
  flex-direction: column !important;
  align-items: flex-start !important;

  gap: 4px !important;

  min-width: 0 !important;
}

.warehouse-left strong {
    font-size: 12px;
    font-weight: 700;
    color: #00404C;
    display: flex;
    align-items: center;
    gap: 6px;
    flex-wrap: wrap;
    line-height: normal;
}


/* =========================================
   YOUR WAREHOUSE BADGE
   ========================================= */

.warehouse-badge {
  display: inline-flex !important;
  align-items: center !important;

  width: fit-content !important;

  padding: 3px 8px !important;

  border-radius: 3px !important;
  background: #172c62 !important;
  color: #fff !important;

  font-size: 9px !important;
  line-height: 1.2 !important;
  font-weight: 700 !important;

  letter-spacing: .2px !important;
  text-transform: uppercase !important;

  white-space: nowrap !important;
}


/* =========================================
   STOCK AREA
   ========================================= */

.warehouse-right {
  width: 100% !important;

  display: flex !important;
  align-items: center !important;
  justify-content: flex-start !important;

  flex-shrink: 0 !important;
}

.warehouse-stock {
  display: inline-flex !important;
  align-items: center !important;

  padding: 0 !important;

  border-radius: 0 !important;

  background: transparent !important;

  font-size: 13px !important;
  line-height: 1.3 !important;
  font-weight: 500 !important;

  white-space: nowrap !important;
}


/* IN STOCK */
.warehouse-stock.in-stock {
  background: transparent !important;
  color: #087b52 !important;
}


/* INCOMING */
.warehouse-stock.incoming {
  background: transparent !important;
  color: #a66a00 !important;
}


/* BACKORDER */
.warehouse-stock.backorder {
  color: #c82333 !important;
  border-radius: 20px !important;
  white-space: normal !important;
}


/* LOADING */
.warehouse-stock.warehouse-loading {
  min-width: 0 !important;

  padding: 0 !important;

  background: transparent !important;
  color: #777 !important;

  text-align: left !important;
}


/* ERROR */
.warehouse-stock.warehouse-error {
  background: transparent !important;
  color: #c82333 !important;
}


/* QUANTITY */
.stock-qty-num {
  margin-left: 2px !important;
  font-weight: 600 !important;
}


/* =========================================
   MOBILE
   ========================================= */

@media screen and (max-width: 767px) {

  .warehouse-title {
    font-size: 15px !important;
    margin-bottom: 9px !important;
  }

  .warehouse-list {
    grid-template-columns: repeat(3, minmax(0, 1fr)) !important;
    gap: 8px !important;
  }

  .warehouse-row {
    padding: 10px !important;
    border-radius: 9px !important;
    gap: 4px !important;
  }

  .warehouse-left strong {
    font-size: 12px !important;
    line-height: normal;
  }

  .warehouse-badge {
    font-size: 8px !important;
    padding: 3px 6px !important;
  }

  .warehouse-stock {
    font-size: 11px !important;
  }

}


/* =========================================
   VERY SMALL MOBILE
   ========================================= */

@media screen and (max-width: 480px) {

  .warehouse-list {
    gap: 6px !important;
  }

  .warehouse-row {
    padding: 9px 8px !important;
  }

  .warehouse-left strong {
    font-size: 11px !important;
  }

  .warehouse-stock {
    font-size: 10px !important;
  }

  .warehouse-badge {
    font-size: 7px !important;
    padding: 2px 5px !important;
  }

}

