<script>

(function () {

  /* =======================================================
     LANGUAGE SUPPORT
     UI/functional logic remains unchanged.
     ======================================================= */
  const INKQUEST_LANG = "{{ request.locale.iso_code }}";
  const INKQUEST_TEXT = {
    en: {
      checking: "Checking...",
      unavailable: "Inventory unavailable",
      inStock: "● In Stock",
      incoming: "● Incoming",
      backorder: "● B/O-Avail. To Purchase (0)"
    },
    fr: {
      checking: "Vérification...",
      unavailable: "Inventaire indisponible",
      inStock: "● En stock",
      incoming: "● À venir",
      backorder: "● B/O - Disponible à l'achat (0)"
    }
  };

  const T = INKQUEST_TEXT[INKQUEST_LANG] || INKQUEST_TEXT.en;


  /*
   * Prevent duplicate initialization.
   */
  if (window.inkQuestWarehouseLoaded) {
    return;
  }

  window.inkQuestWarehouseLoaded = true;


  /* =======================================================
     CONFIG
  ======================================================= */

  const PROXY_URL =
    '/apps/warehouse-inventory/inventory';


  /* =======================================================
     GET CURRENT VARIANT ID
  ======================================================= */

  function getCurrentVariantId() {

    /*
     * 1. Product form variant input
     */
    const variantInput =
      document.querySelector(
        'form[action*="/cart/add"] input[name="id"]'
      );

    if (variantInput && variantInput.value) {
      return variantInput.value;
    }


    /*
     * 2. URL ?variant=
     */
    const params =
      new URLSearchParams(window.location.search);

    const urlVariant =
      params.get('variant');

    if (urlVariant) {
      return urlVariant;
    }


    /*
     * 3. Warehouse card data attribute
     */
    const card =
      document.getElementById('warehouseCard');

    if (card && card.dataset.variantId) {
      return card.dataset.variantId;
    }


    return null;
  }


  /* =======================================================
     SHOW LOADING
  ======================================================= */

  function showLoading(card) {

    if (!card) return;

    const badges =
      card.querySelectorAll('.warehouse-right');

    badges.forEach(function (container) {

      container.innerHTML = `
        <span class="warehouse-stock warehouse-loading">
          {% if request.locale.iso_code == 'fr' %}Vérification...{% else %}Checking...{% endif %}
        </span>
      `;

    });

  }


  /* =======================================================
     SHOW ERROR
  ======================================================= */

  function showError(card) {

    if (!card) return;

    const rows =
      card.querySelectorAll('.warehouse-row');

    rows.forEach(function (row) {

      const right =
        row.querySelector('.warehouse-right');

      if (!right) return;

      right.innerHTML = `
        <span class="warehouse-stock warehouse-error">
          ${T.unavailable}
        </span>
      `;

    });

  }


  /* =======================================================
     UPDATE WAREHOUSE UI
  ======================================================= */

  function updateWarehouseUI(card, locations) {

    if (!card) return;


    const locationMap = {};


    /*
     * Create easy lookup:
     *
     * location name → inventory data
     */
    locations.forEach(function (location) {

      const key =
        String(location.name || '')
          .trim()
          .toLowerCase();

      locationMap[key] = location;

    });


    /*
     * Update each existing Liquid row.
     */
    const rows =
      card.querySelectorAll('.warehouse-row');


    rows.forEach(function (row) {

      const rowLocation =
        String(
          row.dataset.locationName || ''
        )
        .trim()
        .toLowerCase();


      const inventory =
        locationMap[rowLocation];


      const right =
        row.querySelector('.warehouse-right');


      if (!right) return;


      /*
       * Location not returned by API.
       */
      if (!inventory) {

        right.innerHTML = `
          <span class="warehouse-stock warehouse-error">
            ${T.unavailable}
          </span>
        `;

        return;
      }


  const available =
  Number(inventory.available);

const incoming =
  Number(inventory.incoming);


      /*
       * IMPORTANT:
       *
       * available > 0
       * = In Stock
       *
       * available <= 0
       * = Backorder
       *
       * This completely ignores
       * Shopify's Continue Selling setting.
       */

      if (available > 0) {

  right.innerHTML = `
    <span class="warehouse-stock in-stock">
      ${T.inStock}
      <span class="stock-qty-num">
        (${available})
      </span>
    </span>
  `;

} else if (incoming > 0) {

  right.innerHTML = `
    <span class="warehouse-stock incoming">
      ${T.incoming}
      <span class="stock-qty-num">
        (${incoming})
      </span>
    </span>
  `;

} else {

  right.innerHTML = `
    <span class="warehouse-stock backorder">
      ${T.backorder}
      {% comment %} <span class="stock-qty-num">
        (0)
      </span> {% endcomment %}
    </span>
  `;

}
    });

  }


  /* =======================================================
     FETCH INVENTORY
  ======================================================= */

  async function loadWarehouseInventory(variantId) {

    const card =
      document.getElementById('warehouseCard');


    if (!card || !variantId) {
      return;
    }


    /*
     * Update card variant ID.
     */
    card.dataset.variantId = variantId;


    /*
     * Loading state
     */
    showLoading(card);


    try {

      const response =
        await fetch(
          `${PROXY_URL}?variant_id=${encodeURIComponent(variantId)}`,
          {
            method: 'GET',

            headers: {
              'Accept': 'application/json'
            },

            cache: 'no-store'
          }
        );


      if (!response.ok) {

        throw new Error(
          `Inventory API HTTP ${response.status}`
        );

      }


      const data =
        await response.json();


      console.log(
        'InkQuest Warehouse Inventory:',
        data
      );


      if (!data.success) {

        throw new Error(
          data.error || 'Inventory API failed'
        );

      }


      updateWarehouseUI(
        card,
        data.locations || []
      );


    } catch (error) {

      console.error(
        'InkQuest Warehouse Error:',
        error
      );


      showError(card);

    }

  }


  /* =======================================================
     INITIAL LOAD
  ======================================================= */

  function initWarehouseInventory() {

    const card =
      document.getElementById('warehouseCard');


    if (!card) {
      return;
    }


    const variantId =
      getCurrentVariantId();


    if (variantId) {

      loadWarehouseInventory(
        variantId
      );

    }

  }


  /* =======================================================
     VARIANT INPUT CHANGE
  ======================================================= */

  function listenForVariantInput() {

    document.addEventListener(
      'change',
      function (event) {

        const target =
          event.target;


        if (
          target &&
          target.matches(
            'form[action*="/cart/add"] input[name="id"]'
          )
        ) {

          const variantId =
            target.value;


          if (variantId) {

            loadWarehouseInventory(
              variantId
            );

          }

        }

      }
    );

  }


  /* =======================================================
     SHOPIFY THEME EVENTS
  ======================================================= */

  function listenForShopifyVariantEvents() {

    /*
     * Dawn / Shopify product variant events
     */
    document.addEventListener(
      'variant:change',
      function (event) {

        const variant =
          event.detail?.variant;


        if (
          variant &&
          variant.id
        ) {

          loadWarehouseInventory(
            variant.id
          );

        }

      }
    );


    /*
     * Some themes dispatch this event.
     */
    document.addEventListener(
      'product:variant-change',
      function (event) {

        const variant =
          event.detail?.variant ||
          event.detail;


        if (
          variant &&
          variant.id
        ) {

          loadWarehouseInventory(
            variant.id
          );

        }

      }
    );

  }


  /* =======================================================
     URL VARIANT CHANGE
  ======================================================= */

  function listenForUrlChanges() {

    let lastVariant =
      getCurrentVariantId();


    setInterval(
      function () {

        const currentVariant =
          getCurrentVariantId();


        if (
          currentVariant &&
          currentVariant !== lastVariant
        ) {

          lastVariant =
            currentVariant;


          loadWarehouseInventory(
            currentVariant
          );

        }

      },
      500
    );

  }


  /* =======================================================
     INITIALIZE
  ======================================================= */

  function start() {

    initWarehouseInventory();

    listenForVariantInput();

    listenForShopifyVariantEvents();

    listenForUrlChanges();

  }


  /*
   * DOM ready
   */
  if (
    document.readyState === 'loading'
  ) {

    document.addEventListener(
      'DOMContentLoaded',
      start
    );

  } else {

    start();

  }

})();
app.get("/inventory", async (req, res) => {

  try {
    const variantId = req.query.variant_id;

    if (!variantId) {
      return res.status(400).json({
        success: false,
        error: "variant_id is required"
      });
    }

    const response = await fetch(
      `https://${process.env.SHOPIFY_SHOP}/admin/api/2026-07/graphql.json`,
      {
        method: "POST",
        headers: {
          "Content-Type": "application/json",
          "X-Shopify-Access-Token": process.env.SHOPIFY_ACCESS_TOKEN
        },
        body: JSON.stringify({
          query: `
            query getVariantInventory($id: ID!) {
              productVariant(id: $id) {
                id
                title
                sku
                inventoryItem {
                  id
                  tracked
                  inventoryLevels(first: 20) {
                    nodes {
                      location {
                        id
                        name
                      }
                      quantities(names: ["available", "incoming", "on_hand", "committed"]) {
                        name
                        quantity
                      }
                    }
                  }
                }
              }
            }
          `,
          variables: {
            id: `gid://shopify/ProductVariant/${variantId}`
          }
        })
      }
    );

    const data = await response.json();

    if (!response.ok || data.errors) {
      console.error("Shopify GraphQL Error:", data);

      return res.status(500).json({
        success: false,
        error: data.errors || "Shopify API error"
      });
    }

    const variant = data.data.productVariant;

    if (!variant) {
      return res.status(404).json({
        success: false,
        error: "Variant not found"
      });
    }

    const locations =
      variant.inventoryItem?.inventoryLevels?.nodes || [];

    const formattedLocations = locations.map(level => {

      const quantities = {};

      (level.quantities || []).forEach(q => {
        quantities[q.name] = q.quantity;
      });

   const available = quantities.available || 0;
const incoming = quantities.incoming || 0;
const onHand = quantities.on_hand || 0;
const committed = quantities.committed || 0;

return {
  location_id: level.location.id,
  name: level.location.name,
  available,
  incoming,
  on_hand: onHand,
  committed,
  status:
    available > 0
      ? "in_stock"
      : incoming > 0
        ? "incoming"
        : "backorder"
};
    });

    res.json({
      success: true,
      variant: {
        id: variant.id,
        title: variant.title,
        sku: variant.sku
      },
      locations: formattedLocations
    });

  } catch (error) {

    console.error("Inventory Error:", error);

    res.status(500).json({
      success: false,
      error: error.message
    });

  }
});
</script>